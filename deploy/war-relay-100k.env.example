# Native CBOR profile for 100,000 concurrent users in small rooms.
# Install with the systemd override in war-relay-100k.conf.example.
# Limits are ceilings, not preallocated memory or a workload-independent promise.
WAR_BIND=127.0.0.1:1338
WAR_ADMIN_BIND=127.0.0.1:1339
# Leave 10% TCP headroom for joining, reconnecting and closing transports.
WAR_MAX_CONNECTIONS=110000
WAR_MAX_CHANNELS=10000
WAR_MAX_CHANNEL_MEMBERS=1024
WAR_MAX_CONNECTIONS_PER_IP=0
WAR_LISTEN_BACKLOG=4096
# Linux normally reports 2x these requests. Confirm effective values and tune
# for the target network's bandwidth-delay product; smaller windows can throttle.
# Two measured 5 MiB publications avoid tiny-window stalls at this setting.
WAR_TCP_SEND_BUFFER_BYTES=65536
# The larger receive window keeps near-64KiB packets responsive on loopback.
WAR_TCP_RECEIVE_BUFFER_BYTES=65536
# Large files remain supported; this encoded-message ceiling is not preallocated.
WAR_MAX_MESSAGE_BYTES=16777216
WAR_QUEUE_MESSAGES=64
# Per-session ceiling, allocated only as needed; fits a full admitted message.
WAR_QUEUE_BYTES=33554432
WAR_TOTAL_QUEUE_BYTES=268435456
WAR_READ_BUFFER_BYTES=4096
WAR_TOTAL_READ_BUFFER_BYTES=268435456
WAR_READ_BUFFER_IDLE_SECS=5
WAR_IDLE_TIMEOUT_SECS=0
WAR_MAX_VARIABLES=256
WAR_MAX_VARIABLE_BYTES=1048576
WAR_TOTAL_VARIABLE_BYTES=16777216
WAR_MESSAGES_PER_SECOND=1000
WAR_BYTES_PER_SECOND=16777216
WAR_PING_INTERVAL_SECS=15
WAR_PONG_TIMEOUT_SECS=45
WAR_DISABLE_GLOBAL_BROADCAST=true
WAR_WORKERS=4
# Set independent secrets and your actual allowed browser origins before exposure.
# WAR_AUTH_PASSWORD=
# WAR_ADMIN_TOKEN=
# WAR_ALLOWED_ORIGINS=https://app.example
RUST_LOG=war_relay=info
