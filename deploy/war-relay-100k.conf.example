# /etc/systemd/system/war-relay.service.d/100k.conf
# About 1.7 GiB of process memory was measured at 100,000 idle sessions, before
# message traffic and the admitted WAR_TOTAL_* budgets. These are operational
# guardrails, not a reservation; validate on the target host.
[Service]
MemoryHigh=6G
MemoryMax=8G
