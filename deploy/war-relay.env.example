# Copy to /etc/war-relay.env and restrict its permissions before adding secrets.
# WebTransport listens on this UDP address; the certificate comes from the unit.
WAR_BIND=0.0.0.0:443
WAR_ADMIN_BIND=127.0.0.1:1339
# Requested UDP receive buffer for the shared QUIC socket. The kernel caps it at
# net.core.rmem_max; raise that sysctl on busy hosts.
WAR_UDP_RECEIVE_BUFFER_BYTES=4194304
# Optional exact browser page origins, comma-separated.
# Missing Origin remains allowed for native clients; this is not authentication.
# WAR_ALLOWED_ORIGINS=https://app.example,https://admin.example
WAR_MAX_CONNECTIONS=5000
# Optional per-client-address session quota; zero disables.
WAR_MAX_CONNECTIONS_PER_IP=0
WAR_MAX_CHANNELS=5000
WAR_MAX_CHANNEL_MEMBERS=5000
# Encoded CBOR message ceiling, including routing metadata; supports large files.
WAR_MAX_MESSAGE_BYTES=16777216
WAR_QUEUE_MESSAGES=64
# Per-session ceiling, allocated only as needed; fits a full admitted message.
WAR_QUEUE_BYTES=33554432
WAR_TOTAL_QUEUE_BYTES=134217728
# Staging allowance for records being received, including 2x growth headroom;
# zero disables. The three WAR_TOTAL_* budgets plus QUIC connection state must
# fit under the unit's MemoryMax (1G): 256 MiB + 128 MiB + 16 MiB here leaves
# headroom for 5,000 sessions, so admission refuses work before the kernel kills
# the process.
WAR_TOTAL_READ_BUFFER_BYTES=268435456
# Optional application-idle retirement; QUIC keep-alives do not refresh it. Zero disables.
WAR_IDLE_TIMEOUT_SECS=0
WAR_MAX_VARIABLES=256
WAR_MAX_VARIABLE_BYTES=1048576
WAR_TOTAL_VARIABLE_BYTES=16777216
WAR_DISABLE_GLOBAL_BROADCAST=true
WAR_WORKERS=4
# Set long, independent values to enable privileged and management operations:
# WAR_AUTH_PASSWORD=
# WAR_ADMIN_TOKEN=
RUST_LOG=war_relay=info
