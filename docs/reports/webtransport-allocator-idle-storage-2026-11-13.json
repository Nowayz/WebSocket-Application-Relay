{
 "date": "2026-11-13",
 "base_commit": "0608124",
 "objective": "Follow the 2026-11-13 recommendation (rebuild a baseline, reclaim empty endpoint-event queues) and close the remaining reliable-throughput gap to the plaintext WebSocket transport without adding machinery.",
 "changes": {
  "endpoint_event_queue": "quinn-proto Connection::poll_endpoint_events releases the queue storage when it pops the last event (192 B per idle connection).",
  "assembler_first_slot": "quinn-proto Assembler::insert reserves one slot instead of four for the first buffered chunk (168 B per receive stream that never queues two chunks).",
  "allocator": "war-relay binary uses jemalloc (tikv-jemallocator 0.7) as its global allocator on non-MSVC targets. Library, examples and benchmark clients are unchanged.",
  "previous_path": "quinn-proto Connection::prev_path is boxed (432 B inline to 8 B). With jemalloc the connection owner drops from the 6,144-byte to the 5,120-byte size class.",
  "early_secret": "rustls Quic::early_secret is boxed (80 B inline to 8 B), taking the QUIC session shell from the 1,280-byte to the 1,024-byte size class.",
  "handshake_queue": "rustls QUIC write_hs releases the drained handshake message queue once the handshake is complete (128 B).",
  "harness": "scripts/datagram-load.py strips ANSI colour codes before reading the development certificate pin, as benchmark_transport.py already does."
 },
