    "source": "\"\"\"Current-image native WebSocket and QUIC comparison with one frozen client.\"\"\"\nimport argparse\nimport json\nfrom pathlib import Path\nimport sys\n\nsys.path.insert(0, 'scripts')\nimport inspection\n\nA = Path('artifacts/webtransport')\nserver = (A/'binaries/session-io-relay').resolve()\nfailures = []\nfor repeat in range(1, 4):\n    order = ['websocket', 'webtransport'] if repeat != 2 else ['webtransport', 'websocket']\n    for transport in order:\n        for case in ['private', 'roomonly', 'mixed']:\n            source = json.loads((A/f'session-io-long-{case}-candidate-1.json').read_text())\n            assert source['passed'] and source['args']['seconds'] == 12\n            output = A/f'session-io-native-parity-{case}-{transport}-{repeat}.json'\n            assert not output.exists()\n            values = source['args'].copy()\n            values.update(server=str(server), transport=transport, output=str(output.resolve()))\n            for key in ['server', 'client', 'client_source_root', 'tls_front', 'tls_cert',\n                        'tls_key', 'tls_ca', 'heap_profile', 'heap_library', 'output',\n                        'fanout_latency_output']:\n                if values.get(key) is not None:\n                    values[key] = Path(values[key])\n            result = inspection.run(argparse.Namespace(**values))\n            assert result['server_sha256'] == source['server_sha256']\n            assert result['client_sha256'] == source['client_sha256']\n            if not result['passed']:\n                failures.append(str(output))\n            print('PARITY', repeat, transport, case, result['passed'], flush=True)\nprint('FAILURES', json.dumps(failures), flush=True)\n"
  },
