+// Diagnostic snapshot only: thread-local aggregation, emitted on worker exit.
+struct ReadTurnProfile {
+    counts: [u64; 65],
+    nanos: [u64; 65],
+    max_nanos: [u64; 65],
+    max_bytes: usize,
+    max_messages: usize,
