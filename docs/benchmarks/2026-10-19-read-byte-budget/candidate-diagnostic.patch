+        }));
+    }
+}
+struct ReadTurn {
+    started: Instant,
+    bytes: usize,
+    messages: usize,
+}
+impl Drop for ReadTurn {
+    fn drop(&mut self) {
+        if self.messages == 0 { return; }
+        let nanos = self.started.elapsed().as_nanos() as u64;
+        let bucket = if self.bytes == 0 { 0 } else { self.bytes.ilog2() as usize + 1 };
+        READ_TURNS.with(|profile| {
+            let mut profile = profile.borrow_mut();
+            profile.counts[bucket] += 1;
+            profile.nanos[bucket] += nanos;
+            profile.max_nanos[bucket] = profile.max_nanos[bucket].max(nanos);
+            profile.max_bytes = profile.max_bytes.max(self.bytes);
+            profile.max_messages = profile.max_messages.max(self.messages);
+        });
+    }
+}
 
