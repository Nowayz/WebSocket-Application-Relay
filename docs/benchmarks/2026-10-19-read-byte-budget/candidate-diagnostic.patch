+thread_local! {
+    static READ_TURNS: std::cell::RefCell<ReadTurnProfile> = const { std::cell::RefCell::new(ReadTurnProfile {
+        counts: [0; 65], nanos: [0; 65], max_nanos: [0; 65], max_bytes: 0, max_messages: 0,
+    }) };
+}
+impl Drop for ReadTurnProfile {
+    fn drop(&mut self) {
+        eprintln!("READ_TURN_PROFILE {}", serde_json::json!({
+            "counts": self.counts.as_slice(), "nanos": self.nanos.as_slice(),
+            "max_nanos": self.max_nanos.as_slice(), "max_bytes": self.max_bytes,
