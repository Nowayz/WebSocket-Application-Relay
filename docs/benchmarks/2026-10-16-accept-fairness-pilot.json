{
  "scope": "Thirty-two sequential exploratory fresh-process cases, two alternating three-second rounds. Four fixed accept batch sizes at identical1024 backlog. One/four workers and0/256 policy-refused clients. Independent healthy/flood processes and fresh network namespace per case. Candidate selection only; retained performance claims require separate three-round comparison. No builds, profiles, or competing loads during these cases.",
  "source": "import hashlib,json,statistics,subprocess,sys\nfrom pathlib import Path\nroot=Path(__file__).resolve().parents[1];sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()\nmeta=json.loads((root/'artifacts/accept-fairness-candidates.json').read_text())\nvariants={'64':{'directory':'artifacts/baselines/accept-backlog', 'binaries':json.loads((root/'artifacts/accept-backlog-candidate.json').read_text())['binaries']},**meta['variants']}\nclient=root/'artifacts/baselines/admission-flood-client/admission'\nrunner=root/'scripts/admission-flood.py'\noutput=root/'docs/benchmarks/2026-10-16-accept-fairness-pilot.json'\nrecord={'scope':'Thirty-two sequential exploratory fresh-process cases, two alternating three-second rounds. Four fixed accept batch sizes at identical1024 backlog. One/four workers and0/256 policy-refused clients. Independent healthy/flood processes and fresh network namespace per case. Candidate selection only; retained performance claims require separate three-round comparison. No builds, profiles, or competing loads during these cases.', 'source':Path(__file__).read_text(),'candidates':meta,'variants':variants,'client':{'path':str(client.relative_to(root)),'sha256':sha(client)},'runner':{'path':str(runner.relative_to(root)),'sha256':sha(runner)},'cases':[],'passed':False}\ncohorts=[(1,0),(4,0),(1,256),(4,256)]\nfor repetition in [1,2]:\n for workers,flood in cohorts if repetition==1 else reversed(cohorts):\n  for role in list(variants) if repetition==1 else list(reversed(variants)):\n   binary=root/variants[role]['directory']/'war-relay'\n   trace=output.with_name(f'2026-10-16-accept-fairness-pilot-w{workers}-n{flood}-q{role}-{repetition}.json')\n   command=[sys.executable,str(runner),'--server',str(binary),'--client',str(client),'--workers',str(workers),'--flood-workers',str(flood),'--seconds','3','--isolate','--output',str(trace)]\n   done=subprocess.run(command,cwd=root,capture_output=True,text=True,timeout=80)\n   data=json.loads(trace.read_text());row={'workers':workers,'flood_workers':flood,'quantum':role,'repetition':repetition,'passed':data['passed'],'exit_code':done.returncode,'trace':str(trace.relative_to(root)),'sha256':sha(trace),'error':data.get('error')}\n   if data['passed']:\n    m=data['mixed'];assert data['server_sha256']==variants[role]['binaries']['war-relay'] and not data['profile_diagnostic']\n    row.update(healthy=m['healthy']['per_second'],healthy_p99=m['healthy']['p99_upper_ms'],refused=m['refusals']['per_second'],refused_p99=m['refusals']['p99_upper_ms'],cpu=m['server_cpu_per_wall'],drops=data['tcp_counter_delta']['ListenDrops'])\n   record['cases'].append(row);output.write_text(json.dumps(record,indent=2)+'\\n');print(json.dumps(row),flush=True)\nrecord['medians']={}\nfor workers,flood in cohorts:\n for role in variants:\n  rows=[r for r in record['cases'] if r['passed'] and r['workers']==workers and r['flood_workers']==flood and r['quantum']==role]\n  if rows:record['medians'][f'w{workers}-n{flood}-q{role}']={name:statistics.median(r[name] for r in rows) for name in ['healthy','healthy_p99','refused','refused_p99','cpu','drops']}\nrecord['passed']=len(record['cases'])==32 and all(row['passed'] for row in record['cases'])\noutput.write_text(json.dumps(record,indent=2)+'\\n');print(json.dumps({'passed':record['passed'],'cases':len(record['cases'])}),flush=True)\nassert record['passed']\n",
