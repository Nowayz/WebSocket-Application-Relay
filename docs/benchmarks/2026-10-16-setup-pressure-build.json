  "collector_source": "import hashlib\nimport json\nfrom pathlib import Path\nimport platform\nimport re\nimport subprocess\n\nroot = Path(__file__).resolve().parents[1]\nbench = root / 'docs/benchmarks'\nprefix = '2026-10-16-setup-pressure-'\nsha = lambda path: hashlib.sha256(Path(path).read_bytes()).hexdigest()\nread = lambda label: json.loads((bench / f'{prefix}{label}.json').read_text())\ndescribe = lambda path: {'path': str(Path(path).relative_to(root)), 'sha256': sha(path)}\nmeta = json.loads((root / 'artifacts/setup-pressure-candidate.json').read_text())\nrevision = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=root, text=True).strip()\nassert revision == meta['source_revision']\nfor name, digest in meta['sources'].items():\n    assert sha(root / name) == sha(root / meta['directory'] / name) == digest\nfor name, digest in meta['binaries'].items():\n    assert sha(root / meta['directory'] / name) == sha(root / 'target/release' / name) == digest\n\ndef empty(metrics):\n    for key in ['war_connections', 'war_sessions', 'war_queued_bytes', 'war_variable_bytes',\n                'war_output_queue_capacity_bytes', 'war_read_buffer_reserved_bytes']:\n        assert int(metrics[key]) == 0, (key, metrics[key])\n    assert int(metrics['war_channels']) == 1\n\nbefore, release, debug = read('before'), read('after'), read('debug')\nassert not before['passed'] and len(before['cases']) == 4\nassert before['server_sha256'] == meta['baseline']['sha256']\nassert before['source'] == release['source'] == debug['source'] == (root / 'scripts/setup-pressure.py').read_text()\nassert before['shim_source'] == release['shim_source'] == debug['shim_source'] == (root / 'scripts/setup-pressure.c').read_text()\nfor case in before['cases']:\n    assert not case['passed'] and case['process_exit_code'] == 1 and len(case['injected_calls']) == 1\n    assert len(case['waves']) == 1\n    assert case['waves'][0]['slot_held_until_descriptor_close'] == (case['mode'] == 'register')\n    assert ('os error 12' if case['mode'] == 'register' else 'os error 105') in case['server_log']\nfor data, binary in [(release, root / meta['directory'] / 'war-relay'), (debug, root / 'target/debug/war-relay')]:\n    assert data['passed'] and len(data['cases']) == 4 and data['server_sha256'] == sha(binary)\n    for case in data['cases']:\n        assert case['passed'] and case['process_exit_code'] == 0 and len(case['injected_calls']) == 3\n        assert len(case['waves']) == 3\n        for wave in case['waves']:\n            assert wave['slot_held_until_descriptor_close'] and wave['held_metrics']['war_connections'] == 2\n            if wave['wave'] < 3:\n                observed = wave['recovered_metrics']\n                assert observed['war_setup_errors_total'] == observed['war_rejected_total'] == wave['wave']\n                assert observed['war_connections'] == observed['war_sessions'] == 1\n                assert observed['war_read_buffer_reserved_bytes'] == case['initial_metrics']['war_read_buffer_reserved_bytes']\n            else:\n                assert wave['shutdown_close'] == 1001\n\nguard = read('guard')\nassert guard['passed'] and len(guard['cases']) == 12 and guard['selected_source_hashes'] == meta['sources']\nassert guard['variants']['before']['sha256'] == meta['baseline']['sha256']\nassert guard['variants']['selected']['sha256'] == meta['binaries']['war-relay']\nfor row in guard['cases']:\n    path = root / row['trace']; data = json.loads(path.read_text())\n    assert sha(path) == row['trace_sha256'] and data['passed'] and not data['profile_diagnostic']\n    assert data['server_sha256'] == guard['variants'][row['kind']]['sha256']\n    assert data['client_sha256'] == guard['client']['sha256']\n    assert data['server_exit_code'] == data['client_exit_code'] == 0 and not data['server_forced_kill']\n    assert [event['event'] for event in data['events']] == ['ready', 'measured', 'done']\n    for event in data['events']:\n        assert 'exact_counter_checks' in event\n        assert event['metrics'].get('war_setup_errors_total', 0) == event['metrics']['war_accept_errors_total'] == 0\n        assert event['metrics']['war_routing_copied_bytes_total'] == 0\n    empty(data['events'][-1]['metrics'])\n\nstress = read('stability'); assert stress['passed'] and len(stress['cases']) == 4\nassert stress['server_sha256'] == meta['binaries']['war-relay']\nfor case in stress['cases']:\n    assert case['passed'] and case['server_exit_code'] == case['exit_code'] == 0 and not case['server_forced_kill']\n    assert case['cleaned_up'] and case['counts_match'] and case['pressure_valid']; empty(case['final']['metrics'])\nupper = read('upper-bound')\nassert upper['passed'] and upper['args']['fanout_readers'] == 1024 and not upper['profile_diagnostic']\nassert upper['server_sha256'] == meta['binaries']['war-relay'] and upper['server_exit_code'] == upper['client_exit_code'] == 0\nassert upper['events'][-1]['details']['counts']['normal_closes'] > 1024; empty(upper['events'][-1]['metrics'])\naccept = read('accept')\nassert accept['passed'] and len(accept['cases']) == 3 and accept['server_sha256'] == meta['binaries']['war-relay']\nassert accept['bridge_sha256'] == meta['binaries']['war-legacy-bridge']\nfor case in accept['cases']:\n    assert case['passed'] and case['pressure']['fd_count'] == 64 and all(code == 0 for code in case['process_exit_codes'])\nreference = read('reference'); assert reference['passed'] and reference['common_cases'] == 48\nassert reference['upstream_commit'] == '881c8daaf2cf05adea8f522b28cf372e8f82d4e9'\nassert len(reference['results']['cpp']['intentional_differences']) == len(reference['results']['rust']['intentional_differences']) == 8\nfor role, name in [('native', 'war-relay'), ('bridge', 'war-legacy-bridge')]:\n    assert reference[role]['sha256'] == meta['binaries'][name] and reference[role]['exit_code'] == 0\napi = read('api'); assert api['passed'] and len(api['checks']) == 4 and api['server_exit_code'] == 0\nassert api['server_sha256'] == meta['binaries']['war-relay']; empty(api['final_metrics'])\nassert [value['status'] for value in api['manual_admission_transitions']] == [401, 204, 200, 503, 200, 401, 204, 200]\nbrowser = read('browser'); assert browser['passed'] and browser['source_revision'] == revision\nassert len(browser['browser']['checks']) == 7 and not browser['browser']['errors'] and browser['worker_listener_sockets'] == 4\nassert all(status == 200 for status in browser['health'].values()); empty(browser['metrics'])\nfor role, name in [('native', 'war-relay'), ('bridge', 'war-legacy-bridge')]:\n    live = browser['runtime'][role]\n    assert sha(f'/proc/{live[\"pid\"]}/exe') == live['sha256'] == meta['binaries'][name]\nassert 'Total messages: 0 (Errors: 0, Warnings: 0)' in (root / 'artifacts/setup-pressure-browser-console.txt').read_text()\n\ntests = (root / 'artifacts/setup-pressure-tests.log').read_text()\nsuites = [int(value) for value in re.findall(r'test result: ok\\. (\\d+) passed;', tests) if int(value)]\nassert suites == [56, 13, 3, 3, 52, 1, 3] and sum(suites) == 131\nclippy = (root / 'artifacts/setup-pressure-clippy.log').read_text()\nrelease_log = (root / 'artifacts/setup-pressure-release.log').read_text()\njs = (root / 'artifacts/setup-pressure-js.log').read_text()\nassert 'Finished' in clippy and 'warning:' not in clippy and 'Finished' in release_log\nassert 'pass 6' in js and 'pass 1' in js and 'fail 0' in js\ncommands = [['cargo', 'fmt', '--check'], ['python3', '-m', 'py_compile', 'scripts/setup-pressure.py', 'scripts/inspection.py']]\nsmall_checks = []\nfor command in commands:\n    done = subprocess.run(command, cwd=root, capture_output=True, text=True)\n    assert done.returncode == 0, done.stdout + done.stderr\n    small_checks.append({'command': command, 'exit_code': done.returncode, 'output': done.stdout + done.stderr})\nchecks = {'source_revision': revision, 'rust': {'command': ['cargo', 'test', '--locked', '--all-targets'], 'passed': 131, 'suites': suites, 'exit_code': 0, 'output': tests},\n          'clippy': {'exit_code': 0, 'output': clippy}, 'release': {'exit_code': 0, 'output': release_log},\n          'javascript': {'passed': 7, 'exit_code': 0, 'output': js}, 'other_checks': small_checks}\n(bench / f'{prefix}checks.json').write_text(json.dumps(checks, indent=2) + '\\n')\ntracked = lambda *paths: subprocess.check_output(['git', 'ls-files', *paths], cwd=root, text=True).splitlines()\nruntime_files = tracked('src', 'vendor', 'Cargo.toml', 'Cargo.lock')\nhelper_files = tracked('scripts', 'tests', 'examples', 'clients/js', '.github/workflows/rust.yml')\nartifact_helpers = [root / 'artifacts' / name for name in ['setup-pressure-guard.py', 'setup-pressure-stability.py', 'setup-pressure-api.py',\n    'refresh-setup-pressure-runtime.py', 'record-setup-pressure-browser.py', 'record-setup-pressure-checkpoint.py', 'paging-accept.mjs', 'fanout-placement-case.py']]\nevidence = [describe(path) for path in sorted(bench.glob(f'{prefix}*.json')) if path.name != f'{prefix}build.json']\nrecord = {'passed': True, 'source_revision': revision, 'candidate': meta, 'platform': platform.platform(),\n          'rustc': subprocess.check_output(['rustc', '--version'], text=True).strip(),\n          'scope': 'Local Linux checkpoint. Final ordinary comparison has twelve fresh sequential processes and no fault library/profile. Separate syscall injection: four expected failing baseline processes and eight passing debug/release processes,24 selected failures. Child-only descriptor pressure, mixed-size socket stress,1024-reader fanout, original C++ compatibility, JS, management and real Chrome acceptance pass. No production capacity, hosted deployment or GitHub CI execution claim. Goal remains active.',\n          'runtime_sources': [describe(root / name) for name in runtime_files],\n          'helpers_and_tests': [describe(root / name) for name in helper_files] + [describe(path) for path in artifact_helpers],\n          'clients': [{'path': str(path.relative_to(root)), 'sha256': sha(path)} for path in [root / guard['client']['path'], root / 'artifacts/baselines/address-churn-client/stress']],\n          'evidence': evidence, 'browser_screenshot': browser['screenshot'],\n          'browser_assets': browser['browser_assets'], 'manual_services': json.loads((root / 'artifacts/reactor-manual-services.json').read_text()),\n          'excluded_probe_diagnostics': [{'reason': 'Initial shutdown oracle sent an acknowledgement racing the existing flush-Close-and-retire contract; corrected oracle passes. These are not ordinary timing cases.', **describe(root / 'artifacts' / name)} for name in ['setup-pressure-debug-first.json', 'setup-pressure-after-first.json']],\n          'collector_source': Path(__file__).read_text()}\n(bench / f'{prefix}build.json').write_text(json.dumps(record, indent=2) + '\\n')\nprint(json.dumps({'passed': True, 'source': revision, 'runtime_sources': len(runtime_files), 'helpers_and_tests': len(record['helpers_and_tests']), 'evidence': len(evidence), 'rust_tests': 131, 'ordinary_cases': len(guard['cases'])}))\n"
}
