  "driver_source": "import hashlib,json,statistics,subprocess,sys\nfrom pathlib import Path\nroot=Path(__file__).resolve().parents[1];sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()\nmeta=json.loads((root/'artifacts/fanout-probe-candidate.json').read_text());client=root/meta['directory']/'inspection';server=root/'artifacts/baselines/fd-pressure/war-relay'\noutput=root/'docs/benchmarks/2026-10-16-fanout-fairness-baseline.json'\nrecord={'scope':'18 sequential fresh Linux processes; three repetitions rotate six worker/population combinations. One or four server workers on CPUs0-3, fixed four-thread client on CPUs4-7. Six measured seconds with one private pair, eight exact self-message/Close/EOF reconnect workers, zero idle rooms and either0/64/512 stable broadcast readers. Broadcast uses64 distinct1KiB templates/window16; every sender/body/FIFO checked, complete reader/message matrix, controlled exact departure notifications, independent counters/bytes/resources and client/server zero exits at gates. Client and server CPU sampled independently. No builds/profiles/other loads overlap ordinary cases. No before/after runtime optimization is being claimed.',\n 'runtime_source_revision':'a0191a1dc54ad8eb7dc17ada1df4aa39b40227ca','helper_source_revision':subprocess.check_output(['git','rev-parse','HEAD'],cwd=root,text=True).strip(),\n 'server':{'path':str(server.relative_to(root)),'sha256':sha(server)},'client':{'path':str(client.relative_to(root)),'sha256':sha(client)},'sources':meta['sources'],'driver_source':Path(__file__).read_text(),'cases':[],'passed':False}\nvariants=[(1,0),(1,64),(1,512),(4,0),(4,64),(4,512)]\nfor rep in range(1,4):\n offset=(rep-1)*2\n for workers,readers in variants[offset:]+variants[:offset]:\n  trace=output.with_name(f'{output.stem}-{workers}w-{readers}r-{rep}.json')\n  cmd=[sys.executable,'scripts/inspection.py','--server',str(server),'--client',str(client),'--workers',str(workers),'--rooms','0','--pairs','1','--seconds','6','--mode','none','--churn-workers','8','--fanout-readers',str(readers),'--output',str(trace)]\n  done=subprocess.run(cmd,cwd=root,capture_output=True,text=True,timeout=100)\n  data=json.loads(trace.read_text());assert done.returncode==0 and data['passed'],done.stdout+done.stderr\n  assert data['server_sha256']==record['server']['sha256'] and data['client_sha256']==meta['client_sha256']\n  for p,d in data['client_sources_sha256'].items():assert meta['sources'][p]==d\n  m=data['mixed'];row={'workers':workers,'readers':readers,'repetition':rep,'trace':str(trace.relative_to(root)),'trace_sha256':sha(trace),'passed':True,\n    'healthy':m['healthy']['per_second'],'healthy_p99_ms':m['healthy']['p99_upper_ms'],'churn':m['churn']['per_second'],'churn_p99_ms':m['churn']['p99_upper_ms'],'fanout':m['fanout']['per_second'],'fanout_p99_ms':m['fanout']['p99_upper_ms'],\n    'server_cpu_wall':m['server_cpu_seconds_per_wall_second'],'client_cpu_wall':m['client_cpu_seconds_per_wall_second'],'rss_mib':data['events'][1]['process']['VmRSS']/1024}\n  record['cases'].append(row);output.write_text(json.dumps(record,indent=2)+'\\n');print(json.dumps(row),flush=True)\nrecord['medians']={}\nfor workers,readers in variants:\n rows=[r for r in record['cases'] if (r['workers'],r['readers'])==(workers,readers)]\n fields=['healthy','healthy_p99_ms','churn','churn_p99_ms','fanout','fanout_p99_ms','server_cpu_wall','client_cpu_wall','rss_mib']\n summary={k:statistics.median(r[k] for r in rows) for k in fields};summary['ranges']={k:[min(r[k] for r in rows),max(r[k] for r in rows)] for k in fields}\n record['medians'][f'{workers}w/{readers}r']=summary\nrecord['passed']=True;output.write_text(json.dumps(record,indent=2)+'\\n');print(json.dumps(record['medians']),flush=True)\n",
