+#[test]
+fn timer_expiry_upgrades_output_wakes_without_duplicate_ready_entries() {
+    let relay = Relay::new(crate::Config::default()).unwrap();
+    let listener = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+    let client = std::net::TcpStream::connect(listener.local_addr().unwrap()).unwrap();
+    listener.set_nonblocking(true).unwrap();
+    let mut worker = Worker::new(listener, relay).unwrap();
+    worker.accept().unwrap();
+    let slot = worker.connections.iter().next().unwrap().0;
+    let token = worker.connections[slot].token;
+    for already_scheduled in [false, true] {
+        worker.ready.clear();
+        let connection = &mut worker.connections[slot];
+        connection.scheduled = already_scheduled;
+        connection.output_only = true;
+        if already_scheduled {
+            worker.ready.push_back(token);
+        }
+        let now = Instant::now();
+        worker.timers.set(slot, Some(now));
+        worker.schedule_timers(now);
+        assert_eq!(worker.ready.iter().copied().collect::<Vec<_>>(), [token]);
+        assert!(worker.connections[slot].scheduled);
+        assert!(!worker.connections[slot].output_only);
+        assert_eq!(worker.timers.next(), None);
+    }
+    drop(client);
+}
