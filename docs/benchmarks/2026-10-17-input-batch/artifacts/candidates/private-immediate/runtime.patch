 mod tests {
     use super::*;
 
+    #[test]
+    fn private_submission_keeps_exact_charge_without_retaining_owners() {
+        struct Immediate {
+            mode: AtomicU8,
+            calls: AtomicUsize,
+            closed: AtomicBool,
+        }
+
+        impl PeerOutput for Immediate {
+            fn send(&self, _: Envelope) -> bool {
+                true // Welcome/control output retains the ordinary owned path.
+            }
+
+            fn send_borrowed(&self, packet: Submission<'_>) -> bool {
+                let budget = packet.budget.expect("live charge");
+                assert_eq!(Arc::strong_count(budget), 1);
+                assert_eq!(budget.used.load(Relaxed), packet.frame.len());
+                assert_eq!(
+                    budget.metrics.queued_bytes.load(Relaxed),
+                    packet.frame.len()
+                );
+                self.calls.fetch_add(1, Relaxed);
+                match self.mode.load(Relaxed) {
+                    0 => true,
+                    1 => panic!("interrupted submission"),
+                    _ => false,
+                }
+            }
+
+            fn close(&self, reason: Disconnect) {
+                assert_eq!(reason, Disconnect::OVERLOADED);
+                self.closed.store(true, Relaxed);
+            }
+        }
+
+        let relay = Relay::new(config()).unwrap();
+        let output = Arc::new(Immediate {
+            mode: AtomicU8::new(0),
+            calls: AtomicUsize::new(0),
+            closed: AtomicBool::new(false),
+        });
+        let registration = relay
+            .subscribe_with_output(b"private", output.clone())
+            .unwrap();
+        let peer = &registration.peer;
+        let packet = || protocol::envelope(peer.id.load(Relaxed), b"\x44body");
+        relay.receive(peer, packet()).unwrap();
+        assert_eq!(peer.budget.used.load(Relaxed), 0);
+        assert_eq!(relay.metrics.queued_bytes.load(Relaxed), 0);
+
+        output.mode.store(1, Relaxed);
+        assert!(
+            std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                relay.receive(peer, packet())
+            }))
+            .is_err()
+        );
+        assert_eq!(peer.budget.used.load(Relaxed), 0);
+        assert_eq!(relay.metrics.queued_bytes.load(Relaxed), 0);
+
+        output.mode.store(2, Relaxed);
+        relay.receive(peer, packet()).unwrap();
+        assert_eq!(output.calls.load(Relaxed), 3);
+        assert!(output.closed.load(Relaxed));
+        assert_eq!(peer.budget.used.load(Relaxed), 0);
+        assert_eq!(relay.metrics.queued_bytes.load(Relaxed), 0);
+        drop(registration);
+        assert_eq!(relay.counts(), (0, 1));
+    }
