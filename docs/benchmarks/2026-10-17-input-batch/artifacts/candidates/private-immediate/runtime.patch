+/// A private fast-path submission keeps its charge but borrows the routing
+/// frame. Only backpressure promotes it to an independently owned envelope.
+pub(crate) struct Submission<'a> {
+    pub frame: &'a Frame,
+    budget: Option<&'a Arc<Budget>>,
+}
+
+impl Submission<'_> {
+    pub(crate) fn into_owned(mut self) -> Envelope {
+        let frame = self.frame.clone();
+        let budget = self
+            .budget
+            .take()
+            .expect("submission owns its charge")
+            .clone();
+        Envelope { frame, budget }
+    }
+}
+
