  "source": "import hashlib,json,re,subprocess,sys\nfrom pathlib import Path\nroot=Path(__file__).resolve().parents[1];meta=json.loads((root/'artifacts/handshake-inline-candidate.json').read_text());sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()\nrunner=root/meta['driver']['directory']/'scripts/handshake-pressure.py';client=root/meta['helper']['directory']/'admission'\nservers={'before':root/meta['baseline']['path'],'selected':root/meta['directory']/'war-relay'}\noutput=root/'docs/benchmarks/2026-10-16-handshake-inline-memory.json'\nrecord={'scope':'Four sequential isolated server-only gperftools diagnostics with a quiet negotiated CBOR client. Zero/256 incomplete HTTP peers,32 paced one-byte rounds, drained Linux TCP receive queues after each round. Partial metadata stays live until absolute five-second handshake timeout;16 renewed raw slots and later healthy traffic/Close/EOF independently verify retirement and usability. Timings/RSS use a replacement allocator and are excluded from ordinary comparisons. Delta includes fixed management/dump overhead; zero-peer control distinguishes those allocations. Requested object/byte counts, not RSS or a general zero-allocation claim.', 'candidate':meta,'source':Path(__file__).read_text(),'cases':[],'captures':[],'passed':False}\nfor connections in [0,256]:\n for role in ['before','selected']:\n  name=f'n{connections}-{role}';trace=output.with_name(f'2026-10-16-handshake-inline-heap-{name}.json');prefix=root/f'artifacts/handshake-inline-heap/{name}/probe'\n  command=[sys.executable,str(runner),'--server',str(servers[role]),'--client',str(client),'--connections',str(connections),'--quiet','--seconds','1','--heap-prefix',str(prefix),'--isolate','--output',str(trace)]\n  done=subprocess.run(command,cwd=root,capture_output=True,text=True,timeout=50);data=json.loads(trace.read_text());assert done.returncode==0 and data['passed'],done.stdout+done.stderr\n  assert data['profile_diagnostic'] and data['server_exit_code']==data['client_exit_code']==0 and data['isolated_namespace']\n  phases={}\n  for e in data['events']:\n   h=e['heap'];p=Path(h['path']);assert sha(p)==h['sha256'];m=re.match(r'heap profile:\\s+(\\d+):\\s+(\\d+)\\s+\\[\\s*(\\d+):\\s*(\\d+)\\]',h['header']);assert m\n   phases[e['event']]=dict(zip(['live_objects','live_bytes','allocated_objects','allocated_bytes'],map(int,m.groups())))\n   record['captures'].append({'path':str(p.relative_to(root)),'sha256':sha(p),'header':h['header']})\n  row={'kind':role,'connections':connections,'trace':str(trace.relative_to(root)),'sha256':sha(trace),'phases':phases,'drip_delta':{k:phases['dripped'][k]-phases['ready'][k] for k in phases['ready']}}\n  record['cases'].append(row);output.write_text(json.dumps(record,indent=2)+'\\n');print(json.dumps(row),flush=True)\nrecord['passed']=True;output.write_text(json.dumps(record,indent=2)+'\\n')\n",
