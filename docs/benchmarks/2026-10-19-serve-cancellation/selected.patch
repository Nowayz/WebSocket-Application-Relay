+#[tokio::test]
+async fn cancelling_serve_retires_native_workers_admission_and_both_listeners() {
+    use futures_util::{SinkExt, StreamExt};
+    use tokio::io::{AsyncReadExt, AsyncWriteExt};
+
+    let relay = Relay::new(crate::Config {
+        workers: Some(2),
+        max_connections_per_ip: 2,
+        ping_interval_secs: 0,
+        shutdown_timeout_secs: 1,
+        ..crate::Config::default()
+    })
+    .unwrap();
+    let listener = AsyncListener::bind("127.0.0.1:0").await.unwrap();
+    let address = listener.local_addr().unwrap();
+    let admin = AsyncListener::bind("127.0.0.1:0").await.unwrap();
+    let admin_address = admin.local_addr().unwrap();
+    let mut services = JoinSet::new();
+    let service = services.spawn(serve(
+        listener,
+        Some(admin),
+        relay.clone(),
+        CancellationToken::new(),
+    ));
+    tokio::time::timeout(Duration::from_secs(3), async {
+        let (mut joined, _) = tokio_tungstenite::connect_async(format!("ws://{address}"))
+            .await
+            .unwrap();
+        joined
+            .send(Message::Binary(protocol::byte_string(b"cancel")))
+            .await
+            .unwrap();
+        assert!(matches!(joined.next().await, Some(Ok(Message::Binary(_)))));
+        let mut upgrading = tokio::net::TcpStream::connect(address).await.unwrap();
+        upgrading.write_all(b"GET / HTTP/1.1\r\n").await.unwrap();
+        while relay.metrics.connections.load(Relaxed) != 2 {
+            tokio::task::yield_now().await;
+        }
+        assert_eq!(relay.ip_limit.as_ref().unwrap().address_count(), 1);
+        assert!(relay.metrics.read_budget.as_ref().unwrap().reserved() > 0);
+        service.abort();
+        assert!(
+            services
+                .join_next()
+                .await
+                .unwrap()
+                .unwrap_err()
+                .is_cancelled()
+        );
+        while relay.metrics.connections.load(Relaxed) != 0
+            || relay.metrics.native_connection_slots.load(Relaxed) != 0
+            || relay.metrics.read_budget.as_ref().unwrap().reserved() != 0
+            || relay.ip_limit.as_ref().unwrap().address_count() != 0
+        {
+            tokio::task::yield_now().await;
+        }
+        assert!(relay.is_draining());
+        assert_eq!(relay.counts(), (0, 1));
+        assert_eq!(relay.metrics.queued_bytes.load(Relaxed), 0);
+        assert_eq!(relay.metrics.output_queue_capacity_bytes.load(Relaxed), 0);
+        let Some(Ok(Message::Close(Some(frame)))) = joined.next().await else {
+            panic!("cancelled service did not send shutdown Close");
+        };
+        assert_eq!(frame.code, CloseCode::Away);
+        assert_eq!(frame.reason, "Server Shutdown");
+        let mut byte = [0];
+        match upgrading.read(&mut byte).await {
+            Ok(0) => {}
+            Err(error) if error.kind() == io::ErrorKind::ConnectionReset => {}
+            other => panic!("cancelled pending upgrade did not retire: {other:?}"),
+        }
+        // Reuse the server port despite possible TIME_WAIT sockets, without
+        // SO_REUSEPORT: any surviving listener must still make bind fail.
+        for address in [address, admin_address] {
+            let socket =
+                socket2::Socket::new(socket2::Domain::IPV4, socket2::Type::STREAM, None).unwrap();
+            socket.set_reuse_address(true).unwrap();
+            loop {
+                match socket.bind(&address.into()) {
+                    Ok(()) => break,
+                    Err(error) if error.kind() == io::ErrorKind::AddrInUse => {
+                        tokio::task::yield_now().await;
+                    }
+                    Err(error) => panic!("cannot rebind retired listener: {error}"),
+                }
+            }
+            socket.listen(1).unwrap();
+        }
+        // Client descriptors stay alive until after server resources retire.
+        drop((joined, upgrading));
+    })
+    .await
+    .expect("cancelling serve must retire both listeners and native resources");
+}
