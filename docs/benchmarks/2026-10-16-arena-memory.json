  "collector_source": "import hashlib\nimport json\nfrom pathlib import Path\nimport re\n\nroot = Path(__file__).resolve().parents[1]\nsha = lambda p: hashlib.sha256(Path(p).read_bytes()).hexdigest()\nroles, captures = {}, []\nfor role in ['before','initial','selected']:\n    path = root/f'docs/benchmarks/2026-10-16-arena-heap-{role}.json'\n    trace = json.loads(path.read_text())\n    assert trace['passed'] and trace['profile_diagnostic'] and len(trace['events'])==9\n    assert trace['server_exit_code']==trace['client_exit_code']==0\n    rows = []\n    for event in trace['events']:\n        capture = event['process']['heap']\n        heap = Path(capture['path'])\n        assert sha(heap)==capture['sha256']\n        header = re.search(r'heap profile:\\s*(\\d+):\\s*(\\d+)\\s*\\[\\s*(\\d+):\\s*(\\d+)\\]',heap.read_text())\n        totals = [0]*4\n        for line in heap.read_text().splitlines():\n            match = re.match(r'\\s*(\\d+):\\s*(\\d+)\\s*\\[\\s*(\\d+):\\s*(\\d+)\\]\\s*@',line)\n            if match:\n                for i in range(4): totals[i] += int(match[i+1])\n        assert totals==[int(header[i+1]) for i in range(4)]\n        captures.append(capture)\n        rows.append({'event':event['event'], 'wave':event['wave'],\n            'live_objects':totals[0], 'live_bytes':totals[1],\n            'allocated_objects':totals[2], 'allocated_bytes':totals[3],\n            'sessions':event['metrics']['war_sessions'], 'connections':event['metrics']['war_connections']})\n    baseline = rows[0]\n    recovered = next(row for row in rows if row['event']=='traffic_ready' and row['wave']==2)\n    final = rows[-1]\n    assert recovered['sessions']==recovered['connections']==2\n    assert final['sessions']==final['connections']==0\n    roles[role] = {'trace':str(path.relative_to(root)), 'trace_sha256':sha(path),\n        'server_sha256':trace['server_sha256'], 'client_sha256':trace['client_sha256'],\n        'events':rows, 'recovered_live_byte_increase':recovered['live_bytes']-baseline['live_bytes'],\n        'final_live_byte_increase':final['live_bytes']-baseline['live_bytes']}\nassert len({role['client_sha256'] for role in roles.values()})==1\nassert roles['selected']['final_live_byte_increase']==roles['before']['final_live_byte_increase']\noutput = {'scope':'Three sequential server-only gperftools diagnostics using one frozen client. Two retained clients and two waves of8192 temporary single-member rooms, with verified1KiB routing before/after each wave. Every raw heap row sums to its capture header. Whole requested live/cumulative heap; not ordinary RSS or timing. Initial prototype compacts sparse arenas but keeps their small allocations after the last client leaves. Selected remembers that compaction occurred and restores full empty-worker cleanup. Release unwind stacks merge unrelated raw-vector allocation sites; source and whole-heap ablation establish the mechanism without claiming exact allocation-site attribution.',\n    'roles':roles, 'captures':captures, 'passed':True, 'collector_source':Path(__file__).read_text()}\n(root/'docs/benchmarks/2026-10-16-arena-memory.json').write_text(json.dumps(output,indent=2)+'\\n')\nprint(json.dumps({'passed':True,'captures':len(captures),\n    'roles':{k:{name:r[name] for name in ['recovered_live_byte_increase','final_live_byte_increase']} for k,r in roles.items()}}))\n"
}
