  "collector_source": "import hashlib\nimport json\nfrom pathlib import Path\nimport re\n\nroot=Path(__file__).resolve().parents[1]\nsha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()\nroles={};captures=[]\nfor label in ['before','disabled','enabled','4w-before','4w-disabled','4w-enabled']:\n    path=root/f'docs/benchmarks/2026-10-16-ip-admission-heap-{label}.json'\n    trace=json.loads(path.read_text());assert trace['passed'] and trace['profile_diagnostic']\n    rows=[]\n    for event in trace['events']:\n        capture=event['heap'];heap=Path(capture['path']);assert sha(heap)==capture['sha256']\n        body=heap.read_text();header=re.search(r'heap profile:\\s*(\\d+):\\s*(\\d+)\\s*\\[\\s*(\\d+):\\s*(\\d+)\\]',body)\n        totals=[0]*4\n        for line in body.splitlines():\n            match=re.match(r'\\s*(\\d+):\\s*(\\d+)\\s*\\[\\s*(\\d+):\\s*(\\d+)\\]\\s*@',line)\n            if match:\n                for i in range(4):totals[i]+=int(match[i+1])\n        assert totals==[int(header[i+1]) for i in range(4)]\n        captures.append(capture)\n        rows.append({'event':event['event'],'live_objects':totals[0],'live_bytes':totals[1],\n            'allocated_objects':totals[2],'allocated_bytes':totals[3]})\n    ready,measured,done=rows\n    assert ready['event']=='ready' and measured['event']=='measured' and done['event']=='done'\n    roles[label]={'trace':str(path.relative_to(root)),'trace_sha256':sha(path),'server_sha256':trace['server_sha256'],\n        'workers':int(trace['server_command'][trace['server_command'].index('--workers')+1]),'events':rows,\n        'traffic_allocation_delta':{k:measured[k]-ready[k] for k in ['live_objects','live_bytes','allocated_objects','allocated_bytes']}}\nassert all(roles[role]['workers']==1 for role in ['before','disabled','enabled'])\nassert all(roles[role]['traffic_allocation_delta']=={'live_objects':0,'live_bytes':0,'allocated_objects':50,'allocated_bytes':62456} for role in roles)\noutput={'scope':'Six server-only gperftools diagnostics,18 hashed captures whose every row sums to its header.8192 idle single-member rooms and one private pair (8194 clients),1KiB changing values/window16. Three one-worker controls hold arena capacity stable; preliminary four-worker controls preserve evidence of flow-distribution/arena-growth noise. Before is the preceding release, disabled/enabled use the same new release with limit0/9000. Whole requested heap, not RSS or allocator size-class claims. Boundary management sampling/dump overhead remains in traffic allocation deltas. No profiled timing is used as an ordinary measurement.',\n    'roles':roles,'captures':captures,'passed':True,'collector_source':Path(__file__).read_text()}\n(root/'docs/benchmarks/2026-10-16-ip-admission-memory.json').write_text(json.dumps(output,indent=2)+'\\n')\nprint(json.dumps({'passed':True,'captures':len(captures),'ready_bytes':{r:roles[r]['events'][0]['live_bytes'] for r in ['before','disabled','enabled']},'traffic_allocations':roles['enabled']['traffic_allocation_delta']}))\n"
}
