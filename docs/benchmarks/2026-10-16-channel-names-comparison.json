  "driver_source": "import hashlib\nimport json\nfrom pathlib import Path\nimport statistics\nimport subprocess\nimport sys\n\nroot=Path(__file__).resolve().parents[1]\nselected=json.loads((root/'artifacts/channel-names-selected.json').read_text())\nservers={'before':root/'artifacts/baselines/04cc911/war-relay','selected':root/selected['directory']/'war-relay'}\nclients={'inspection':root/'artifacts/baselines/e2d7cf9/inspection','population':root/'artifacts/baselines/listener-study-clients/registry_peak'}\noutput=root/'docs/benchmarks/2026-10-16-channel-names-comparison.json'\nsha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()\nrecord={'scope':'Sequential fresh before/selected servers, same frozen clients, four workers and default limits. Three repetitions; workload order rotates and implementation order alternates. Server CPUs 0-3 and clients 4-7. Inspection cases hold 8192 separate idle rooms and one private pair, 1KiB values/window16 for 8 seconds: private has no churn; churn adds eight reconnect workers; management adds 200 HTTP inspections/s. Shared cases use 1024 additional global-room peers and three 3-second private phases before/during/after population, with complete ordered departure/Close/EOF checks outside routing timing. All full payload/FIFO/counter/resource checks must pass. No builds, profilers or other load tests overlap timing. Allocation diagnostics are separate.',\n        'selected_revision':selected['revision'],'before_revision':'04cc911c17ebb33ee98cba434bf5ba6788b35cdf',\n        'variants':{k:{'path':str(v),'sha256':sha(v)} for k,v in servers.items()},\n        'clients':{k:{'path':str(v),'sha256':sha(v)} for k,v in clients.items()},\n        'helpers':{name:sha(root/'scripts'/name) for name in ['inspection.py','registry-peak.py','benchmark.py']},\n        'driver_source':Path(__file__).read_text(),'driver_sha256':sha(__file__),'cases':[],'passed':False}\nnames=['private','churn','management','shared']\nfor repetition in range(1,4):\n    start=(repetition-1)%len(names)\n    for workload in names[start:]+names[:start]:\n        for kind in (['before','selected'] if repetition%2 else ['selected','before']):\n            trace=output.with_name(f'{output.stem}-{workload}-{kind}-{repetition}.json')\n            if workload=='shared':\n                helper='registry-peak.py';client='population'\n                command=[sys.executable,str(root/'scripts'/helper),'--server',str(servers[kind]),'--client',str(clients[client]),'--scope','private','--measure-populated','--peak-clients','1024','--seconds','3','--output',str(trace)]\n            else:\n                helper='inspection.py';client='inspection'\n                command=[sys.executable,str(root/'scripts'/helper),'--server',str(servers[kind]),'--client',str(clients[client]),'--pairs','1','--seconds','8','--mode','http' if workload=='management' else 'none','--churn-workers','0' if workload=='private' else '8','--output',str(trace)]\n            completed=subprocess.run(command,cwd=root,capture_output=True,text=True,timeout=180)\n            data=json.loads(trace.read_text());assert completed.returncode==0 and data['passed'],completed.stdout+completed.stderr\n            assert not data['profile_diagnostic'] and data['server_sha256']==record['variants'][kind]['sha256']\n            assert data['client_sha256']==record['clients'][client]['sha256'] and data['runner_sha256']==record['helpers'][helper]\n            row={'kind':kind,'workload':workload,'repetition':repetition,'trace':str(trace.relative_to(root)),'trace_sha256':sha(trace),'passed':True}\n            if workload=='shared':\n                phase=data['traffic'][1];assert phase['populated'];event=next(e for e in data['events'] if e['event']=='population_traffic_done')\n                row.update(healthy=phase['deliveries_per_second'],healthy_p99_ms=phase['p99_upper_ms'],churn=0.0,inspection=0.0,churn_p99_ms=0.0,inspection_p99_ms=0.0,cpu_wall=phase['server_cpu_seconds']/phase['elapsed_seconds'],rss_mib=event['process']['VmRSS']/1024,server_ns_per_delivery=phase['server_ns_per_delivery'],phases=data['traffic'])\n            else:\n                mixed=data['mixed'];row.update(healthy=mixed['healthy']['per_second'],healthy_p99_ms=mixed['healthy']['p99_upper_ms'],churn=mixed['churn']['per_second'],churn_p99_ms=mixed['churn']['p99_upper_ms'],inspection=mixed['inspection']['per_second'],inspection_p99_ms=mixed['inspection']['p99_upper_ms'],cpu_wall=mixed['server_cpu_seconds_per_wall_second'],rss_mib=data['events'][1]['process']['VmRSS']/1024)\n            record['cases'].append(row);output.write_text(json.dumps(record,indent=2)+'\\n');print(json.dumps(row),flush=True)\nrecord['medians']={}\nfor workload in names:\n    for kind in servers:\n        rows=[r for r in record['cases'] if r['kind']==kind and r['workload']==workload]\n        keys=['healthy','healthy_p99_ms','churn','churn_p99_ms','inspection','inspection_p99_ms','cpu_wall','rss_mib']\n        if workload=='shared':keys.append('server_ns_per_delivery')\n        summary={k:statistics.median(r[k] for r in rows) for k in keys}\n        summary['ranges']={k:[min(r[k] for r in rows),max(r[k] for r in rows)] for k in ['healthy','churn']}\n        record['medians'][workload+'/'+kind]=summary\nrecord['passed']=True;output.write_text(json.dumps(record,indent=2)+'\\n');print(json.dumps(record['medians']),flush=True)\n",
