i,g in enumerate(groups) if source in g['peers']]}\n return {'owners':owners,'worker_sizes':[len(g['peers'])-int(0 in g['peers']) for g in groups]}\n\ndef snapshot(pid):\n r=original(pid);extra=layout(pid)\n if extra:r['socket_layout']=extra\n return r\ninspection.runtime.snapshot=snapshot\nclass PlacementRejected(Exception):pass\ncheck_original=inspection.check\nparser=argparse.ArgumentParser()\nparser.add_argument('--server',required=True)\nparser.add_argument('--output',required=True)\nparser.add_argument('--workers',type=int,default=4)\nparser.add_argument('--readers',type=int,default=512)\nparser.add_argument('--placement',choices=['any','shared','separate'],default='any')\nparser.add_argument('--seconds',type=int,default=6)\nparser.add_argument('--profile',action='store_true')\na=parser.parse_args()\ndef check(event,*args,**kwargs):\n check_original(event,*args,**kwargs)\n if event['event']=='ready':\n  placement=event['process'].get('socket_layout');assert placement,'missing socket ownership'\n  assert len(placement['worker_sizes'])==a.workers\n  assert sum(placement['worker_sizes'])==2+(a.readers+1 if a.readers else 0)\n  if a.placement!='any':\n   roles=placement['owners'];left=roles['private_source']['workers'];right=roles['broadcast_source']['workers']\n   assert len(left)==len(right)==1\n   shared=left==right;event['placement_accepted']=shared==(a.placement=='shared')\n   if not event['placement_accepted']:raise PlacementRejected(f'need {a.placement}; captured {placement}')\ninspection.check=check\nargs=argparse.Namespace(server=Path(a.server),client=root/'artifacts/baselines/fanout-probe/inspection',mode='none',page_size=None,rooms=0,seconds=a.seconds,inspectors=0,inspection_interval_ms=10,pairs=1,churn_workers=8,workers=a.workers,fanout_readers=a.readers,read_storage='worker',server_cpus='0-3',client_cpus='4-7',profile=a.profile,heap_profile=None,heap_library=Path('/usr/lib/libtcmalloc.so'),output=Path(a.output))\nr=inspection.run(args)\nrejected=bool(