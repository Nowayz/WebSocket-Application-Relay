  "driver_source": "import hashlib\nimport json\nfrom pathlib import Path\nimport statistics\nimport subprocess\nimport sys\n\nroot = Path(__file__).resolve().parents[1]\nsha = lambda p: hashlib.sha256(Path(p).read_bytes()).hexdigest()\nmeta = json.loads((root/'artifacts/setup-pressure-candidate.json').read_text())\nservers = {'before':root/meta['baseline']['path'], 'selected':root/meta['directory']/'war-relay'}\nclient = root/'artifacts/baselines/fanout-probe/inspection'\noutput = root/'docs/benchmarks/2026-10-16-setup-pressure-guard.json'\nrecord = {'scope':'Twelve sequential fresh four-worker processes; three alternating pairs per workload, six seconds each. Pure private: 8192 idle rooms, one private pair. Mixed: no idle rooms, one private pair and eight reconnect workers. Both use the same frozen client, 1KiB cyclic bodies, window16, no inspection or broadcast, default IP quota disabled. Server CPUs0-3 and client CPUs4-7. Complete body/sender/FIFO/Close/EOF, independent exact counters and zero final resources. No injected failures, builds, profilers or competing workloads overlap timings. Lifecycle CPU and mixed completed work do not give a per-operation CPU comparison.',\n 'source_revision':meta['source_revision'], 'selected_source_hashes':meta['sources'],\n 'before_source_revision':meta['baseline']['revision'],\n 'variants':{key:{'path':str(path.relative_to(root)), 'sha256':sha(path)} for key,path in servers.items()},\n 'client':{'path':str(client.relative_to(root)),'sha256':sha(client),'source_revision':'c8b55d394c92c0f2bdf4f7bf5a299239397dbc53','source_hashes':{name:sha(client.parent/name) for name in ['examples/inspection.rs','examples/inspection/fanout.rs']}},\n 'helpers':{name:sha(root/'scripts'/name) for name in ['inspection.py','benchmark.py']},\n 'driver_source':Path(__file__).read_text(),'cases':[],'passed':False}\nfor repetition in range(1,4):\n for workload in (['private','mixed'] if repetition % 2 else ['mixed','private']):\n  for role in (['before','selected'] if repetition % 2 else ['selected','before']):\n   trace=output.with_name(f'{output.stem}-{workload}-{role}-{repetition}.json')\n   command=[sys.executable,str(root/'scripts/inspection.py'),'--server',str(servers[role]),'--client',str(client),\n    '--rooms','8192' if workload=='private' else '0','--pairs','1','--seconds','6',\n    '--mode','none','--inspectors','0','--churn-workers','0' if workload=='private' else '8','--output',str(trace)]\n   done=subprocess.run(command,cwd=root,capture_output=True,text=True,timeout=90)\n   data=json.loads(trace.read_text()); assert done.returncode==0 and data['passed'],done.stdout+done.stderr\n   assert not data['profile_diagnostic'] and data['server_sha256']==record['variants'][role]['sha256']\n   assert data['client_sha256']==record['client']['sha256']\n   assert data['events'][-1]['event']=='done' and data['server_exit_code']==0\n   for e in data['events']: assert e['metrics'].get('war_setup_errors_total',0)==0 and e['metrics']['war_accept_errors_total']==0\n   m=data['mixed']\n   row={'kind':role,'workload':workload,'repetition':repetition,'trace':str(trace.relative_to(root)),'trace_sha256':sha(trace),'passed':True,\n    'healthy':m['healthy']['per_second'],'healthy_p99_ms':m['healthy']['p99_upper_ms'],\n    'churn':m['churn']['per_second'],'churn_p99_ms':m['churn']['p99_upper_ms'],\n    'cpu_wall':m['server_cpu_seconds_per_wall_second'],'client_cpu_wall':m['client_cpu_seconds_per_wall_second'],\n    'rss_mib':data['events'][1]['process']['VmRSS']/1024}\n   record['cases'].append(row); output.write_text(json.dumps(record,indent=2)+'\\n');print(json.dumps(row),flush=True)\nrecord['medians']={}\nfor workload in ['private','mixed']:\n for role in servers:\n  rows=[r for r in record['cases'] if r['kind']==role and r['workload']==workload]\n  fields=['healthy','healthy_p99_ms','churn','churn_p99_ms','cpu_wall','client_cpu_wall','rss_mib']\n  summary={key:statistics.median(r[key] for r in rows) for key in fields}\n  summary['ranges']={key:[min(r[key] for r in rows),max(r[key] for r in rows)] for key in fields}\n  record['medians'][workload+'/'+role]=summary\nrecord['passed']=True;output.write_text(json.dumps(record,indent=2)+'\\n');print(json.dumps(record['medians']),flush=True)\n",
