+}
+
+fn byte_request(op: u8, value: &[u8]) -> Bytes {
+    let mut e = request_encoder(op, protocol::uint_len(value.len() as u64) + value.len());
+    e.bytes(value).expect("Vec encoding");
+    e.into_writer().into()
+}
+
+fn uint_request(op: u8, value: u64) -> Bytes {
+    let mut e = request_encoder(op, protocol::uint_len(value));
+    e.u64(value).expect("Vec encoding");
     e.into_writer().into()
 }
 
