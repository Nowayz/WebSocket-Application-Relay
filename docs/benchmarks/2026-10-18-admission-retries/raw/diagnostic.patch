+impl AdmitStats {
+    pub(crate) fn local(&self, attempts: u64) {
+        self.local_calls.store(self.local_calls.load(Relaxed).wrapping_add(1), Relaxed);
+        self.local_retries.store(self.local_retries.load(Relaxed).wrapping_add(attempts - 1), Relaxed);
+    }
+    pub(crate) fn global(&self, attempts: u64) {
+        self.global_calls.store(self.global_calls.load(Relaxed).wrapping_add(1), Relaxed);
+        self.global_retries.store(self.global_retries.load(Relaxed).wrapping_add(attempts - 1), Relaxed);
+    }
+}
