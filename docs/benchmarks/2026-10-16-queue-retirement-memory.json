  "collector_source": "import hashlib\nimport json\nfrom pathlib import Path\nimport re\n\nroot=Path(__file__).resolve().parents[1]\nsha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()\nroles={};captures=[]\nfor role in ['before','observed','selected']:\n    path=root/f'docs/benchmarks/2026-10-16-queue-waves-heap-{role}.json'\n    record=json.loads(path.read_text());assert record['passed']\n    rows=[]\n    for event in record['events']:\n        capture=event['process']['heap'];heap=Path(capture['path']);assert sha(heap)==capture['sha256']\n        text=heap.read_text();header=re.search(r'heap profile:\\s*(\\d+):\\s*(\\d+)\\s*\\[\\s*(\\d+):\\s*(\\d+)\\]',text)\n        totals=[0]*4\n        for line in text.splitlines():\n            match=re.match(r'\\s*(\\d+):\\s*(\\d+)\\s*\\[\\s*(\\d+):\\s*(\\d+)\\]\\s*@',line)\n            if match:\n                for i in range(4):totals[i]+=int(match[i+1])\n        assert header and totals==[int(header[i+1]) for i in range(4)]\n        captures.append(capture)\n        rows.append({'event':event['event'],'wave':event['wave'],'live_objects':totals[0],\n                     'live_bytes':totals[1],'allocated_objects':totals[2],'allocated_bytes':totals[3],\n                     'queue_capacity_bytes':event['metrics'].get('war_output_queue_capacity_bytes'),\n                     'peak_queue_capacity_bytes':event['metrics'].get('war_output_queue_peak_capacity_bytes'),\n                     'encoded_queued_bytes':event['metrics']['war_queued_bytes']})\n    ready=rows[0];idle=next(row for row in rows if row['event']=='idle')\n    roles[role]={'trace':str(path.relative_to(root)),'trace_sha256':sha(path),\n                 'server_sha256':record['server_sha256'],'events':rows,\n                 'ready_to_idle':{key:idle[key]-ready[key] for key in ['live_objects','live_bytes','allocated_objects','allocated_bytes']}}\nassert all(row['queue_capacity_bytes']==163840 for row in roles['observed']['events'] if row['event'] in ['drained','idle'])\nassert all(row['queue_capacity_bytes']==0 for row in roles['selected']['events'] if row['event'] in ['drained','idle','done'])\nassert all(row['queue_capacity_bytes']==163840 for row in roles['selected']['events'] if row['event']=='queued')\noutput={'scope':'Three server-only gperftools diagnostics: original, capacity instrumentation without retirement, selected retirement.32 persistent receivers; three waves of8MiB and48 scalar broadcasts. Headers verified against every raw heap row. Direct capacity metrics isolate requested output slots; whole-heap deltas include transport/runtime/measurement storage and are not RSS.','roles':roles,'captures':captures,'passed':True,'collector_source':Path(__file__).read_text()}\n(root/'docs/benchmarks/2026-10-16-queue-retirement-memory.json').write_text(json.dumps(output,indent=2)+'\\n')\nprint(json.dumps({'passed':True,'captures':len(captures),'roles':{role:record['ready_to_idle'] for role,record in roles.items()}}))\n"
}
