# HELP war_read_buffer_reserved_bytes Decoder staging allowance reserved, including two-times capacity growth headroom; excludes published payloads and allocator overhead.
# TYPE war_read_buffer_reserved_bytes gauge
war_read_buffer_reserved_bytes 0
# HELP war_read_buffer_peak_reserved_bytes Peak successfully reserved decoder staging allowance.
# TYPE war_read_buffer_peak_reserved_bytes gauge
war_read_buffer_peak_reserved_bytes 0
# HELP war_read_buffer_limit_bytes Shared decoder staging allowance; zero disables admission.
# TYPE war_read_buffer_limit_bytes gauge
war_read_buffer_limit_bytes 1073741824
# HELP war_read_buffer_reservations_rejected_total Decoder staging growth or connection admissions refused before allocation.
# TYPE war_read_buffer_reservations_rejected_total counter
war_read_buffer_reservations_rejected_total 0
# HELP war_accept_errors_total Native listener accept failures excluding WouldBlock and Interrupted; admission retries while established connections continue.
# TYPE war_accept_errors_total counter
war_accept_errors_total 0
