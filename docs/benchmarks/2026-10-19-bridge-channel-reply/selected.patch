+// Legacy channel replies put all length-prefixed names before populations.
+// Their name block cannot exceed the remaining encoded entries: every entry
+// already contains its name, a CBOR string header, array header and population.
+fn channel_reply(d: &mut Decoder<'_>) -> Result<Message> {
+    let count = u32::try_from(d.array()?.context("indefinite channel list")?)?;
+    // Each representable name needs at most one length byte plus 255 bytes.
+    // A malformed oversized name must not inflate the destination allocation.
+    let names_bound = (d.input().len() - d.position()).min(count as usize * 256);
+    let populations_start = 12 + names_bound;
+    // protocol::parse bounds the complete envelope to MAX_ITEMS. Keep the
+    // population block after the upper bound on names while decoding once.
+    let mut reply = vec![0; populations_start + count as usize * 4];
+    reply[8..12].copy_from_slice(&count.to_le_bytes());
+    let mut name_offset = 12;
+    let mut population_offset = populations_start;
+    for _ in 0..count {
+        if d.array()? != Some(2) {
+            bail!("invalid channel entry");
+        }
+        let name = d.bytes()?;
+        reply[name_offset] = u8::try_from(name.len())?;
+        name_offset += 1;
+        reply[name_offset..name_offset + name.len()].copy_from_slice(name);
+        name_offset += name.len();
+        let population = u32::try_from(d.u64()?)?;
+        reply[population_offset..population_offset + 4].copy_from_slice(&population.to_le_bytes());
+        population_offset += 4;
+    }
+    reply.copy_within(populations_start.., name_offset);
+    reply.truncate(name_offset + count as usize * 4);
+    Ok(Message::Binary(reply.into()))
+}
