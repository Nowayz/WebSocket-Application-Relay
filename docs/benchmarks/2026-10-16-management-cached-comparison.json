  "driver_source": "import hashlib\nimport json\nfrom pathlib import Path\nimport statistics\nimport subprocess\nimport sys\n\nroot = Path(__file__).resolve().parents[1]\nsha = lambda p: hashlib.sha256(Path(p).read_bytes()).hexdigest()\ncandidate = json.loads((root/'artifacts/management-cached-candidate.json').read_text())\nservers = {'before':root/'artifacts/baselines/b0da28a/war-relay',\n           'selected':root/candidate['directory']/'war-relay'}\nclient = root/'artifacts/baselines/e2d7cf9/inspection'\noutput = root/'docs/benchmarks/2026-10-16-management-cached-comparison.json'\nrecord = {'scope':'Sequential fresh processes; three repetitions, rotating workload and alternating implementation order. Four server workers on CPUs0-3, unchanged client on CPUs4-7. Each case runs one private pair, 1KiB values/window16 for 8 seconds. Private control holds 8192 idle rooms without inspectors or churn. Management holds 8192 idle rooms with eight reconnect workers and two authenticated HTTP inspectors at 10ms intervals (200 requested queries/s). Small management uses 64 idle rooms with the same churn and inspector settings. Every payload, sender, FIFO, listing field/order, Close/EOF, counter and final resource is checked by the unchanged client and runner. No builds, profiling or other load tests overlap ordinary timing.',\n    'before_runtime_revision':'b0da28aec8a9c68982c1d4f20cf89d77917d1c08',\n    'selected_source_hashes':candidate['sources'],\n    'variants':{k:{'path':str(p.relative_to(root)),'sha256':sha(p)} for k,p in servers.items()},\n    'client':{'path':str(client.relative_to(root)),'sha256':sha(client)},\n    'helpers':{name:sha(root/'scripts'/name) for name in ['inspection.py','benchmark.py']},\n    'driver_source':Path(__file__).read_text(),'driver_sha256':sha(__file__),'cases':[],'passed':False}\nnames = ['management','private','small']\nfor repetition in range(1,4):\n    offset = (repetition-1)%len(names)\n    for workload in names[offset:]+names[:offset]:\n        for kind in (['before','selected'] if repetition%2 else ['selected','before']):\n            trace = output.with_name(f'{output.stem}-{workload}-{kind}-{repetition}.json')\n            command = [sys.executable,str(root/'scripts/inspection.py'),'--server',str(servers[kind]),\n                '--client',str(client),'--pairs','1','--seconds','8','--rooms','64' if workload=='small' else '8192',\n                '--mode','none' if workload=='private' else 'http','--churn-workers','0' if workload=='private' else '8',\n                '--output',str(trace)]\n            completed = subprocess.run(command,cwd=root,capture_output=True,text=True,timeout=120)\n            data = json.loads(trace.read_text())\n            assert completed.returncode == 0 and data['passed'], completed.stdout+completed.stderr\n            assert not data['profile_diagnostic'] and data['server_sha256'] == record['variants'][kind]['sha256']\n            assert data['client_sha256'] == record['client']['sha256']\n            assert data['runner_sha256'] == record['helpers']['inspection.py']\n            mixed = data['mixed']\n            row = {'kind':kind,'workload':workload,'repetition':repetition,'trace':str(trace.relative_to(root)),\n                'trace_sha256':sha(trace),'passed':True,'healthy':mixed['healthy']['per_second'],\n                'healthy_p99_ms':mixed['healthy']['p99_upper_ms'],'churn':mixed['churn']['per_second'],\n                'churn_p99_ms':mixed['churn']['p99_upper_ms'],'inspection':mixed['inspection']['per_second'],\n                'inspection_p99_ms':mixed['inspection']['p99_upper_ms'],\n                'inspection_max_ms':mixed['inspection']['max_ms'],\n                'cpu_wall':mixed['server_cpu_seconds_per_wall_second'],\n                'rss_mib':data['events'][1]['process']['VmRSS']/1024}\n            record['cases'].append(row)\n            output.write_text(json.dumps(record,indent=2)+'\\n')\n            print(json.dumps(row),flush=True)\nrecord['medians'] = {}\nfor workload in names:\n    for kind in servers:\n        rows = [r for r in record['cases'] if r['workload']==workload and r['kind']==kind]\n        keys = ['healthy','healthy_p99_ms','churn','churn_p99_ms','inspection','inspection_p99_ms','inspection_max_ms','cpu_wall','rss_mib']\n        result = {key:statistics.median(r[key] for r in rows) for key in keys}\n        result['ranges'] = {key:[min(r[key] for r in rows),max(r[key] for r in rows)] for key in ['healthy','churn','inspection_p99_ms']}\n        record['medians'][workload+'/'+kind] = result\nrecord['passed'] = True\noutput.write_text(json.dumps(record,indent=2)+'\\n')\nprint(json.dumps(record['medians']),flush=True)\n",
