+/// Room retirement uses stable admission keys, not a population-sized snapshot.
+/// Members leaving before delivery are already ineligible; later joins have keys
+/// beyond the captured cutoff. A recreated room therefore cannot inherit work.
+enum Retirement {
+    Room(RoomRetirement),
+    Observers(RoomFanout),
+}
+
+struct RoomRetirement {
+    packet: Envelope,
+    channel: Bytes,
+    cursor: u64,
+    before: u64,
+    metadata_bytes: usize,
+}
+
+impl RoomRetirement {
+    fn new(source: &Peer, before: u64, frame: &Frame) -> Result<Self, Disconnect> {
+        let packet = source
+            .charge(frame)?
+            .ok_or(Disconnect::OVERLOADED)?
+            .into_owned();
+        let metadata_bytes =
+            std::mem::size_of::<Retirement>() + 2 * std::mem::size_of::<Box<Retirement>>();
+        if packet
+            .budget
+            .metrics
+            .queued_bytes
+            .fetch_update(Relaxed, Relaxed, |used| {
+                used.checked_add(metadata_bytes)
+                    .filter(|&next| next <= packet.budget.global_limit)
+            })
+            .is_err()
+        {
+            packet.budget.metrics.global_pressure.fetch_add(1, Relaxed);
+            return Err(Disconnect::OVERLOADED);
+        }
+        Ok(Self {
+            packet,
+            channel: source.channel.clone(),
+            cursor: 0,
+            before,
+            metadata_bytes,
+        })
+    }
+
+    fn capture(&mut self, state: &Registry, targets: &mut [Option<Arc<Peer>>]) -> bool {
+        let Some(channel) = state.channels.get(&self.channel) else {
+            return true;
+        };
+        let mut members = channel
+            .members
+            .range((Excluded(self.cursor), Excluded(self.before)));
+        for slot in targets {
+            let Some((&key, peer)) = members.next() else {
+                return true;
+            };
+            self.cursor = key;
+            *slot = Some(peer.clone());
+        }
+        members.next().is_none()
+    }
+
+    fn deliver(&self, targets: &mut [Option<Arc<Peer>>]) {
+        for target in targets.iter_mut().filter_map(Option::take) {
+            let _ = target.enqueue_fanout(&self.packet.frame);
+        }
+    }
+}
+
+impl Drop for RoomRetirement {
+    fn drop(&mut self) {
+        self.packet
+            .budget
+            .metrics
+            .queued_bytes
+            .fetch_sub(self.metadata_bytes, Relaxed);
     }
 }
 
