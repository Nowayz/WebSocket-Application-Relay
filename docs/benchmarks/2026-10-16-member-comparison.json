  "comparison_source": "import datetime,hashlib,json,statistics,subprocess\nfrom pathlib import Path\nroot=Path('/home/phil/dev/war_next');sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()\nservers={'control':root/'artifacts/baselines/3963138/war-relay','selected':root/'artifacts/candidates/member-trim/war-relay'}\nclient=root/'artifacts/clients/member-peak/registry_peak';out=root/'docs/benchmarks/2026-10-16-member-comparison.json'\nrecord={'timestamp_utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),'base_revision':subprocess.check_output(['git','rev-parse','HEAD'],cwd=root,text=True).strip(),'server_sha256':{k:sha(p) for k,p in servers.items()},'client_sha256':sha(client),'client_source_sha256':sha(root/'examples/registry_peak.rs'),'runner_sha256':sha(root/'scripts/registry-peak.py'),'comparison_source':Path(__file__).read_text(),'scope':'Three fresh processes per build/scope, order reverses on second repetition. Room broadcast and global-room private delivery, two original peers held through 8192 transient peers. Every full encoded traffic frame, all 33566720 departure deliveries, Close/EOF and exact metric totals are checked per process. Default 64-message queues; 16-departure windows wait for all remaining reader prefixes. Four-worker server on CPUs 0-3, same frozen client on 4-7. Three seconds of traffic before/after population; native filling/draining CPU recorded separately. No overlapping workloads, profiled timings or deployment capacity claim.','cases':[]}\nfor scope in ['room','private']:\n for repetition in range(1,4):\n  for label in (['control','selected'] if repetition!=2 else ['selected','control']):\n   trace=root/f'docs/benchmarks/2026-10-16-member-{scope}-{label}-{repetition}.json'\n   command=['python3','scripts/registry-peak.py','--server',str(servers[label]),'--client',str(client),'--scope',scope,'--peak-clients','8192','--seconds','3','--output',str(trace)]\n   with open(root/f'artifacts/member-{scope}-{label}-{repetition}.log','w') as log:\n    p=subprocess.run(command,stdout=log,stderr=subprocess.STDOUT,cwd=root)\n   d=json.loads(trace.read_text());assert p.returncode==0 and d['passed'],d.get('error')\n   assert d['server_exit_code']==d['client_exit_code']==0\n   assert d['server_sha256']==record['server_sha256'][label] and d['client_sha256']==record['client_sha256'] and d['runner_sha256']==record['runner_sha256']\n   assert d['events'][-1]['details']['departure_deliveries']==33566720\n   events=d['events'];event=lambda kind:next(e for e in events if e['event']==kind and (e['wave']==1 or kind=='traffic_done'))\n   fresh,after=d['traffic']; peak=next(e for e in events if e['event']=='population_ready'); ready=next(e for e in events if e['event']=='traffic_ready' and e['wave']==1);fresh_done=next(e for e in events if e['event']=='traffic_done' and e['wave']==0)\n   row={'scope':scope,'label':label,'repetition':repetition,'trace':str(trace.relative_to(root)),'trace_sha256':sha(trace),'passed':True,'fresh':fresh,'after':after,'join_cpu_seconds':peak['process']['cpu_seconds']-fresh_done['process']['cpu_seconds'],'close_cpu_seconds':ready['process']['cpu_seconds']-peak['process']['cpu_seconds'],'normal_closes':d['events'][-1]['details']['normal_closes'],'departure_deliveries':d['events'][-1]['details']['departure_deliveries'],'verified_traffic':sum(t['verified'] for t in d['traffic'])}\n   record['cases'].append(row);out.write_text(json.dumps(record,indent=2)+'\\n');print(json.dumps({'scope':scope,'label':label,'repetition':repetition,'after_verified_per_second':after['deliveries_per_second'],'after_server_ns':after['server_ns_per_delivery'],'passed':True}),flush=True)\nrecord['medians']={}\nfor scope in ['room','private']:\n for label in servers:\n  rows=[r for r in record['cases'] if r['scope']==scope and r['label']==label]\n  record['medians'][f'{scope}/{label}']={f'{phase}_{field}':statistics.median(r[phase][field] for r in rows) for phase in ['fresh','after'] for field in ['deliveries_per_second','server_ns_per_delivery','p99_upper_ms']}\n  record['medians'][f'{scope}/{label}'].update(join_cpu_seconds=statistics.median(r['join_cpu_seconds'] for r in rows),close_cpu_seconds=statistics.median(r['close_cpu_seconds'] for r in rows))\nrecord.update(passed=True,total_verified_traffic=sum(r['verified_traffic'] for r in record['cases']),total_verified_departures=sum(r['departure_deliveries'] for r in record['cases']),total_normal_closes=sum(r['normal_closes'] for r in record['cases']))\nout.write_text(json.dumps(record,indent=2)+'\\n');print(json.dumps({'passed':True,'medians':record['medians']}),flush=True)\n",
  "scope": "Three fresh processes per build/scope, order reverses on second repetition. Room broadcast and global-room private delivery, two original peers held through 8192 transient peers. Every full encoded traffic frame, all 33566720 departure deliveries, Close/EOF and exact metric totals are checked per process. Default 64-message queues; 16-departure windows wait for all remaining reader prefixes. Four-worker server on CPUs 0-3, same frozen client on 4-7. Three seconds of traffic before/after population; native filling/draining CPU recorded separately. No overlapping workloads, profiled timings or deployment capacity claim.",
