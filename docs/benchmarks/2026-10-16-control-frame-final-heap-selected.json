  "driver_source": "\"\"\"Server-only allocation diagnostic with independent native CBOR wire checks.\"\"\"\nimport argparse\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport signal\nimport socket\nimport struct\nimport subprocess\nimport sys\nimport tempfile\nimport time\n\nroot = Path(__file__).resolve().parents[1]\nsys.path.insert(0,str(root/'scripts'))\nimport benchmark\nimport inspection\nimport reference\n\nparser = argparse.ArgumentParser()\nparser.add_argument('--server',type=Path,required=True)\nparser.add_argument('--output',type=Path,required=True)\nparser.add_argument('--prefix',type=Path,required=True)\nargs = parser.parse_args()\nsha = lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()\nprefix = args.prefix.resolve(); prefix.parent.mkdir(parents=True,exist_ok=True)\nassert not list(prefix.parent.glob(prefix.name+'*.heap'))\nport, admin = benchmark.free_port(), benchmark.free_port()\nassert port != admin\nlibrary = Path('/usr/lib/libtcmalloc.so').resolve()\nenv = {k:v for k,v in os.environ.items() if not k.startswith('WAR_')}\nenv.update(WAR_AUTH_PASSWORD='control-heap',LD_PRELOAD=str(library),HEAPPROFILE=str(prefix),\n           HEAPPROFILESIGNAL=str(signal.SIGUSR2),HEAP_PROFILE_ALLOCATION_INTERVAL=str(100*1024**3),\n           HEAP_PROFILE_INUSE_INTERVAL=str(100*1024**3))\ncommand = ['taskset','-c','0-3',str(args.server.resolve()),'--bind',f'127.0.0.1:{port}',\n           '--admin-bind',f'127.0.0.1:{admin}','--workers','4','--messages-per-second','0',\n           '--bytes-per-second','0','--ping-interval-secs','0']\ncounts = dict(joins=0,closes=0,messages=0,incoming_bytes=0,deliveries=0,delivered_bytes=0)\n\ndef uint(n):\n    if n<24:return bytes([n])\n    for limit,tag,size in [(256,24,1),(65536,25,2),(2**32,26,4),(2**64,27,8)]:\n        if n<limit:return bytes([tag])+n.to_bytes(size,'big')\n    raise ValueError(n)\n\ndef data(value):\n    size=uint(len(value)); return bytes([size[0]|0x40])+size[1:]+value\n\ndef reply(op,value):return b'\\x82\\x00\\x82'+uint(op)+value\n\nclass Client(reference.Client):\n    def __init__(self,channel=b'control'):\n        self.socket=socket.create_connection(('127.0.0.1',port),timeout=3)\n        self.socket.settimeout(3); self.closed=False\n        self.socket.sendall(b'GET / HTTP/1.1\\r\\nHost: localhost\\r\\nUpgrade: websocket\\r\\n'\n            b'Connection: Upgrade\\r\\nSec-WebSocket-Version: 13\\r\\n'\n            b'Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\\r\\n'\n            b'Sec-WebSocket-Protocol: war.cbor.v1\\r\\n\\r\\n')\n        header=bytearray()\n        while not header.endswith(b'\\r\\n\\r\\n'):\n            header.extend(self.exact(1)); assert len(header)<16384\n        assert header.startswith(b'HTTP/1.1 101 ') and b'war.cbor.v1' in header\n        self.send(2,data(channel)); opcode,value=self.receive()\n        assert opcode==2 and value and value[0]>>5==0\n        self.id=value[0] if value[0]<24 else int.from_bytes(value[1:],'big')\n        assert uint(self.id)==value and self.id not in [0,2**64-1]\n        counts['joins']+=1; self.delivered(value)\n\n    def delivered(self,value):\n        counts['deliveries']+=1; counts['delivered_bytes']+=len(value)\n\n    def expect(self,value):\n        assert self.receive()==(2,value)\n        self.delivered(value)\n\n    def request(self,op,value,expected):\n        packet=reply(op,value); self.send(2,packet)\n        counts['messages']+=1; counts['incoming_bytes']+=len(packet)\n        self.expect(reply(200 if op==5 else op,expected))\n\n    def finish(self,watchers=()):\n        self.send(8,struct.pack('>H',1000))\n        a,b=self.exact(2); assert a==0x88 and b<126\n        assert self.exact(b)==struct.pack('>H',1000)\n        assert self.socket.recv(1)==b''\n        self.socket.close(); self.closed=True; counts['closes']+=1\n        for watcher in watchers:watcher.expect(b'\\x82'+uint(2**64-1)+uint(self.id))\n\ndef quiesce(sessions,variable_bytes):\n    deadline=time.monotonic()+3\n    expected={'war_accepted_total':counts['joins'],'war_joined_total':counts['joins'],\n        'war_disconnected_total':counts['closes'],'war_incoming_messages_total':counts['messages'],\n        'war_incoming_bytes_total':counts['incoming_bytes'],'war_deliveries_total':counts['deliveries'],\n        'war_delivered_bytes_total':counts['delivered_bytes'],'war_connections':sessions,\n        'war_sessions':sessions,'war_variable_bytes':variable_bytes,'war_queued_bytes':0}\n    while True:\n        metrics={k:int(v) for k,v in benchmark.metrics(admin).items()}\n        if all(metrics[k]==v for k,v in expected.items()):break\n        assert time.monotonic()<deadline,{k:(metrics[k],v) for k,v in expected.items() if metrics[k]!=v}\n        time.sleep(.01)\n    for key in ['war_protocol_errors_total','war_write_errors_total','war_close_failures_total',\n                'war_transport_disconnects_total','war_slow_consumers_total','war_global_pressure_total']:\n        assert metrics[key]==0,(key,metrics[key])\n    if sessions==0:assert metrics['war_read_buffer_reserved_bytes']==0\n    return metrics\n\nreport={'scope':'Server-only gperftools allocation diagnostic, not ordinary timing/RSS. Each probe executes64 verified operations between quiescent dumps. Boundary metrics sampling and heap-dump overhead remain in totals; use symbol stacks to distinguish control-path allocations. Warm64 sequential joins before measurement. All welcome IDs, replies, departure notifications, normal Close/EOF and exact server counters checked. Four server workers CPUs0-3, independent Python client/controller CPUs4-7.',\n    'server_command':command,'server_sha256':sha(args.server),'library':{'path':str(library),'sha256':sha(library)},\n    'driver_source':Path(__file__).read_text(),'driver_sha256':sha(__file__),\n    'websocket_helper':{'path':'scripts/reference.py','sha256':sha(root/'scripts/reference.py')},\n    'probes':[],'passed':False}\nwith tempfile.TemporaryFile() as logs:\n    server=subprocess.Popen(command,env=env,stdout=logs,stderr=logs)\n    try:\n        deadline=time.monotonic()+5\n        while True:\n            assert server.poll() is None\n            try:benchmark.metrics(admin);break\n            except OSError:\n                assert time.monotonic()<deadline;time.sleep(.02)\n        for _ in range(64):Client().finish()\n\n        def probe(name,operation,sessions,variable_bytes=0):\n            before_metrics=quiesce(sessions,variable_bytes);time.sleep(.05)\n            before=inspection.dump_heap(server.pid,prefix)\n            for i in range(64):operation(i)\n            after_metrics=quiesce(sessions,variable_bytes);time.sleep(.05)\n            after=inspection.dump_heap(server.pid,prefix)\n            report['probes'].append({'name':name,'operations':64,'before':before,'after':after,\n                'before_metrics':before_metrics,'after_metrics':after_metrics})\n\n        probe('reconnect',lambda _:Client().finish(),0)\n        peer=Client()\n        peer.request(0,data(b'control-heap'),b'\\xf5')\n        probe('authenticate',lambda _:peer.request(0,data(b'control-heap'),b'\\xf5'),1)\n        probe('listen',lambda i:peer.request(1,uint(i&7),uint(i&7)),1)\n        channels=b'\\x82\\x82'+data(b'control')+uint(1)+b'\\x82'+data(b're_globl')+uint(0)\n        probe('channels',lambda _:peer.request(2,b'\\xf6',channels),1)\n        probe('missing-variable',lambda _:peer.request(5,data(b'shared'),b'\\x82\\xf4\\xf6'),1)\n        value=data(bytes([0xa5])*32768);stored_bytes=len(b'shared')+len(value)\n        peer.request(4,b'\\x82'+data(b'shared')+value,b'\\xf5')\n        probe('set-variable',lambda _:peer.request(4,b'\\x82'+data(b'shared')+value,b'\\xf5'),1,stored_bytes)\n        probe('get-variable-32k',lambda _:peer.request(5,data(b'shared'),b'\\x82\\xf5'+value),1,stored_bytes)\n        second=Client()\n        def departure(_):Client().finish([peer,second])\n        probe('departure-two-readers',departure,2,stored_bytes)\n        second.finish([peer]);peer.finish()\n        report['final_metrics']=quiesce(0,0)\n        report['counts']=counts\n        server.send_signal(signal.SIGINT);assert server.wait(timeout=5)==0\n        report.update(passed=True,server_exit_code=server.returncode)\n    finally:\n        if server.poll() is None:\n            server.send_signal(signal.SIGINT);server.wait(timeout=5)\n        logs.seek(0);report['server_log']=logs.read().decode(errors='replace')\n        args.output.write_text(json.dumps(report,indent=2)+'\\n')\nprint(json.dumps({'passed':report['passed'],'probes':len(report['probes']),'counts':report.get('counts')}))\n",
