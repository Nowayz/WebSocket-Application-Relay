  "driver_source": "#!/usr/bin/env python3\nimport hashlib\nimport json\nfrom pathlib import Path\nimport statistics\nimport subprocess\nimport sys\n\nroot = Path(__file__).resolve().parents[1]\nsha = lambda path: hashlib.sha256(Path(path).read_bytes()).hexdigest()\nservers = {'before': root / 'artifacts/baselines/handshake-inline/war-relay',\n           'candidate': root / 'artifacts/baselines/counter-stripes/war-relay'}\nclient = root / 'artifacts/baselines/fanout-probe/inspection'\noutput = root / 'docs/benchmarks/2026-10-16-counter-stripes-study.json'\ncohorts = [('one-core', 1, 2, 0, '0'), ('two-pairs', 4, 2, 0, '0-3'),\n           ('eight-pairs', 4, 8, 0, '0-3'), ('fanout', 4, 1, 64, '0-3')]\nrecord = {'scope': '24 fresh sequential ordinary processes, three alternating pairs for four workloads. Four seconds of verified cyclic1KiB values/window16, 8192 idle rooms. Worker/CPU set and active pairs/fanout readers recorded per cohort. Every sender/body/FIFO, Close/EOF and exact counter/resource check is mandatory. No profiler, compilation or other load test overlaps timing. Server CPU per output is the per-run ratio over all timed verified deliveries. Finite plaintext loopback measurements, not saturated capacity or a language comparison.',\n          'base_revision': subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=root, text=True).strip(),\n          'variants': {role: {'path': str(path.relative_to(root)), 'sha256': sha(path)} for role, path in servers.items()},\n          'client': {'path': str(client.relative_to(root)), 'sha256': sha(client)},\n          'sources': {name: sha(root / name) for name in ('src/metrics.rs', 'src/metrics/counter.rs', 'src/relay.rs', 'src/server/socket.rs', 'scripts/inspection.py', 'scripts/benchmark.py')},\n          'driver_source': Path(__file__).read_text(), 'cases': [], 'passed': False}\nfor repetition in range(1, 4):\n    order = cohorts if repetition % 2 else list(reversed(cohorts))\n    for cohort, workers, pairs, readers, cpus in order:\n        for role in (['before', 'candidate'] if repetition % 2 else ['candidate', 'before']):\n            trace = output.with_name(f'{output.stem}-{cohort}-{role}-{repetition}.json')\n            command = [sys.executable, str(root / 'scripts/inspection.py'), '--server', str(servers[role]),\n                       '--client', str(client), '--mode', 'none', '--inspectors', '0', '--churn-workers', '0',\n                       '--rooms', '8192', '--seconds', '4', '--workers', str(workers), '--pairs', str(pairs),\n                       '--fanout-readers', str(readers), '--server-cpus', cpus, '--client-cpus', '4-7', '--output', str(trace)]\n            completed = subprocess.run(command, cwd=root, text=True, capture_output=True, timeout=90)\n            data = json.loads(trace.read_text())\n            assert completed.returncode == 0 and data['passed'], completed.stdout + completed.stderr\n            assert data['server_sha256'] == record['variants'][role]['sha256'] and data['client_sha256'] == record['client']['sha256']\n            assert not data['profile_diagnostic'] and not data['server_forced_kill']\n            assert data['server_exit_code'] == data['client_exit_code'] == 0\n            assert [e['event'] for e in data['events']] == ['ready', 'measured', 'done']\n            ready, measured = data['events'][:2]\n            count = measured['details']['counts']['deliveries'] - ready['details']['counts']['deliveries']\n            mixed = data['mixed']\n            row = {'cohort': cohort, 'workers': workers, 'pairs': pairs, 'fanout_readers': readers,\n                   'kind': role, 'repetition': repetition, 'passed': True,\n                   'trace': str(trace.relative_to(root)), 'sha256': sha(trace),\n                   'healthy': mixed['healthy']['per_second'], 'healthy_p99_ms': mixed['healthy']['p99_upper_ms'],\n                   'fanout': mixed['fanout']['per_second'], 'fanout_p99_ms': mixed['fanout']['p99_upper_ms'],\n                   'verified_outputs': count, 'cpu_ns_per_output': mixed['server_cpu_seconds'] / count * 1e9,\n                   'cpu_wall': mixed['server_cpu_seconds_per_wall_second'],\n                   'client_cpu_wall': mixed['client_cpu_seconds_per_wall_second'],\n                   'rss_mib': measured['process']['VmRSS'] / 1024}\n            record['cases'].append(row)\n            output.write_text(json.dumps(record, indent=2) + '\\n')\n            print(json.dumps(row), flush=True)\nrecord['medians'] = {}\nfor cohort, *_ in cohorts:\n    for role in servers:\n        rows = [r for r in record['cases'] if r['cohort'] == cohort and r['kind'] == role]\n        fields = ['healthy', 'healthy_p99_ms', 'fanout', 'fanout_p99_ms', 'cpu_ns_per_output', 'cpu_wall', 'client_cpu_wall', 'rss_mib']\n        summary = {field: statistics.median(r[field] for r in rows) for field in fields}\n        summary['ranges'] = {field: [min(r[field] for r in rows), max(r[field] for r in rows)] for field in fields}\n        record['medians'][cohort + '/' + role] = summary\nrecord['passed'] = True\noutput.write_text(json.dumps(record, indent=2) + '\\n')\nprint(json.dumps({'passed': True, 'medians': record['medians']}), flush=True)\n",
