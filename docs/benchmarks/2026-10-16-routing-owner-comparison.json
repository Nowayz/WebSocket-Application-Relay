  "driver_source": "import hashlib\nimport json\nfrom pathlib import Path\nimport statistics\nimport subprocess\nimport sys\n\nroot = Path(__file__).resolve().parents[1]\nsha = lambda p: hashlib.sha256(Path(p).read_bytes()).hexdigest()\ncandidate = json.loads((root/'artifacts/routing-owner-candidate.json').read_text())\nservers = {'prepage':root/'artifacts/baselines/response-buffer-candidate/war-relay',\n    'paging':root/'artifacts/baselines/paging-candidate/war-relay',\n    'selected':root/candidate['directory']/'war-relay'}\nclient = root/'artifacts/baselines/paging-candidate/inspection'\noutput = root/'docs/benchmarks/2026-10-16-routing-owner-comparison.json'\nrecord = {'scope':'27 sequential fresh processes; three repetitions rotate workload order and implementation order. Four server workers on CPUs0-3, one frozen client on CPUs4-7. Each 8-second case holds8192 idle rooms and one private pair, 1KiB values/window16. Private has no concurrent churn or inspection and includes pre-paging, paging and selected servers. Churn adds eight reconnect workers. Full adds 200 complete HTTP listings/s; page100 instead requests200 first100-row pages/s and verifies complete traversals at quiescent gates. Churn/full/page100 compare paging and selected only, returning equivalent results within each workload. Every payload/sender/FIFO, field/order/cursor, Close/EOF, exact counter and final resource check must pass. No builds, profilers or competing load tests overlap timing.',\n    'selected_source_hashes':candidate['sources'],'control_runtime_revisions':{'prepage':'dced6e163b23d96abf37d630d614439dac5322d4','paging':'2e7806b8e255527cc0dc3cc6ffc6813859f71426'},\n    'variants':{k:{'path':str(p.relative_to(root)),'sha256':sha(p)} for k,p in servers.items()},\n    'client':{'path':str(client.relative_to(root)),'sha256':sha(client),'source_path':'artifacts/baselines/paging-candidate/inspection.rs','source_sha256':sha(client.parent/'inspection.rs'),'runtime_revision':'2e7806b8e255527cc0dc3cc6ffc6813859f71426'},\n    'helpers':{name:sha(root/'scripts'/name) for name in ['inspection.py','benchmark.py']},'driver_source':Path(__file__).read_text(),'driver_sha256':sha(__file__),'cases':[],'passed':False}\nnames = ['private','churn','full','page100']\nfor repetition in range(1,4):\n    offset = (repetition-1)%len(names)\n    for workload in names[offset:]+names[:offset]:\n        roles = ['prepage','paging','selected'] if workload=='private' else ['paging','selected']\n        shift = (repetition-1)%len(roles)\n        roles = roles[shift:]+roles[:shift]\n        for role in roles:\n            trace = output.with_name(f'{output.stem}-{workload}-{role}-{repetition}.json')\n            command = [sys.executable,str(root/'scripts/inspection.py'),'--server',str(servers[role]),'--client',str(client),\n                '--pairs','1','--seconds','8','--mode','http' if workload in ['full','page100'] else 'none',\n                '--churn-workers','0' if workload=='private' else '8','--output',str(trace)]\n            if workload=='page100':command += ['--page-size','100']\n            done = subprocess.run(command,cwd=root,capture_output=True,text=True,timeout=120)\n            data = json.loads(trace.read_text())\n            assert done.returncode==0 and data['passed'],done.stdout+done.stderr\n            assert not data['profile_diagnostic'] and data['server_sha256']==record['variants'][role]['sha256']\n            assert data['client_sha256']==record['client']['sha256'] and data['client_source_sha256']==record['client']['source_sha256']\n            assert data['runner_sha256']==record['helpers']['inspection.py']\n            mixed=data['mixed'];row={'kind':role,'workload':workload,'repetition':repetition,'trace':str(trace.relative_to(root)),\n                'trace_sha256':sha(trace),'passed':True,'healthy':mixed['healthy']['per_second'],'healthy_p99_ms':mixed['healthy']['p99_upper_ms'],\n                'churn':mixed['churn']['per_second'],'churn_p99_ms':mixed['churn']['p99_upper_ms'],'inspection':mixed['inspection']['per_second'],\n                'inspection_p99_ms':mixed['inspection']['p99_upper_ms'],'cpu_wall':mixed['server_cpu_seconds_per_wall_second'],\n                'rss_mib':data['events'][1]['process']['VmRSS']/1024}\n            record['cases'].append(row);output.write_text(json.dumps(record,indent=2)+'\\n');print(json.dumps(row),flush=True)\nrecord['medians']={}\nfor workload in names:\n    for role in servers:\n        rows=[r for r in record['cases'] if r['kind']==role and r['workload']==workload]\n        if not rows:continue\n        keys=['healthy','healthy_p99_ms','churn','churn_p99_ms','inspection','inspection_p99_ms','cpu_wall','rss_mib']\n        summary={key:statistics.median(r[key] for r in rows) for key in keys}\n        summary['ranges']={key:[min(r[key] for r in rows),max(r[key] for r in rows)] for key in ['healthy','churn','cpu_wall']}\n        record['medians'][workload+'/'+role]=summary\nrecord['passed']=True;output.write_text(json.dumps(record,indent=2)+'\\n');print(json.dumps(record['medians']),flush=True)\n",
