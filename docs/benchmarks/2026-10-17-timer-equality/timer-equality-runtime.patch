     pub fn set(&mut self, slot: usize, deadline: Option<Instant>) {
+        // Ordinary traffic often leaves the next heartbeat deadline unchanged.
+        // Keep that live entry in place instead of repairing the same heap key.
+        if let Some(deadline) = deadline
+            && let Some(&index) = self.positions.get(slot)
+            && index != usize::MAX
+            && self.heap[index].0 == deadline
+        {
+            return;
+        }
         if self.positions.len() <= slot {
             self.positions.resize(slot + 1, usize::MAX);
         }
