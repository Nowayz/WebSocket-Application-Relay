+            }
+            1 => &mut census.writable,
+            2 => &mut census.wake,
+            _ => unreachable!(),
+        };
+        row.calls += 1;
+        match result {
+            Ok(()) => row.successes += 1,
+            Err(error) if error.kind() == io::ErrorKind::Interrupted => row.interrupted += 1,
+            Err(_) => row.errors += 1,
+        }
+    });
+}
 
