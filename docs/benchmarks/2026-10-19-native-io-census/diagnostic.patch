+fn census_io(kind: usize, requested: usize, result: &io::Result<usize>) {
+    IO_CENSUS.with(|census| {
+        let mut census = census.borrow_mut();
+        let phase = IO_PHASE.load(std::sync::atomic::Ordering::Acquire);
+        let row = &mut census.phases[phase].io[kind];
+        row.calls += 1; row.requested_bytes += requested as u64;
+        row.max_request = row.max_request.max(requested);
+        match result {
+            Ok(bytes) => {
+                row.successes += 1; row.bytes += *bytes as u64;
+                row.max_result = row.max_result.max(*bytes);
+                row.zero += u64::from(*bytes == 0);
+                row.short += u64::from(*bytes != 0 && *bytes < requested);
+            }
+            Err(error) if error.kind() == io::ErrorKind::WouldBlock => row.again += 1,
+            Err(error) if error.kind() == io::ErrorKind::Interrupted => row.interrupted += 1,
+            Err(_) => row.errors += 1,
+        }
+    });
+}
+pub(super) fn census_unit(kind: usize, result: &io::Result<()>, events: usize, nonblocking: bool) {
