+pub(super) static IO_PHASE: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+thread_local! {
+    static IO_CENSUS: std::cell::RefCell<IoCensus> = std::cell::RefCell::new(IoCensus::default());
+}
+impl Drop for IoCensus {
+    fn drop(&mut self) {
