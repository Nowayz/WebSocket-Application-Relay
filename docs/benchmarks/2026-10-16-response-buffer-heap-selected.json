    "driver_source": "\"\"\"Isolated server allocation diagnostic for verified HTTP channel listings.\"\"\"\nimport argparse\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport signal\nimport subprocess\nimport sys\nimport time\nfrom types import SimpleNamespace\nimport urllib.request\n\nroot = Path(__file__).resolve().parents[1]\nsys.path.insert(0, str(root / 'scripts'))\nimport inspection\n\nparser = argparse.ArgumentParser()\nparser.add_argument('--server', type=Path, required=True)\nparser.add_argument('--output', type=Path, required=True)\nparser.add_argument('--prefix', type=Path, required=True)\nargs = parser.parse_args()\nprefix = args.prefix.resolve()\nprefix.parent.mkdir(parents=True, exist_ok=True)\nassert not list(prefix.parent.glob(prefix.name + '*.heap'))\nsha = lambda p: hashlib.sha256(Path(p).read_bytes()).hexdigest()\nlibrary = Path('/usr/lib/libtcmalloc.so').resolve()\nenvironment = {'LD_PRELOAD': str(library), 'HEAPPROFILE': str(prefix),\n               'HEAPPROFILESIGNAL': str(signal.SIGUSR2),\n               'HEAP_PROFILE_ALLOCATION_INTERVAL': str(100 * 1024**3),\n               'HEAP_PROFILE_INUSE_INTERVAL': str(100 * 1024**3)}\noriginal_popen, original_snapshot = subprocess.Popen, inspection.runtime.snapshot\nserver_pid = admin = None\nprobe = {}\n\ndef launch(command, *positional, **kwargs):\n    global server_pid, admin\n    server = str(args.server.resolve()) in command\n    if server:\n        kwargs['env'] = {**kwargs['env'], **environment}\n        admin = command[command.index('--admin-bind') + 1]\n    process = original_popen(command, *positional, **kwargs)\n    if server:\n        server_pid = process.pid\n    return process\n\ndef query():\n    request = urllib.request.Request(f'http://{admin}/v1/channels',\n        headers={'Authorization': 'Bearer ' + inspection.TOKEN, 'Connection': 'close'})\n    with urllib.request.urlopen(request, timeout=5) as response:\n        assert response.status == 200\n        assert response.headers.get_content_type() == 'application/json'\n        return response.read()\n\ndef snapshot(pid):\n    result = original_snapshot(pid)\n    assert pid == server_pid\n    if not probe:\n        # The frozen client has independently checked every expected row at its\n        # ready gate and is blocked on stdin throughout these requests.\n        body = query()\n        rows = json.loads(body)\n        assert len(rows) == 8194\n        assert [r['name_base64'] for r in rows] == sorted(r['name_base64'] for r in rows)\n        for row in rows:\n            assert list(row) == ['name', 'name_base64', 'members', 'variables', 'variable_bytes']\n        time.sleep(.1)\n        before = inspection.dump_heap(pid, prefix)\n        for _ in range(20):\n            assert query() == body\n        time.sleep(.1)\n        after = inspection.dump_heap(pid, prefix)\n        probe.update(requests=20, rows=len(rows), response_bytes=len(body),\n                     response_sha256=hashlib.sha256(body).hexdigest(),\n                     before=before, after=after)\n    return result\n\ncase = SimpleNamespace(server=args.server, client=root/'artifacts/baselines/e2d7cf9/inspection',\n    mode='http', rooms=8192, seconds=1, inspectors=1, inspection_interval_ms=10,\n    pairs=1, churn_workers=0, read_storage='worker', server_cpus='0-3', client_cpus='4-7',\n    profile=False, heap_profile=None, heap_library=library, output=args.output)\ntry:\n    subprocess.Popen, inspection.runtime.snapshot = launch, snapshot\n    result = inspection.run(case)\nfinally:\n    subprocess.Popen, inspection.runtime.snapshot = original_popen, original_snapshot\nresult['profile_diagnostic'] = True\nresult['allocation_probe'] = probe\nresult['heap_profiler'] = {'scope': 'Server-only gperftools; 20 requests at the paused ready gate. All frozen client full-payload/FIFO/listing/Close/EOF/counter/resource checks retained. Diagnostic time and RSS excluded from ordinary comparisons.',\n    'library': str(library), 'library_sha256': sha(library), 'environment': environment,\n    'driver_source': Path(__file__).read_text(), 'driver_sha256': sha(__file__),\n    'base_runner_sha256': sha(root/'scripts/inspection.py')}\nargs.output.write_text(json.dumps(result, indent=2)+'\\n')\nprint(json.dumps({'passed':result['passed'], 'probe':probe, 'error':result.get('error')}))\nassert result['passed'] and probe, result.get('error')\n",
