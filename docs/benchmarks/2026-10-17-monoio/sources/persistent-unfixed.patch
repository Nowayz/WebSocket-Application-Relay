+//! Experimental Monoio io_uring readiness driver. Persistent watcher tasks
+//! avoid allocating an erased future, unordered-stream node and cancellation
+//! handle on every readiness rearm. Payloads still use worker scratch and sendmsg.
+use super::*;
+use futures_util::{FutureExt, Stream, StreamExt};
+use monoio::task::JoinHandle;
+use std::{
+    cell::{Cell, RefCell},
+    future::poll_fn,
+    pin::Pin,
+    rc::Rc,
+    task::{Context as TaskContext, Poll as TaskPoll, Waker},
+};
+
+pub(super) fn run(worker: Worker) -> Result<()> {
+    monoio::RuntimeBuilder::<monoio::IoUringDriver>::new()
+        .enable_timer()
+        .build()
+        .context("cannot create Monoio io_uring worker")?
+        .block_on(run_worker(worker))
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Direction {
+    Read,
+    Write,
+}
+type Completion = Option<(Token, Direction, u64, io::Result<()>)>;
+
+#[derive(Default)]
+struct Gate {
+    read: Cell<bool>,
+    write: Cell<bool>,
+    stopped: Cell<bool>,
+    version: Cell<u64>,
+    waker: RefCell<Option<Waker>>,
+}
+impl Gate {
+    fn set(&self, read: bool, write: bool) {
+        if self.read.replace(read) != read || self.write.get() != write {
+            self.write.set(write);
+            self.version.set(self.version.get().wrapping_add(1));
+            if let Some(waker) = self.waker.borrow().as_ref() {
+                waker.wake_by_ref();
+            }
+        }
+    }
+    fn stop(&self) {
+        self.stopped.set(true);
+        if let Some(waker) = self.waker.borrow().as_ref() {
+            waker.wake_by_ref();
+        }
+    }
+    async fn changed(&self, version: u64) {
+        poll_fn(|cx| {
+            let mut waker = self.waker.borrow_mut();
+            if let Some(waker) = waker.as_mut() {
+                waker.clone_from(cx.waker());
+            } else {
+                *waker = Some(cx.waker().clone());
+            }
+            if self.stopped.get() || self.version.get() != version {
+                TaskPoll::Ready(())
+            } else {
+                TaskPoll::Pending
+            }
+        })
+        .await
+    }
+}
+#[derive(Default)]
+struct Queue {
+    pending: RefCell<VecDeque<Completion>>,
+    waker: RefCell<Option<Waker>>,
+}
+impl Queue {
+    fn push(&self, item: Completion) {
+        self.pending.borrow_mut().push_back(item);
+        if let Some(waker) = self.waker.borrow().as_ref() {
+            waker.wake_by_ref();
+        }
+    }
+}
+struct Events(Rc<Queue>);
+impl Stream for Events {
+    type Item = Completion;
+    fn poll_next(self: Pin<&mut Self>, cx: &mut TaskContext<'_>) -> TaskPoll<Option<Completion>> {
+        if let Some(item) = self.0.pending.borrow_mut().pop_front() {
+            return TaskPoll::Ready(Some(item));
+        }
+        let mut waker = self.0.waker.borrow_mut();
+        if let Some(waker) = waker.as_mut() {
+            waker.clone_from(cx.waker());
+        } else {
+            *waker = Some(cx.waker().clone());
+        }
+        TaskPoll::Pending
+    }
+}
+enum Source {
+    Listener(monoio::net::TcpListener),
+    Socket(monoio::net::TcpStream),
+}
+impl Source {
+    async fn ready(&self, direction: Direction) -> io::Result<()> {
+        match (self, direction) {
+            (Self::Listener(listener), _) => listener.readable(false).await,
+            (Self::Socket(stream), Direction::Read) => stream.readable(false).await,
+            (Self::Socket(stream), Direction::Write) => stream.writable(false).await,
+        }
+    }
+}
+struct Watch {
+    gate: Rc<Gate>,
+    task: Option<JoinHandle<()>>,
+}
+impl Watch {
+    fn new(source: Source, token: Token, queue: Rc<Queue>) -> Self {
+        let gate = Rc::new(Gate::default());
+        gate.read.set(true);
+        let control = gate.clone();
+        let task = monoio::spawn(async move {
+            loop {
+                if control.stopped.get() {
+                    return;
+                }
+                let version = control.version.get();
+                tokio::select! {
+                    result = source.ready(Direction::Read), if control.read.get() => {
+                        control.read.set(false);
+                        queue.push(Some((token, Direction::Read, 0, result)));
+                    }
+                    result = source.ready(Direction::Write), if control.write.get() => {
+                        control.write.set(false);
+                        queue.push(Some((token, Direction::Write, 0, result)));
+                    }
+                    _ = control.changed(version) => {}
+                }
+            }
+        });
+        Self {
+            gate,
+            task: Some(task),
+        }
+    }
+}
+impl Drop for Watch {
+    fn drop(&mut self) {
+        self.gate.stop();
+    }
+}
+struct Driver {
+    listener: Watch,
+    watches: HashMap<Token, Watch>,
+    waits: Events,
+    retired: Vec<JoinHandle<()>>,
+}
+impl Driver {
+    fn new(listener: std::net::TcpListener) -> io::Result<Self> {
+        let queue = Rc::new(Queue::default());
+        let listener = Watch::new(
+            Source::Listener(monoio::net::TcpListener::from_std(listener)?),
+            LISTENER,
+            queue.clone(),
+        );
+        Ok(Self {
+            listener,
+            watches: HashMap::new(),
+            waits: Events(queue),
+            retired: Vec::new(),
+        })
+    }
+    fn sync(&mut self, worker: &mut Worker, stopping: bool) -> Result<()> {
+        self.listener
+            .gate
+            .set(!stopping && worker.accept_retry.is_none(), false);
+        for (token, stream) in worker.monoio_new.drain(..) {
+            if worker.tokens.contains_key(&token) {
+                let source = Source::Socket(monoio::net::TcpStream::from_std(stream)?);
+                self.watches
+                    .insert(token, Watch::new(source, token, self.waits.0.clone()));
+            }
+        }
+        for token in worker.monoio_dirty.drain(..) {
+            let Some(&slot) = worker.tokens.get(&token) else {
+                if let Some(mut watch) = self.watches.remove(&token) {
+                    watch.gate.stop();
+                    self.retired.push(watch.task.take().expect("watch task"));
+                }
+                continue;
+            };
+            if let Some(watch) = self.watches.get(&token) {
+                watch
+                    .gate
+                    .set(true, worker.connections[slot].socket.state.lock().writable);
+            }
+        }
+        self.retired.retain(|task| !task.is_finished());
+        if self.retired.capacity() > 256 && self.retired.len() <= self.retired.capacity() / 8 {
+            self.retired.shrink_to(self.retired.len() * 2);
+        }
+        if self.watches.capacity() > 256 && self.watches.len() <= self.watches.capacity() / 8 {
+            self.watches.shrink_to(self.watches.len() * 2);
+        }
+        Ok(())
+    }
+    fn complete(&mut self, worker: &mut Worker, result: Completion, stopping: bool) -> Result<()> {
+        let Some((token, _, _, result)) = result else {
+            return Ok(());
+        };
+        if token == LISTENER {
+            result.context("Monoio listener readiness failed")?;
+            if !stopping && worker.accept_retry.is_none() {
+                worker.schedule_accept();
+            }
+        } else if self.watches.contains_key(&token) {
+            if result.is_err()
+                && let Some(&slot) = worker.tokens.get(&token)
+            {
+                worker.connections[slot].socket.state.lock().fatal = true;
+            }
+            worker.schedule(token);
+        }
+        Ok(())
+    }
+    async fn shutdown(&mut self) {
+        self.listener.gate.stop();
+        for (_, mut watch) in self.watches.drain() {
+            watch.gate.stop();
+            self.retired.push(watch.task.take().expect("watch task"));
+        }
+        if let Some(task) = self.listener.task.take() {
+            self.retired.push(task);
+        }
+        for task in self.retired.drain(..) {
+            task.await;
+        }
+    }
+}
+
+async fn yield_once() {
+    let mut yielded = false;
+    poll_fn(|cx| {
+        if yielded {
+            TaskPoll::Ready(())
+        } else {
+            yielded = true;
+            cx.waker().wake_by_ref();
+            TaskPoll::Pending
+        }
+    })
+    .await
+}
+
+async fn run_worker(mut worker: Worker) -> Result<()> {
+    let mut driver = Driver::new(worker.monoio_listener.take().expect("Monoio listener"))?;
+    let relay = worker.relay.clone();
+    let mut incoming = relay.receive_batch();
+    let mut shutdown_deadline = None;
+    loop {
+        if worker.signal.stopping.load(Acquire) && shutdown_deadline.is_none() {
+            shutdown_deadline =
+                Some(Instant::now() + Duration::from_secs(relay.config.shutdown_timeout_secs));
+            for (_, connection) in worker.connections.iter_mut() {
+                if !connection.scheduled {
+                    connection.scheduled = true;
+                    worker.ready.push_back(connection.token);
+                }
+            }
+        }
+        let stopping = shutdown_deadline.is_some();
+        if shutdown_deadline.is_some_and(|d| d <= Instant::now())
+            || (stopping && worker.connections.is_empty())
+        {
+            break;
+        }
+        let now = Instant::now();
+        if !stopping && worker.accept_retry.is_some_and(|d| d <= now) {
+            worker.accept_retry = None;
+            worker.accept()?;
+        }
+        while let Some(slot) = worker.timers.pop_due(now) {
+            if let Some(connection) = worker.connections.get(slot) {
+                worker.schedule(connection.token);
+            }
+        }
+        worker.drive_ready(stopping, &mut incoming)?;
+        incoming.publish();
+        {
+            let mut pending = worker.signal.pending.lock();
+            while let Some(token) = pending.pop_front() {
+                let Some(&slot) = worker.tokens.get(&token) else {
+                    continue;
+                };
+                if let Some(connection) = worker.connections.get_mut(slot)
+                    && connection.token == token
+                    && !connection.scheduled
+                {
+                    connection.scheduled = true;
+                    worker.ready.push_back(token);
+                }
+            }
+        }
+        driver.sync(&mut worker, stopping)?;
+        if stopping && worker.connections.is_empty() {
+            break;
+        }
+        // Consume a bounded completion batch before an existing ready
+        // continuation. No full-population scans occur in the active path.
+        for _ in 0..1024 {
+            let Some(Some(result)) = driver.waits.next().now_or_never() else {
+                break;
+            };
+            driver.complete(&mut worker, result, stopping)?;
+        }
+        if !worker.ready.is_empty() {
+            yield_once().await;
+            continue;
+        }
+        let mut deadline = worker.timers.next();
+        for next in [shutdown_deadline, worker.accept_retry]
+            .into_iter()
+            .flatten()
+        {
+            deadline = Some(deadline.map_or(next, |previous| previous.min(next)));
+        }
+        let timer = async {
+            if let Some(deadline) = deadline {
+                monoio::time::sleep(deadline.saturating_duration_since(Instant::now())).await;
+            } else {
+                std::future::pending::<()>().await;
+            }
+        };
+        let signal = worker.signal.clone();
+        let notified = poll_fn(|cx| {
+            signal
+                .monoio
+                .as_ref()
+                .expect("Monoio waker")
+                .register(cx.waker());
+            if (!stopping && signal.stopping.load(Acquire)) || !signal.pending.lock().is_empty() {
+                TaskPoll::Ready(())
+            } else {
+                TaskPoll::Pending
+            }
+        });
+        tokio::select! {
+            result = driver.waits.next() => {
+                if let Some(result) = result { driver.complete(&mut worker, result, stopping)?; }
+            }
+            _ = notified => {}
+            _ = timer => {}
+        }
+    }
+    // Stop watcher tasks before leaving the runtime. Dropped in-flight PollAdd
+    // operations are cancelled and Monoio retires their CQEs before ring drop.
+    driver.shutdown().await;
+    Ok(())
+}
