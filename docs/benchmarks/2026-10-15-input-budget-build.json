  "resource_runner_source": "from pathlib import Path\nimport importlib.util,json,hashlib,platform,statistics\nroot=Path('/home/phil/dev/war_next')\ndef module(name):\n s=importlib.util.spec_from_file_location(name,root/'scripts'/f'{name}.py'); m=importlib.util.module_from_spec(s);s.loader.exec_module(m);return m\nbenchmark=module('benchmark');stability=module('stability')\ncandidates={'control':root/'artifacts/baselines/bf8d2e9/war-relay','admitted':root/'artifacts/candidates/input-budget-read-ahead/war-relay'}\nrecord={'host':platform.platform(),'notes':'Three alternating pairs of fresh four-worker servers per workload. Idle: identical existing load client, 2000 joined sockets, 4 KiB initial reads, rates/heartbeats off; memory sampled at client ready before its two-second hold ends. Idle final native cleanup is not sampled by benchmark.trial. Churn: fixed fed6fff stress binary, 64 workers for 10 seconds, server CPUs 0-3 and client 4-7, rates off, heartbeat on; every lifecycle routes and verifies its application echo before departure. Churn CPU includes setup/teardown. All native final gauges including staging must release. Workloads are sequential, with no concurrent compilation or stress. This does not establish production capacity.', 'servers':{k:{'path':str(v),'sha256':hashlib.sha256(v.read_bytes()).hexdigest()} for k,v in candidates.items()},'load_sha256':hashlib.sha256(benchmark.LOAD.read_bytes()).hexdigest(),'stress_sha256':hashlib.sha256((root/'artifacts/baselines/fed6fff/stress').read_bytes()).hexdigest(),'idle':[],'churn':[]}\np=root/'docs/benchmarks/2026-10-15-input-budget-resources.json'\nfor mode in ['idle','churn']:\n for repetition in range(3):\n  order=list(candidates) if repetition%2==0 else list(reversed(candidates))\n  for label in order:\n   if mode=='idle':\n    benchmark.SERVER=candidates[label]\n    c=benchmark.trial(4096,'idle',2000)\n    assert int(c['metrics']['war_sessions'])==2000\n    if label=='admitted':\n     assert int(c['metrics']['war_read_buffer_reserved_bytes'])==2000*8192\n     assert int(c['metrics']['war_read_buffer_reservations_rejected_total'])==0\n   else:\n    c=stability.run_case('churn',10,64,server_binary=candidates[label],stress_binary=root/'artifacts/baselines/fed6fff/stress',server_cpus='0-3',client_cpus='4-7')\n    assert c['passed']\n    f=c['final']['metrics'];assert int(f.get('war_read_buffer_reserved_bytes',0))==0\n    for k in ['war_protocol_errors_total','war_write_errors_total','war_write_timeouts_total','war_close_failures_total','war_handshake_errors_total','war_transport_disconnects_total','war_read_buffer_reservations_rejected_total']:\n     assert int(f.get(k,0))==0,(k,f)\n   c['candidate']=label;c['repetition']=repetition;record[mode].append(c)\n   p.write_text(json.dumps(record,indent=2)+'\\n')\n   print(json.dumps({'mode':mode,'candidate':label,'repetition':repetition,'rss_delta_kib':c.get('server_rss_delta_kib')}),flush=True)\nprint('Resource comparison passed',flush=True)\n",
