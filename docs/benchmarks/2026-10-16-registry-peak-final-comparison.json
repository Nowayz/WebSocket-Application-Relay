  "comparison_source": "import datetime,hashlib,json,statistics,subprocess\nfrom pathlib import Path\nroot=Path('/home/phil/dev/war_next'); sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()\nservers={'control':root/'artifacts/baselines/241a172/war-relay','trimmed':root/'artifacts/candidates/registry-retirement/war-relay'}\nclient=root/'artifacts/baselines/241a172/registry_peak'; cases=[]\noutput=root/'docs/benchmarks/2026-10-16-registry-peak-final-comparison.json'\nrecord={'timestamp_utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),'base_revision':subprocess.check_output(['git','rev-parse','HEAD'],cwd=root,text=True).strip(),'servers_sha256':{k:sha(p) for k,p in servers.items()},'client_sha256':sha(client),'runner_sha256':sha(root/'scripts/registry-peak.py'),'client_source_sha256':sha(root/'examples/registry_peak.rs'),'comparison_source':Path(__file__).read_text(),'notes':'Three repetitions per build, order reversed on the second. Sequential four-worker relays on CPUs 0-3 and the same frozen client on CPUs 4-7. Two retained global sessions, three waves of 8192 transient peers in distinct rooms, three seconds of verified traffic before any wave and after each. Timed routing excludes filling/draining; their native CPU cost is recorded separately. Post-wave medians are first taken per process, then across process medians. No profiled timing is included.','cases':cases}\nfor repetition in range(1,4):\n for label in (['control','trimmed'] if repetition!=2 else ['trimmed','control']):\n  trace=root/f'docs/benchmarks/2026-10-16-registry-peak-final-{label}-{repetition}.json'\n  command=['python3','scripts/registry-peak.py','--server',str(servers[label]),'--client',str(client),'--peak-clients','8192','--waves','3','--seconds','3','--output',str(trace)]\n  with open(root/f'artifacts/registry-peak-final-{label}-{repetition}.log','w') as log:\n   process=subprocess.run(command,stdout=log,stderr=subprocess.STDOUT,cwd=root)\n  data=json.loads(trace.read_text()); assert process.returncode==0 and data['passed'],data.get('error')\n  assert data['server_sha256']==record['servers_sha256'][label] and data['client_sha256']==record['client_sha256']\n  traffic=data['traffic']; events=data['events']\n  def event(kind,wave): return next(e for e in events if e['event']==kind and e['wave']==wave)\n  joins=[event('population_ready',w)['process']['cpu_seconds']-event('traffic_done',w-1)['process']['cpu_seconds'] for w in range(1,4)]\n  closes=[event('traffic_ready',w)['process']['cpu_seconds']-event('population_ready',w)['process']['cpu_seconds'] for w in range(1,4)]\n  row={'label':label,'repetition':repetition,'command':command,'trace':str(trace.relative_to(root)),'trace_sha256':sha(trace),'passed':True,'fresh':traffic[0],'post_wave_median_deliveries_per_second':statistics.median(t['deliveries_per_second'] for t in traffic[1:]),'post_wave_median_server_ns_per_delivery':statistics.median(t['server_ns_per_delivery'] for t in traffic[1:]),'post_wave_median_p99_upper_ms':statistics.median(t['p99_upper_ms'] for t in traffic[1:]),'join_cpu_seconds':joins,'close_cpu_seconds':closes,'verified_deliveries':sum(t['verified'] for t in traffic),'normal_closes':data['events'][-1]['details']['normal_closes']}\n  cases.append(row);output.write_text(json.dumps(record,indent=2)+'\\n');print(json.dumps({k:row[k] for k in ['label','repetition','post_wave_median_deliveries_per_second','post_wave_median_server_ns_per_delivery','passed']}),flush=True)\nrecord['medians']={}\nfor label in servers:\n rows=[r for r in cases if r['label']==label]\n record['medians'][label]={'fresh_verified_per_second':statistics.median(r['fresh']['deliveries_per_second'] for r in rows),'fresh_server_ns_per_delivery':statistics.median(r['fresh']['server_ns_per_delivery'] for r in rows),'post_wave_verified_per_second':statistics.median(r['post_wave_median_deliveries_per_second'] for r in rows),'post_wave_server_ns_per_delivery':statistics.median(r['post_wave_median_server_ns_per_delivery'] for r in rows),'post_wave_p99_upper_ms':statistics.median(r['post_wave_median_p99_upper_ms'] for r in rows),'median_wave_join_cpu_seconds':statistics.median(v for r in rows for v in r['join_cpu_seconds']),'median_wave_close_cpu_seconds':statistics.median(v for r in rows for v in r['close_cpu_seconds'])}\nrecord.update(passed=True,total_verified_deliveries=sum(r['verified_deliveries'] for r in cases),total_normal_closes=sum(r['normal_closes'] for r in cases))\noutput.write_text(json.dumps(record,indent=2)+'\\n'); print(json.dumps(record['medians']),flush=True)\n",
