+fn exact_latency_report(values: &mut [u64]) -> serde_json::Value {
+    values.sort_unstable();
+    let percentile = |p: usize| {
+        if values.is_empty() {
+            0.0
+        } else {
+            values[(values.len() * p).div_ceil(100) - 1] as f64 / 1e6
+        }
+    };
+    serde_json::json!({"samples":values.len(),"p50_ms":percentile(50),
+        "p95_ms":percentile(95),"p99_ms":percentile(99),"max_ms":percentile(100)})
+}
