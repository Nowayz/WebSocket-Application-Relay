{
  "scope": "Twelve fresh local processes verify native one/four-worker and bridge listening queues using Linux ss. Default1024, CLI173, environment37 and65535 requested with the read-only host somaxconn clamp. No host limits or sysctls change. No connections or message load required. All processes must stop normally.",
  "driver_source": "import hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport signal\nimport subprocess\nimport sys\nimport tempfile\nimport time\n\nroot = Path(__file__).resolve().parents[1]\nsys.path.insert(0, str(root / 'scripts'))\nimport benchmark\nimport importlib.util\nspec = importlib.util.spec_from_file_location('admission_flood', root / 'scripts/admission-flood.py')\nprobe = importlib.util.module_from_spec(spec); spec.loader.exec_module(probe)\nmeta = json.loads((root / 'artifacts/accept-backlog-candidate.json').read_text())\noutput = root / 'docs/benchmarks/2026-10-16-accept-backlog-settings.json'\nrecord = {'scope': 'Twelve fresh local processes verify native one/four-worker and bridge listening queues using Linux ss. Default1024, CLI173, environment37 and65535 requested with the read-only host somaxconn clamp. No host limits or sysctls change. No connections or message load required. All processes must stop normally.',\n          'driver_source': Path(__file__).read_text(), 'cases': [], 'passed': False}\nlimit = int(Path('/proc/sys/net/core/somaxconn').read_text())\nfor role, workers in [('native', 1), ('native', 4), ('bridge', 1)]:\n    name = 'war-relay' if role == 'native' else 'war-legacy-bridge'\n    binary = root / meta['directory'] / name\n    for mode, backlog in [('default', 1024), ('cli', 173), ('env', 37), ('clamped', 65535)]:\n        port = benchmark.free_port()\n        command = [str(binary), '--bind', f'127.0.0.1:{port}']\n        if role == 'native': command += ['--workers', str(workers), '--no-admin']\n        if mode in ['cli', 'clamped']: command += ['--listen-backlog', str(backlog)]\n        env = {k: v for k, v in os.environ.items() if not k.startswith('WAR_')}\n        if mode == 'env': env['WAR_LISTEN_BACKLOG'] = str(backlog)\n        row = {'role': role, 'workers': workers, 'mode': mode, 'requested': backlog, 'os_limit': limit,\n               'command': command, 'sha256': hashlib.sha256(binary.read_bytes()).hexdigest()}\n        with tempfile.TemporaryFile() as log:\n            process = subprocess.Popen(command, env=env, stdout=log, stderr=log)\n            try:\n                deadline = time.monotonic() + 5\n                while True:\n                    assert process.poll() is None\n                    queues = probe.listeners(port)\n                    if len(queues) == workers and all(q['backlog'] == min(backlog, limit) for q in queues): break\n                    assert time.monotonic() < deadline, queues\n                    time.sleep(.01)\n                row['queues'] = queues\n            finally:\n                process.send_signal(signal.SIGTERM)\n                row['exit_code'] = process.wait(timeout=5)\n            log.seek(0); row['log'] = log.read().decode(errors='replace')\n        assert row['exit_code'] == 0\n        row['passed'] = True\n        record['cases'].append(row)\n        output.write_text(json.dumps(record, indent=2) + '\\n')\n        print(json.dumps({k: row[k] for k in ['role', 'workers', 'mode', 'requested', 'exit_code']}), flush=True)\nrecord['passed'] = True\noutput.write_text(json.dumps(record, indent=2) + '\\n')\n",
