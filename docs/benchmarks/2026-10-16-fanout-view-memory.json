  "collector_source": "import hashlib,json,re\nfrom pathlib import Path\nroot=Path(__file__).resolve().parents[1];bench=root/'docs/benchmarks';sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()\nrecord={'scope':'Four separate one-worker diagnostics replace the server allocator with gperftools; each uses the same frozen client and normal complete byte/counter/cleanup verification. Requested live allocation sizes/counts, not RSS or production heap bounds. Idle:8192 separate rooms plus one private pair. Active:512 broadcast readers plus source and one private pair. No reconnects, one second of traffic; data mix/rate changes, so raw cumulative allocation totals are retained but are not per-message before/after costs. Diagnostics excluded from ordinary timings.','roles':{},'captures':[],'passed':False}\nfor role in ['before','selected']:\n for mode in ['idle','active']:\n  path=bench/f'2026-10-16-fanout-view-heap-{role}-{mode}.json';d=json.loads(path.read_text());assert d['passed'] and d['profile_diagnostic'] and d['server_exit_code']==d['client_exit_code']==0\n  record['roles'][f'{role}/{mode}']={'trace':str(path.relative_to(root)),'sha256':sha(path),'phases':{}}\n  for e in d['events']:\n   h=e['heap'];p=Path(h['path']);assert sha(p)==h['sha256']\n   m=re.match(r'heap profile:\\s+(\\d+):\\s+(\\d+)\\s+\\[\\s*(\\d+):\\s*(\\d+)\\]',h['header']);assert m\n   values=dict(zip(['live_objects','live_bytes','cumulative_objects','cumulative_bytes'],map(int,m.groups())))\n   record['roles'][f'{role}/{mode}']['phases'][e['event']]=values\n   record['captures'].append({'role':role,'mode':mode,'event':e['event'],'path':str(p.relative_to(root)),'sha256':h['sha256'],'header':h['header'],'metrics':e['metrics'],'counts':e['details']['counts']})\nrecord['deltas']={mode:{phase:{field:record['roles'][f'selected/{mode}']['phases'][phase][field]-record['roles'][f'before/{mode}']['phases'][phase][field] for field in ['live_objects','live_bytes']} for phase in ['ready','measured','done']} for mode in ['idle','active']}\na=record['roles']['selected/active']['phases'];b=record['roles']['before/active']['phases'];record['cache_warm_delta']={field:(a['measured'][field]-a['ready'][field])-(b['measured'][field]-b['ready'][field]) for field in ['live_objects','live_bytes']}\nassert record['deltas']['idle']['ready']['live_bytes']==record['deltas']['idle']['measured']['live_bytes']==262144\nassert record['cache_warm_delta']=={'live_objects':2,'live_bytes':4144}\nrecord['passed']=True;record['collector_source']=Path(__file__).read_text();(bench/'2026-10-16-fanout-view-memory.json').write_text(json.dumps(record,indent=2)+'\\n');print(json.dumps({'deltas':record['deltas'],'cache_warm_delta':record['cache_warm_delta']}))\n"
