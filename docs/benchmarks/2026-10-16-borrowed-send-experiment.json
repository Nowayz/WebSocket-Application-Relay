    "patch_source": "diff --git a/src/relay.rs b/src/relay.rs\nindex 2aea53c..cd05fc2 100644\n--- a/src/relay.rs\n+++ b/src/relay.rs\n@@ -121,10 +121,29 @@ pub(crate) struct Envelope {\n     budget: Arc<Budget>,\n }\n \n+/// A charged frame borrowed for one nonblocking send. Only retaining queued\n+/// output clones its body and budget owners; other returns release the charge.\n+pub(crate) struct Submission<'a> {\n+    pub frame: &'a Frame,\n+    budget: Option<&'a Arc<Budget>>,\n+}\n+\n+impl Submission<'_> {\n+    pub(crate) fn into_owned(mut self) -> Envelope {\n+        let frame = self.frame.clone();\n+        let budget = self\n+            .budget\n+            .take()\n+            .expect(\"submission owns its charge\")\n+            .clone();\n+        Envelope { frame, budget }\n+    }\n+}\n+\n /// A transport owns ordering and backpressure. Sending never waits for socket\n /// readiness, and close only signals the owning I/O loop.\n pub(crate) trait PeerOutput: Send + Sync {\n-    fn send(&self, packet: Envelope) -> bool;\n+    fn send(&self, packet: Submission<'_>) -> bool;\n     fn close(&self, reason: Disconnect);\n }\n \n@@ -136,8 +155,8 @@ struct AsyncOutput {\n \n #[cfg(test)]\n impl PeerOutput for AsyncOutput {\n-    fn send(&self, packet: Envelope) -> bool {\n-        self.outgoing.try_send(packet).is_ok()\n+    fn send(&self, packet: Submission<'_>) -> bool {\n+        self.outgoing.try_send(packet.into_owned()).is_ok()\n     }\n \n     fn close(&self, reason: Disconnect) {\n@@ -145,13 +164,24 @@ impl PeerOutput for AsyncOutput {\n     }\n }\n \n+impl Budget {\n+    fn release(&self, size: usize) {\n+        self.used.fetch_sub(size, Relaxed);\n+        self.metrics.queued_bytes.fetch_sub(size, Relaxed);\n+    }\n+}\n+\n impl Drop for Envelope {\n     fn drop(&mut self) {\n-        self.budget.used.fetch_sub(self.frame.len(), Relaxed);\n-        self.budget\n-            .metrics\n-            .queued_bytes\n-            .fetch_sub(self.frame.len(), Relaxed);\n+        self.budget.release(self.frame.len());\n+    }\n+}\n+\n+impl Drop for Submission<'_> {\n+    fn drop(&mut self) {\n+        if let Some(budget) = self.budget {\n+            budget.release(self.frame.len());\n+        }\n     }\n }\n \n@@ -199,9 +229,9 @@ impl Peer {\n             self.budget.metrics.global_pressure.fetch_add(1, Relaxed);\n             return Err(Disconnect::OVERLOADED);\n         }\n-        let packet = Envelope {\n-            frame: frame.clone(),\n-            budget: self.budget.clone(),\n+        let packet = Submission {\n+            frame,\n+            budget: Some(&self.budget),\n         };\n         if !self.output.send(packet) {\n             self.overloaded();\n@@ -771,6 +801,63 @@ mod tests {\n         }\n     }\n \n+    #[test]\n+    fn immediate_and_rejected_submissions_hold_the_charge_without_a_budget_owner_clone() {\n+        struct ImmediateOutput {\n+            reject: AtomicBool,\n+            closed: AtomicBool,\n+            calls: AtomicUsize,\n+        }\n+\n+        impl PeerOutput for ImmediateOutput {\n+            fn send(&self, packet: Submission<'_>) -> bool {\n+                let budget = packet.budget.unwrap();\n+                assert_eq!(Arc::strong_count(budget), 1);\n+                assert_eq!(budget.used.load(Relaxed), packet.frame.len());\n+                assert_eq!(\n+                    budget.metrics.queued_bytes.load(Relaxed),\n+                    packet.frame.len()\n+                );\n+                self.calls.fetch_add(1, Relaxed);\n+                !self.reject.load(Relaxed)\n+            }\n+\n+            fn close(&self, reason: Disconnect) {\n+                assert_eq!(reason, Disconnect::OVERLOADED);\n+                self.closed.store(true, Relaxed);\n+            }\n+        }\n+\n+        let relay = Relay::new(config()).unwrap();\n+        let output = Arc::new(ImmediateOutput {\n+            reject: AtomicBool::new(false),\n+            closed: AtomicBool::new(false),\n+            calls: AtomicUsize::new(0),\n+        });\n+        let registration = relay\n+            .subscribe_with_output(b\"immediate\", output.clone())\n+            .unwrap();\n+        let id = registration.peer.id.load(Relaxed);\n+        for value in [protocol::uint(0), protocol::byte_string(&[0xa5; 1024])] {\n+            relay\n+                .receive(&registration.peer, protocol::envelope(id, &value))\n+                .unwrap();\n+            assert_eq!(registration.peer.budget.used.load(Relaxed), 0);\n+            assert_eq!(relay.metrics.queued_bytes.load(Relaxed), 0);\n+        }\n+        output.reject.store(true, Relaxed);\n+        relay\n+            .receive(&registration.peer, protocol::envelope(id, &[0xf6]))\n+            .unwrap();\n+        assert_eq!(registration.peer.budget.used.load(Relaxed), 0);\n+        assert_eq!(relay.metrics.queued_bytes.load(Relaxed), 0);\n+        assert_eq!(output.calls.load(Relaxed), 4);\n+        assert!(output.closed.load(Relaxed));\n+        assert_eq!(relay.metrics.slow_consumers.load(Relaxed), 1);\n+        drop(registration);\n+        assert_eq!(relay.counts(), (0, 1));\n+    }\n+\n     #[test]\n     fn fanout_shares_the_received_value_and_keeps_it_alive_after_receive_returns() {\n         let relay = Relay::new(config()).unwrap();\ndiff --git a/src/server/socket.rs b/src/server/socket.rs\nindex 85531d0..7a89aa3 100644\n--- a/src/server/socket.rs\n+++ b/src/server/socket.rs\n@@ -22,7 +22,7 @@ use crate::{\n     frame::Frame,\n     metrics::Metrics,\n     protocol::Disconnect,\n-    relay::{Envelope, PeerOutput},\n+    relay::{Envelope, PeerOutput, Submission},\n };\n \n pub(super) const WRITE_QUANTUM: usize = 256 * 1024;\n@@ -135,11 +135,11 @@ impl Socket {\n         Ok(())\n     }\n \n-    fn delivered(&self, packet: &Envelope, state: &mut State) {\n+    fn delivered(&self, frame: &Frame, state: &mut State) {\n         self.metrics.deliveries.fetch_add(1, Relaxed);\n         self.metrics\n             .delivered_bytes\n-            .fetch_add(packet.frame.len() as u64, Relaxed);\n+            .fetch_add(frame.len() as u64, Relaxed);\n         if self.track_activity {\n             state.activity = Instant::now();\n         }\n@@ -174,7 +174,7 @@ impl Socket {\n                 Ok(written) => {\n                     remaining -= written;\n                     if pending.offset == wire_len(&pending.packet.frame) {\n-                        self.delivered(&pending.packet, &mut state);\n+                        self.delivered(&pending.packet.frame, &mut state);\n                     } else {\n                         state.queue.push_front(pending);\n                     }\n@@ -224,7 +224,7 @@ impl Socket {\n }\n \n impl PeerOutput for Socket {\n-    fn send(&self, packet: Envelope) -> bool {\n+    fn send(&self, packet: Submission<'_>) -> bool {\n         let mut state = self.state.lock();\n         if state.closed || state.fatal || state.requested.is_some() {\n             return true;\n@@ -234,9 +234,9 @@ impl PeerOutput for Socket {\n         }\n         let mut offset = 0;\n         if state.queue.is_empty() && !state.control_pending {\n-            match write_frame(&mut state.stream, &packet.frame, &mut offset, WRITE_QUANTUM) {\n-                Ok(_) if offset == wire_len(&packet.frame) => {\n-                    self.delivered(&packet, &mut state);\n+            match write_frame(&mut state.stream, packet.frame, &mut offset, WRITE_QUANTUM) {\n+                Ok(_) if offset == wire_len(packet.frame) => {\n+                    self.delivered(packet.frame, &mut state);\n                     return true;\n                 }\n                 Ok(_) => {}\n@@ -251,7 +251,7 @@ impl PeerOutput for Socket {\n         }\n         let first = state.queue.is_empty();\n         state.queue.push_back(Pending {\n-            packet,\n+            packet: packet.into_owned(),\n             offset,\n             deadline: Instant::now() + self.write_timeout,\n         });\n@@ -402,7 +402,7 @@ mod tests {\n     use super::*;\n     use crate::{Config, Relay, protocol};\n     use mio::Poll;\n-    use tokio_tungstenite::tungstenite::{Message, WebSocket, protocol::Role};\n+    use tokio_tungstenite::tungstenite::{Error, Message, WebSocket, protocol::Role};\n \n     struct Probe {\n         wire: Vec<u8>,\n@@ -467,15 +467,14 @@ mod tests {\n         }\n     }\n \n-    #[test]\n-    fn ordinary_output_has_no_queue_allocation_and_control_never_splits_a_partial_data_frame() {\n+    fn connected() -> (Arc<Relay>, Arc<Socket>, std::net::TcpStream, Poll) {\n         let relay = Relay::new(Config {\n             ping_interval_secs: 0,\n             ..Config::default()\n         })\n         .unwrap();\n         let listener = std::net::TcpListener::bind(\"127.0.0.1:0\").unwrap();\n-        let _reader = std::net::TcpStream::connect(listener.local_addr().unwrap()).unwrap();\n+        let reader = std::net::TcpStream::connect(listener.local_addr().unwrap()).unwrap();\n         let (stream, _) = listener.accept().unwrap();\n         stream.set_nonblocking(true).unwrap();\n         let poll = Poll::new().unwrap();\n@@ -495,6 +494,62 @@ mod tests {\n             &relay,\n         )\n         .unwrap();\n+        (relay, socket, reader, poll)\n+    }\n+\n+    #[test]\n+    fn queued_output_keeps_payload_and_charge_after_membership_retires() {\n+        let (relay, socket, reader, _poll) = connected();\n+        reader\n+            .set_read_timeout(Some(Duration::from_secs(3)))\n+            .unwrap();\n+        let registration = relay\n+            .subscribe_with_output(b\"retained\", socket.clone())\n+            .unwrap();\n+        let id = registration.peer.id.load(Relaxed);\n+        let mut reader = WebSocket::from_raw_socket(reader, Role::Client, None);\n+        assert_eq!(reader.read().unwrap(), Message::Binary(protocol::uint(id)));\n+        reader.get_mut().set_nonblocking(true).unwrap();\n+        let body = protocol::byte_string(&vec![0x5a; 2 * WRITE_QUANTUM]);\n+        let input = protocol::envelope(id, &body);\n+        let charged = input.len();\n+        let pointer = protocol::parse(&input).unwrap().1.as_ptr();\n+        relay.receive(&registration.peer, input).unwrap();\n+        {\n+            let state = socket.state.lock();\n+            assert_eq!(state.queue.len(), 1);\n+            assert!(state.queue[0].offset > 0);\n+            assert_eq!(state.queue[0].packet.frame.payload().as_ptr(), pointer);\n+        }\n+        drop(registration);\n+        assert_eq!(relay.counts(), (0, 1));\n+        assert_eq!(relay.metrics.queued_bytes.load(Relaxed), charged);\n+        let deadline = Instant::now() + Duration::from_secs(3);\n+        loop {\n+            socket.flush().unwrap();\n+            match reader.read() {\n+                Ok(message) => {\n+                    assert_eq!(message, Message::Binary(protocol::envelope(id, &body)));\n+                    break;\n+                }\n+                Err(Error::Io(error)) if error.kind() == io::ErrorKind::WouldBlock => {\n+                    assert!(Instant::now() < deadline, \"queued frame did not complete\");\n+                    std::thread::yield_now();\n+                }\n+                other => panic!(\"{other:?}\"),\n+            }\n+        }\n+        assert_eq!(relay.metrics.queued_bytes.load(Relaxed), 0);\n+        assert_eq!(relay.metrics.deliveries.load(Relaxed), 2);\n+        assert_eq!(socket.state.lock().queue.len(), 0);\n+        assert!(!socket.end_output());\n+        drop(socket);\n+        assert_eq!(relay.metrics.connections.load(Relaxed), 0);\n+    }\n+\n+    #[test]\n+    fn ordinary_output_has_no_queue_allocation_and_control_never_splits_a_partial_data_frame() {\n+        let (relay, socket, _reader, _poll) = connected();\n         let registration = relay\n             .subscribe_with_output(b\"test\", socket.clone())\n             .unwrap();\n",
    "patch_replayed_and_sources_verified": true
  },
