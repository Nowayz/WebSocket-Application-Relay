  "driver_source": "import argparse\nimport datetime\nimport hashlib\nimport json\nfrom pathlib import Path\nimport re\nimport signal\nimport statistics\nimport subprocess\nimport sys\nimport tempfile\nimport time\n\nroot=Path(__file__).resolve().parents[1]\nsys.path.insert(0,str(root/'scripts'))\nimport stability\nparser=argparse.ArgumentParser();parser.add_argument('--profile',action='store_true');args=parser.parse_args()\nsha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()\nserver=root/'artifacts/baselines/ip-admission/war-relay'\nclient=root/'artifacts/baselines/address-churn-client/stress'\nsource=client.parent/'stress.rs';assert sha(source)==sha(root/'examples/stress.rs')\nprefix='address-churn-profile' if args.profile else 'address-churn-comparison'\noutput=root/f'docs/benchmarks/2026-10-16-{prefix}.json'\nrecord={'recorded_utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),\n    'scope':'32 concurrent workers perform fully verified connect/join/16-byte worker+counter self-echo/exact empty Close acknowledgement/TCP EOF cycles. Latency includes the full lifecycle. Both source pools bind explicit127.64.x.y addresses on an IPv4 loopback ws:// URL. Source pool4096 assigns disjoint rotating subsets to workers; pool1 shares one address. Native admission limit0/64; all workloads fit the enabled quota. Same frozen client and server; four server workers CPUs0-3/client CPUs4-7. Eight-second cases, exact lifecycle/message/delivery/value-byte counters, resource/error cleanup. Ordinary comparisons rotate pool/role order across three repetitions and exclude builds/profiles/competing loads. Prior8-byte stress counts and connect-to-echo latency are not equivalent to this stronger contract.',\n    'profile_diagnostic':args.profile,'runtime_source_revision':'ef3d8fcd3826fbc6a4110167a792867dbf05dfd1',\n    'server':{'path':str(server.relative_to(root)),'sha256':sha(server)},\n    'client':{'path':str(client.relative_to(root)),'sha256':sha(client),'source_path':str(source.relative_to(root)),'source_sha256':sha(source)},\n    'helpers':{str(p.relative_to(root)):sha(p) for p in [root/'scripts/stability.py',root/'scripts/benchmark.py']},\n    'driver_source':Path(__file__).read_text(),'driver_sha256':sha(__file__),'cases':[],'passed':False}\njobs=[(1,4096,'enabled')] if args.profile else [\n    (rep,pool,role) for rep in range(1,4)\n    for pool in ([1,4096] if rep%2 else [4096,1])\n    for role in (['disabled','enabled'] if rep%2 else ['enabled','disabled'])]\nfor rep,pool,role in jobs:\n    trace=output.with_name(f'{output.stem}-{pool}-{role}-{rep}.json')\n    perf_path=trace.with_suffix('.perf.data')\n    recorder=None;perf_log=None;original_sample=stability.sample\n    def sample(pid,admin,started):\n        global recorder,perf_log\n        result=original_sample(pid,admin,started)\n        if args.profile and recorder is None:\n            perf_log=tempfile.TemporaryFile()\n            recorder=subprocess.Popen(['perf','record','-e','cycles:u','-F','499','--call-graph','dwarf,8192',\n                '-p',str(pid),'-o',str(perf_path)],stdout=perf_log,stderr=perf_log)\n            time.sleep(.1);assert recorder.poll() is None,'perf recorder could not attach'\n        return result\n    try:\n        stability.sample=sample\n        case=stability.run_case('churn',8,32,server_binary=server,stress_binary=client,\n            server_cpus='0-3',client_cpus='4-7',server_args=['--max-connections-per-ip','64' if role=='enabled' else '0'],source_addresses=pool)\n    finally:\n        stability.sample=original_sample\n        if recorder is not None:\n            if recorder.poll() is None:recorder.send_signal(signal.SIGINT)\n            perf_exit=recorder.wait(timeout=10)\n            perf_log.seek(0);perf_text=perf_log.read().decode();perf_log.close()\n    assert case['passed'] and case['server_exit_code']==case['exit_code']==0\n    metrics=case['final']['metrics'];result=case['output'][-1];cycles=result['verified_deliveries']\n    assert result['payload_bytes']==16 and result['source_addresses']==pool\n    assert int(metrics['war_accepted_total'])==int(metrics['war_joined_total'])==int(metrics['war_disconnected_total'])==cycles\n    assert int(metrics['war_incoming_messages_total'])==cycles and int(metrics['war_deliveries_total'])==2*cycles\n    assert int(metrics['war_routing_reused_bytes_total'])==17*cycles\n    for key in ['war_connections','war_sessions','war_queued_bytes','war_variable_bytes','war_read_buffer_reserved_bytes',\n                'war_output_queue_capacity_bytes','war_ip_rejected_total','war_routing_copied_bytes_total',\n                'war_handshake_errors_total','war_protocol_errors_total','war_write_errors_total','war_close_failures_total',\n                'war_transport_disconnects_total','war_rejected_total']:\n        assert int(metrics[key])==0,key\n    case['profile_diagnostic']=args.profile\n    trace.write_text(json.dumps(case,indent=2)+'\\n')\n    if args.profile:\n        assert perf_exit in (0,-signal.SIGINT),perf_text\n        report_path=trace.with_suffix('.perf.txt')\n        report=subprocess.run(['perf','report','--stdio','--no-children','-g','none','--sort','symbol','--percent-limit','0.1',\n            '-i',str(perf_path)],capture_output=True,text=True,check=True)\n        report_path.write_text(report.stdout)\n        symbols=[]\n        for line in report.stdout.splitlines():\n            match=re.match(r'^\\s*([0-9.]+)%\\s+\\[(.)\\]\\s+(.+)$',line)\n            if match:symbols.append({'self_user_cycles_percent':float(match[1]),'kind':match[2],'symbol':match[3]})\n        record['profile']={'event':'cycles:u','frequency_hz':499,'call_graph':'dwarf,8192','perf_exit_code':perf_exit,\n            'recorder_log':perf_text,'report_stderr':report.stderr,\n            'data':{'path':str(perf_path.relative_to(root)),'sha256':sha(perf_path)},\n            'report':{'path':str(report_path.relative_to(root)),'sha256':sha(report_path)},'symbols':symbols}\n    trace.write_text(json.dumps(case,indent=2)+'\\n')\n    cpu=case['final']['process']['cpu_seconds']-case['baseline']['process']['cpu_seconds']\n    row={'kind':role,'source_addresses':pool,'repetition':rep,'trace':str(trace.relative_to(root)),\n        'trace_sha256':sha(trace),'cycles':cycles,'per_second':result['deliveries_per_second'],\n        'p99_ms':result['latency_p99_upper_ms'],'cpu_seconds':cpu,'cpu_ns_per_cycle':cpu*1e9/cycles,\n        'sampled_peak_rss_mib':max(s['process']['VmRSS'] for s in [case['baseline'],*case['samples'],case['final']])/1024,'passed':True}\n    record['cases'].append(row);output.write_text(json.dumps(record,indent=2)+'\\n');print(json.dumps(row),flush=True)\nif not args.profile:\n    record['medians']={}\n    for pool in [1,4096]:\n        for role in ['disabled','enabled']:\n            rows=[r for r in record['cases'] if r['source_addresses']==pool and r['kind']==role]\n            keys=['per_second','p99_ms','cpu_seconds','cpu_ns_per_cycle','sampled_peak_rss_mib']\n            summary={k:statistics.median(r[k] for r in rows) for k in keys}\n            summary['ranges']={k:[min(r[k] for r in rows),max(r[k] for r in rows)] for k in keys}\n            record['medians'][f'{pool}/{role}']=summary\nrecord['passed']=True;output.write_text(json.dumps(record,indent=2)+'\\n')\nif not args.profile:print(json.dumps(record['medians']),flush=True)\n",
