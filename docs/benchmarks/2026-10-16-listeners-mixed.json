  "driver_source": "import hashlib\nimport json\nfrom pathlib import Path\nimport statistics\nimport subprocess\nimport sys\n\nroot = Path(__file__).resolve().parents[1]\nservers = {\n    'before': root/'artifacts/baselines/12bfc4d/war-relay',\n    'indexed': root/'artifacts/baselines/listener-index-owned/war-relay',\n    'snapshot': root/json.loads((root/'artifacts/listeners-selected-build.json').read_text())['directory']/'war-relay',\n}\nclient = root/'artifacts/baselines/e2d7cf9/inspection'\noutput = root/'docs/benchmarks/2026-10-16-listeners-mixed.json'\nsha = lambda p: hashlib.sha256(Path(p).read_bytes()).hexdigest()\nrecord = {\n    'scope': 'Sequential three-way ablation: committed native runtime, listener eligibility indexes with the existing registry guard, and the selected private fast path retaining the target and releasing that guard before output when no private listeners exist. Both new variants use socket-owned admission reservations. Four workers, 8192 idle rooms, one active private pair, eight reconnect workers; management adds two HTTP inspectors at 100 requests/s each. Frozen original inspection client, 1KiB values, window 16, 8-second phases. Server CPUs 0-3, client CPUs 4-7. Three repetitions, rotating implementation order and reversing workload order. All full payload/FIFO/Close/EOF/counter/resource checks must pass. No build, profiler or other load test overlaps timing.',\n    'parent_revision': subprocess.check_output(['git','rev-parse','HEAD'],cwd=root,text=True).strip(),\n    'variants': {name: {'path':str(path),'sha256':sha(path)} for name,path in servers.items()},\n    'indexed_source': json.loads((root/'artifacts/listener-index-owned-source.json').read_text()),\n    'snapshot_source': json.loads((root/'artifacts/listeners-selected-build.json').read_text()),\n    'client_sha256':sha(client),\n    'helper_sha256':{name:sha(root/'scripts'/name) for name in ['inspection.py','benchmark.py']},\n    'driver_source':Path(__file__).read_text(), 'driver_sha256':sha(__file__),\n    'cases':[], 'passed':False,\n}\nfor repetition in range(1,4):\n    workloads = ['churn','management'] if repetition%2 else ['management','churn']\n    order = list(servers); start=(repetition-1)%len(order); order=order[start:]+order[:start]\n    for workload in workloads:\n        for kind in order:\n            trace=output.with_name(f'{output.stem}-{workload}-{kind}-{repetition}.json')\n            command=[sys.executable,str(root/'scripts/inspection.py'),'--server',str(servers[kind]),\n                     '--client',str(client),'--pairs','1','--churn-workers','8','--seconds','8',\n                     '--mode','http' if workload=='management' else 'none','--output',str(trace)]\n            completed=subprocess.run(command,cwd=root,capture_output=True,text=True,timeout=100)\n            data=json.loads(trace.read_text()); assert completed.returncode==0 and data['passed'],completed.stdout+completed.stderr\n            assert data['server_sha256']==record['variants'][kind]['sha256']\n            assert data['client_sha256']==record['client_sha256'] and not data['profile_diagnostic']\n            assert data['runner_sha256']==record['helper_sha256']['inspection.py']\n            mixed=data['mixed']\n            row={'kind':kind,'workload':workload,'repetition':repetition,'trace':str(trace.relative_to(root)),\n                 'trace_sha256':sha(trace),'passed':True,\n                 'healthy':mixed['healthy']['per_second'],'healthy_p99_ms':mixed['healthy']['p99_upper_ms'],\n                 'churn':mixed['churn']['per_second'],'churn_p99_ms':mixed['churn']['p99_upper_ms'],\n                 'inspection':mixed['inspection']['per_second'],'inspection_p99_ms':mixed['inspection']['p99_upper_ms'],\n                 'cpu_seconds_per_wall_second':mixed['server_cpu_seconds_per_wall_second'],\n                 'rss_measured_mib':data['events'][1]['process']['VmRSS']/1024}\n            record['cases'].append(row);output.write_text(json.dumps(record,indent=2)+'\\n');print(json.dumps(row),flush=True)\nrecord['medians']={}\nfor workload in ['churn','management']:\n    for kind in servers:\n        rows=[c for c in record['cases'] if c['kind']==kind and c['workload']==workload]\n        keys=['healthy','healthy_p99_ms','churn','churn_p99_ms','inspection','inspection_p99_ms','cpu_seconds_per_wall_second','rss_measured_mib']\n        result={key:statistics.median(c[key] for c in rows) for key in keys}\n        result['ranges']={key:[min(c[key] for c in rows),max(c[key] for c in rows)] for key in ['healthy','churn']}\n        record['medians'][workload+'/'+kind]=result\nrecord['passed']=True;output.write_text(json.dumps(record,indent=2)+'\\n');print(json.dumps(record['medians']),flush=True)\n",
