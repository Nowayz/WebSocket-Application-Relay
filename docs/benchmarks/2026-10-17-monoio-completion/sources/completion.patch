diff --git a/crates/completion-buf/src/lib.rs b/crates/completion-buf/src/lib.rs
new file mode 100644
index 0000000..a81dcee
--- /dev/null
+++ b/crates/completion-buf/src/lib.rs
@@ -0,0 +1,239 @@
+//! The small audited boundary between owned relay buffers and Monoio's unsafe
+//! buffer traits. No constructor accepts raw pointers. Storage and its quota
+//! owner travel together, including when an in-flight future is cancelled.
+use bytes::BytesMut;
+use monoio::buf::{IoBuf, IoBufMut, IoVecBuf};
+use std::{
+    io,
+    os::fd::{FromRawFd, IntoRawFd, OwnedFd},
+};
+
+/// A receive allocation retains its admission owner until the kernel returns it.
+pub struct ReadBuffer<G> {
+    bytes: BytesMut,
+    guard: G,
+}
+
+impl<G> ReadBuffer<G> {
+    pub fn new(bytes: BytesMut, guard: G) -> Self {
+        Self { bytes, guard }
+    }
+    pub fn bytes(&self) -> &BytesMut {
+        &self.bytes
+    }
+    pub fn into_parts(self) -> (BytesMut, G) {
+        (self.bytes, self.guard)
+    }
+}
+
+// SAFETY: BytesMut supplies stable allocated storage. Neither storage nor guard
+// can be mutated or taken while Monoio owns this buffer. All initialized-length
+// and pointer operations delegate to Monoio's own BytesMut implementations.
+unsafe impl<G: Unpin + 'static> IoBuf for ReadBuffer<G> {
+    fn read_ptr(&self) -> *const u8 {
+        self.bytes.read_ptr()
+    }
+    fn bytes_init(&self) -> usize {
+        self.bytes.bytes_init()
+    }
+}
+unsafe impl<G: Unpin + 'static> IoBufMut for ReadBuffer<G> {
+    fn write_ptr(&mut self) -> *mut u8 {
+        self.bytes.write_ptr()
+    }
+    fn bytes_total(&mut self) -> usize {
+        self.bytes.bytes_total()
+    }
+    unsafe fn set_init(&mut self, initialized: usize) {
+        // SAFETY: the caller guarantees initialized bytes from a completed read.
+        unsafe { self.bytes.set_init(initialized) };
+    }
+}
+
+struct WriteStorage<G> {
+    header: [u8; 20],
+    iovecs: [libc::iovec; 2],
+    owner: Option<G>,
+    count: usize,
+}
+
+/// One reusable metadata allocation per active writer. The payload's owner is
+/// stored inside that stable allocation before its body pointer is captured.
+/// Published message bodies never need to be copied or reference-cloned here.
+pub struct WriteBuffer<G> {
+    storage: Box<WriteStorage<G>>,
+}
+
+impl<G> Default for WriteBuffer<G> {
+    fn default() -> Self {
+        Self {
+            storage: Box::new(WriteStorage {
+                header: [0; 20],
+                iovecs: [libc::iovec {
+                    iov_base: std::ptr::null_mut(),
+                    iov_len: 0,
+                }; 2],
+                owner: None,
+                count: 0,
+            }),
+        }
+    }
+}
+
+impl<G> WriteBuffer<G> {
+    /// Call only after a previous operation returned this buffer. `body` borrows
+    /// from the retained owner, which is never moved or exposed mutably while an
+    /// operation can read its slices. At most 20 routing/header bytes are copied.
+    pub fn prepare(
+        &mut self,
+        header: &[u8],
+        owner: G,
+        body: for<'a> fn(&'a G) -> &'a [u8],
+        offset: usize,
+        maximum: usize,
+    ) {
+        assert!(self.storage.owner.is_none());
+        assert!(header.len() <= self.storage.header.len());
+        self.storage.header[..header.len()].copy_from_slice(header);
+        self.storage.owner = Some(owner);
+        let payload = body(self.storage.owner.as_ref().unwrap());
+        assert!(offset <= header.len() + payload.len());
+        let head_start = offset.min(header.len());
+        let head_end = header.len().min(offset.saturating_add(maximum));
+        let head = &self.storage.header[head_start..head_end];
+        let body_start = offset.saturating_sub(header.len());
+        let body_end = payload.len().min(body_start + maximum - head.len());
+        let body = &payload[body_start..body_end];
+        self.storage.iovecs = [
+            libc::iovec {
+                iov_base: head.as_ptr().cast_mut().cast(),
+                iov_len: head.len(),
+            },
+            libc::iovec {
+                iov_base: body.as_ptr().cast_mut().cast(),
+                iov_len: body.len(),
+            },
+        ];
+        if head.is_empty() {
+            self.storage.iovecs.swap(0, 1);
+            self.storage.count = 1;
+        } else {
+            self.storage.count = if body.is_empty() { 1 } else { 2 };
+        }
+    }
+
+    pub fn take_owner(&mut self) -> G {
+        self.storage.count = 0;
+        self.storage.owner.take().expect("prepared write owner")
+    }
+}
+
+// SAFETY: the iovecs, header and owner reside in one private Box, whose address
+// remains stable when WriteBuffer moves. body() borrows initialized bytes from
+// that owner. No method exposes a mutable owner, and the runtime exclusively
+// owns this value while the kernel can use those pointers. Dropping an in-flight
+// Monoio future retains the complete buffer, including owner, until its CQE.
+unsafe impl<G: Unpin + 'static> IoVecBuf for WriteBuffer<G> {
+    fn read_iovec_ptr(&self) -> *const libc::iovec {
+        self.storage.iovecs.as_ptr()
+    }
+    fn read_iovec_len(&self) -> usize {
+        self.storage.count
+    }
+}
+
+/// All operations and split halves must have returned before this call. Taking
+/// Monoio's descriptor ownership avoids leaving its asynchronous close queued
+/// after the relay releases the connection's admission guard.
+pub fn close_tcp(stream: monoio::net::TcpStream) {
+    let raw = stream.into_raw_fd();
+    // SAFETY: IntoRawFd transfers the one descriptor's ownership to us.
+    let owned = unsafe { OwnedFd::from_raw_fd(raw) };
+    drop(owned);
+}
+
+/// Transfer a uniquely owned accepted descriptor without dup() or a new socket.
+pub fn into_std_tcp(stream: impl IntoRawFd) -> std::net::TcpStream {
+    let raw = stream.into_raw_fd();
+    // SAFETY: IntoRawFd transfers sole ownership and callers supply TCP streams.
+    unsafe { std::net::TcpStream::from_raw_fd(raw) }
+}
+
+/// Stop TCP before retiring the descriptor; called after both I/O halves return.
+pub fn shutdown_tcp(stream: &monoio::net::TcpStream) -> io::Result<()> {
+    use std::os::fd::AsRawFd;
+    // SAFETY: the borrowed stream keeps this descriptor valid for the syscall.
+    if unsafe { libc::shutdown(stream.as_raw_fd(), libc::SHUT_RDWR) } == -1 {
+        Err(io::Error::last_os_error())
+    } else {
+        Ok(())
+    }
+}
+
+/// A short header receive can reject a frame before the rest of an already
+/// queued TCP packet is consumed. After its policy Close has actually been
+/// sent, discard at most one ordinary read chunk without waiting for a body.
+/// This avoids turning that small complete rejection into an immediate reset
+/// solely because those already arrived bytes remained unread at close().
+/// Larger/unfinished rejected bodies still receive a best-effort Close only.
+#[inline(never)]
+pub fn discard_rejected_input(stream: &monoio::net::TcpStream) {
+    use std::os::fd::AsRawFd;
+    let mut discard = [0u8; 4096];
+    // SAFETY: the borrowed stream owns the live descriptor. The destination is
+    // initialized valid stack storage; MSG_DONTWAIT bounds this single syscall.
+    unsafe {
+        libc::recv(
+            stream.as_raw_fd(),
+            discard.as_mut_ptr().cast(),
+            discard.len(),
+            libc::MSG_DONTWAIT,
+        );
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn vectored_metadata_and_inline_owners_remain_stable_across_moves_and_short_writes() {
+        struct Owner {
+            bytes: [u8; 129],
+        }
+        let mut write = WriteBuffer::default();
+        let metadata = write.read_iovec_ptr();
+        for offset in 0..149 {
+            write.prepare(
+                &[0x82; 20],
+                Owner { bytes: [0x5a; 129] },
+                |owner| &owner.bytes,
+                offset,
+                7,
+            );
+            let stable_owner = write.storage.owner.as_ref().unwrap().bytes.as_ptr();
+            let mut moved = vec![write].pop().unwrap();
+            assert_eq!(metadata, moved.read_iovec_ptr());
+            // SAFETY: this test reads the private valid iovec array only while
+            // no runtime owns it. It never dereferences a stale payload pointer.
+            let iovecs = unsafe {
+                std::slice::from_raw_parts(moved.read_iovec_ptr(), moved.read_iovec_len())
+            };
+            let body = if offset < 20 && 20 - offset >= 7 {
+                None
+            } else {
+                iovecs.last()
+            };
+            if let Some(body) = body {
+                assert_eq!(
+                    body.iov_base.cast_const().cast::<u8>(),
+                    stable_owner.wrapping_add(offset.saturating_sub(20))
+                );
+            }
+            let total = iovecs.iter().map(|iov| iov.iov_len).sum::<usize>();
+            assert_eq!(total, 7.min(149 - offset));
+            let owner = moved.take_owner();
+            assert_eq!(owner.bytes, [0x5a; 129]);
+            write = moved;
+        }
+    }
+}
