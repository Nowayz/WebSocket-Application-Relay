+                TaskPoll::Ready(())
+            } else {
+                TaskPoll::Pending
+            }
+        });
+        tokio::select! {
+            result = driver.waits.next() => { if let Some(result) = result { driver.complete(worker, result, stopping)?; } }
+            _ = notified => {}
+            _ = timer => {}
+        }
+    }
+    Ok(())
+}
diff --git a/src/server/monoio_tests.rs b/src/server/monoio_tests.rs
new file mode 100644
index 0000000..c44db9b
--- /dev/null
+++ b/src/server/monoio_tests.rs
@@ -0,0 +1,36 @@
+use super::*;
+use std::io::Read;
+
+#[test]
+fn admitted_handoff_keeps_quota_until_its_single_tcp_descriptor_retires() {
+    let relay = Relay::new(crate::Config {
+        monoio: true,
+        workers: Some(1),
+        ping_interval_secs: 0,
+        ..crate::Config::default()
+    })
+    .unwrap();
+    let listener = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+    listener.set_nonblocking(true).unwrap();
+    let mut client = std::net::TcpStream::connect(listener.local_addr().unwrap()).unwrap();
+    client
+        .set_read_timeout(Some(Duration::from_secs(1)))
+        .unwrap();
+    let mut worker = Worker::new(listener, relay.clone()).unwrap();
+    worker.accept().unwrap();
+    assert_eq!(worker.connections.len(), 1);
+    assert!(worker.connections[0].socket.state.lock().stream.is_none());
+    let handoff = worker
+        .monoio_new
+        .pop()
+        .expect("single descriptor and its quota owner");
+    worker.connections.clear();
+    assert_eq!(relay.metrics.connections.load(Relaxed), 1);
+    drop(handoff);
+    assert_eq!(relay.metrics.connections.load(Relaxed), 0);
+    assert_eq!(
+        client.read(&mut [0]).unwrap(),
+        0,
+        "retired admission must not leave an established transport behind"
+    );
+}
