+++ b/tests/completion_storage.rs
@@ -0,0 +1,274 @@
+//! Completion buffers must preserve decoder state, shared body pointers and
+//! admission across pending reads. This exercises the public decoder hooks.
+use std::io::{self, Read, Write};
+use tokio_tungstenite::tungstenite::{
+    Error, Message, WebSocket,
+    protocol::{ReadBudget, Role, WebSocketConfig},
+};
+
+struct Pending;
+impl Read for Pending {
+    fn read(&mut self, _: &mut [u8]) -> io::Result<usize> {
+        Err(io::ErrorKind::WouldBlock.into())
+    }
+}
+impl Write for Pending {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        Ok(bytes.len())
+    }
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
+
+fn masked(opcode: u8, body: &[u8]) -> Vec<u8> {
+    let mut wire = vec![opcode];
+    match body.len() {
+        0..=125 => wire.push(0x80 | body.len() as u8),
+        126..=65535 => {
+            wire.push(0xfe);
+            wire.extend_from_slice(&(body.len() as u16).to_be_bytes());
+        }
+        _ => {
+            wire.push(0xff);
+            wire.extend_from_slice(&(body.len() as u64).to_be_bytes());
+        }
+    }
+    let mask = [0x17, 0x39, 0x5b, 0x7d];
+    wire.extend_from_slice(&mask);
+    wire.extend(body.iter().enumerate().map(|(i, byte)| byte ^ mask[i & 3]));
+    wire
+}
+
+fn socket() -> (WebSocket<Pending>, std::sync::Arc<ReadBudget>) {
+    let budget = ReadBudget::new(16 * 1024 * 1024);
+    let mut socket = WebSocket::from_raw_socket(
+        Pending,
+        Role::Server,
+        Some(
+            WebSocketConfig::default()
+                .read_buffer_size(4096)
+                .shared_read_buffer(true),
+        ),
+    );
+    socket
+        .set_read_budget(budget.try_lease(0).unwrap())
+        .unwrap();
+    socket.enable_external_read();
+    (socket, budget)
+}
+
+fn blocked(ws: &mut WebSocket<Pending>) {
+    assert!(matches!(ws.read(), Err(Error::Io(e)) if e.kind() == io::ErrorKind::WouldBlock));
+}
+
+fn feed(ws: &mut WebSocket<Pending>, bytes: &[u8], eof: bool) -> usize {
+    let (mut storage, range) = ws.take_external_read().expect("blocked external read");
+    assert!(bytes.len() <= range.len());
+    let mut buffer = storage.take_io_buffer();
+    let pointer = buffer.as_ptr() as usize;
+    buffer.extend_from_slice(bytes); // Simulated kernel input in this state test.
+    storage.restore_io_buffer(buffer);
+    ws.restore_external_read(storage, eof);
+    pointer
+}
+
+#[test]
+fn every_small_frame_split_resumes_without_losing_input_or_lending_inflight_storage() {
+    let body = vec![0xa5; 257];
+    let wire = masked(0x82, &body);
+    for split in 0..wire.len() {
+        let (mut ws, budget) = socket();
+        blocked(&mut ws);
+        feed(&mut ws, &wire[..split], false);
+        blocked(&mut ws);
+        let (mut storage, range) = ws.take_external_read().unwrap();
+        let reserved = budget.reserved();
+        assert!(reserved > 0);
+        blocked(&mut ws);
+        assert!(ws.take_external_read().is_none());
+        assert!(ws.take_read_storage().is_none());
+        assert_eq!(ws.reclaim_read_buffer(), None);
+        assert_eq!(budget.reserved(), reserved);
+        let mut buffer = storage.take_io_buffer();
+        assert!(wire.len() - split <= range.len());
+        buffer.extend_from_slice(&wire[split..]);
+        storage.restore_io_buffer(buffer);
+        ws.restore_external_read(storage, false);
+        assert_eq!(ws.read().unwrap(), Message::Binary(body.clone().into()));
+        drop(ws);
+        assert_eq!(budget.reserved(), 0);
+    }
+}
+
+#[test]
+fn a_coalesced_body_keeps_its_receive_pointer_after_storage_handoffs_and_eof() {
+    let (mut ws, budget) = socket();
+    let first = masked(0x82, &[0x5a; 257]);
+    let next = masked(0x82, &[0xa5; 11]);
+    let wire = [first.as_slice(), next.as_slice()].concat();
+    blocked(&mut ws);
+    let pointer = feed(&mut ws, &wire, false);
+    let Message::Binary(first_body) = ws.read().unwrap() else {
+        panic!("binary");
+    };
+    let Message::Binary(next_body) = ws.read().unwrap() else {
+        panic!("binary");
+    };
+    assert_eq!(first_body.as_ptr() as usize, pointer + 8);
+    assert_eq!(next_body.as_ptr() as usize, pointer + first.len() + 6);
+    blocked(&mut ws);
+    let (mut storage, _) = ws.take_external_read().unwrap();
+    let buffer = storage.take_io_buffer();
+    let rented = war_completion_buf::ReadBuffer::new(buffer, storage);
+    drop(ws); // The in-flight owner must keep the staging allowance charged.
+    assert!(budget.reserved() > 0);
+    drop(rented);
+    assert_eq!(budget.reserved(), 0);
+    assert_eq!(first_body, &[0x5a; 257][..]);
+    assert_eq!(next_body, &[0xa5; 11][..]);
+
+    let (mut eof, budget) = socket();
+    blocked(&mut eof);
+    feed(&mut eof, &[], true);
+    assert!(matches!(eof.read(), Err(Error::Protocol(_))));
+    drop(eof);
+    assert_eq!(budget.reserved(), 0);
+}
+
+#[test]
+fn fragments_and_interleaved_ping_preserve_state_across_external_reads() {
+    let (mut ws, budget) = socket();
+    blocked(&mut ws);
+    feed(&mut ws, &masked(0x02, &[0x17; 50]), false);
+    blocked(&mut ws);
+    feed(&mut ws, &masked(0x89, b"ping"), false);
+    assert_eq!(ws.read().unwrap(), Message::Ping("ping".into()));
+    blocked(&mut ws);
+    feed(&mut ws, &masked(0x80, &[0x39; 50]), false);
+    assert_eq!(
+        ws.read().unwrap(),
+        Message::Binary([vec![0x17; 50], vec![0x39; 50]].concat().into())
+    );
+    drop(ws);
+    assert_eq!(budget.reserved(), 0);
+}
+
+#[test]
+fn a_real_completion_read_writes_directly_into_the_decoders_lent_allocation() {
+    use monoio::{buf::IoBufMut, io::AsyncReadRent};
+    let listener = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+    let mut client = std::net::TcpStream::connect(listener.local_addr().unwrap()).unwrap();
+    let (server, _) = listener.accept().unwrap();
+    let wire = masked(0x82, &[0xa5; 1024]);
+    client.write_all(&wire).unwrap();
+    monoio::RuntimeBuilder::<monoio::IoUringDriver>::new()
+        .build()
+        .unwrap()
+        .block_on(async {
+            let mut server = monoio::net::TcpStream::from_std(server).unwrap();
+            let (mut ws, budget) = socket();
+            blocked(&mut ws);
+            let mut first_pointer = None;
+            loop {
+                let (mut storage, range) = ws.take_external_read().unwrap();
+                let bytes = storage.take_io_buffer();
+                first_pointer.get_or_insert(bytes.as_ptr() as usize);
+                let rented = war_completion_buf::ReadBuffer::new(bytes, storage).slice_mut(range);
+                let (result, buffer) = server.read(rented).await;
+                assert!(result.unwrap() > 0);
+                let (bytes, mut storage) = buffer.into_inner().into_parts();
+                storage.restore_io_buffer(bytes);
+                ws.restore_external_read(storage, false);
+                match ws.read() {
+                    Ok(Message::Binary(body)) => {
+                        assert_eq!(body, &[0xa5; 1024][..]);
+                        assert_eq!(body.as_ptr() as usize, first_pointer.unwrap() + 8);
+                        break;
+                    }
+                    Err(Error::Io(e)) if e.kind() == io::ErrorKind::WouldBlock => {}
+                    result => panic!("unexpected receive: {result:?}"),
+                }
+            }
+            drop(ws);
+            assert_eq!(budget.reserved(), 0);
+            war_completion_buf::close_tcp(server);
+        });
+}
+
+#[test]
+fn cancellation_keeps_receive_admission_until_the_kernel_returns_its_buffer() {
+    use monoio::{
+        buf::IoBufMut,
+        io::{CancelableAsyncReadRent, Canceller},
+    };
+    use std::{
+        future::{Future, poll_fn},
+        task::Poll,
+    };
+    let listener = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+    let _client = std::net::TcpStream::connect(listener.local_addr().unwrap()).unwrap();
+    let (server, _) = listener.accept().unwrap();
+    monoio::RuntimeBuilder::<monoio::IoUringDriver>::new()
+        .enable_timer()
+        .build()
+        .unwrap()
+        .block_on(async {
+            let mut server = monoio::net::TcpStream::from_std(server).unwrap();
+            let budget = ReadBudget::new(8192);
+            let buffer = war_completion_buf::ReadBuffer::new(
+                bytes::BytesMut::with_capacity(4096),
+                budget.try_lease(8192).unwrap(),
+            );
+            let cancel = Canceller::new();
+            let (result, buffer) = {
+                let operation = server.cancelable_read(buffer.slice_mut(..4096), cancel.handle());
+                tokio::pin!(operation);
+                poll_fn(|cx| {
+                    assert!(operation.as_mut().poll(cx).is_pending());
+                    Poll::Ready(())
+                })
+                .await;
+                monoio::time::sleep(std::time::Duration::from_millis(1)).await;
+                assert_eq!(budget.reserved(), 8192);
+                let _cancel = cancel.cancel();
+                operation.await
+            };
+            assert_eq!(result.unwrap_err().raw_os_error(), Some(125));
+            assert_eq!(budget.reserved(), 8192);
+            drop(buffer);
+            assert_eq!(budget.reserved(), 0);
+            war_completion_buf::close_tcp(server);
+        });
+}
+
+#[test]
+fn a_cold_body_reserves_its_declared_length_and_one_header_of_read_ahead() {
+    let (mut ws, budget) = socket();
+    ws.set_external_read_standby_capacity(14);
+    let wire = masked(0x82, &[0x5a; 1024]);
+    blocked(&mut ws);
+    assert_eq!(ws.read_storage_capacity(), 14);
+    feed(&mut ws, &wire[..14], false);
+    blocked(&mut ws);
+    assert_eq!(ws.read_storage_capacity(), 1024 + 14);
+    assert_eq!(budget.reserved(), 2 * (1024 + 14));
+    let (mut storage, range) = ws.take_external_read().unwrap();
+    assert!(wire.len() - 14 <= range.len());
+    let mut bytes = storage.take_io_buffer();
+    let pointer = bytes.as_ptr();
+    bytes.extend_from_slice(&wire[14..]);
+    storage.restore_io_buffer(bytes);
+    ws.restore_external_read(storage, false);
+    let Message::Binary(body) = ws.read().unwrap() else {
+        panic!("binary");
+    };
+    assert_eq!(body.as_ptr(), pointer);
+    assert_eq!(body, &[0x5a; 1024][..]);
+    blocked(&mut ws);
+    assert_eq!(ws.read_storage_capacity(), 14);
+    assert_eq!(budget.reserved(), 28);
+    drop(ws);
+    assert_eq!(budget.reserved(), 0);
+    assert_eq!(body, &[0x5a; 1024][..]);
+}
