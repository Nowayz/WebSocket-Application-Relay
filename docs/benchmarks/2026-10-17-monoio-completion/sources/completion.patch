@@ -0,0 +1,640 @@
+//! Experimental completion I/O: one descriptor per accepted TCP connection.
+//! Local read/write tasks own the halves; routing retains shared envelopes in
+//! bounded queues. The existing decoder, protocol and retirement paths remain.
+use super::*;
+use bytes::BytesMut;
+use futures_util::{FutureExt, Stream, StreamExt};
+use monoio::{
+    buf::IoBufMut,
+    io::{CancelableAsyncReadRent, CancelableAsyncWriteRent, Canceller, Splitable},
+    net::tcp::{TcpOwnedReadHalf, TcpOwnedWriteHalf},
+    task::JoinHandle,
+};
+use std::{
+    cell::{Cell, RefCell},
+    future::poll_fn,
+    pin::Pin,
+    rc::Rc,
+    task::{Context as TaskContext, Poll as TaskPoll, Waker},
+};
+use war_completion_buf::{ReadBuffer, WriteBuffer};
+
+pub(super) fn run(worker: Worker) -> Result<()> {
+    monoio::RuntimeBuilder::<monoio::IoUringDriver>::new()
+        .enable_timer()
+        .build()
+        .context("cannot create Monoio io_uring completion worker")?
+        .block_on(run_worker(worker))
+}
+
+#[derive(Default)]
+struct Gate {
+    stopped: Cell<bool>,
+    waker: RefCell<Option<Waker>>,
+}
+impl Gate {
+    fn stop(&self) {
+        self.stopped.set(true);
+        if let Some(waker) = self.waker.borrow().as_ref() {
+            waker.wake_by_ref();
+        }
+    }
+    fn register(&self, cx: &TaskContext<'_>) {
+        let mut waker = self.waker.borrow_mut();
+        if let Some(waker) = waker.as_mut() {
+            waker.clone_from(cx.waker());
+        } else {
+            *waker = Some(cx.waker().clone());
+        }
+    }
+    async fn stopped(&self) {
+        poll_fn(|cx| {
+            self.register(cx);
+            if self.stopped.get() {
+                TaskPoll::Ready(())
+            } else {
+                TaskPoll::Pending
+            }
+        })
+        .await
+    }
+}
+
+enum ReadGuard {
+    Upgrade(Option<ReadLease>),
+    WebSocket(ReadStorage),
+}
+struct ReadJob {
+    buffer: ReadBuffer<ReadGuard>,
+    range: std::ops::Range<usize>,
+}
+#[derive(Default)]
+struct ReadControl {
+    gate: Gate,
+    job: RefCell<Option<ReadJob>>,
+    reclaim: Cell<bool>,
+}
+impl ReadControl {
+    fn reclaim(&self) {
+        self.reclaim.set(true);
+        if let Some(waker) = self.gate.waker.borrow().as_ref() {
+            waker.wake_by_ref();
+        }
+    }
+    async fn interrupted(&self) {
+        poll_fn(|cx| {
+            self.gate.register(cx);
+            if self.gate.stopped.get() || self.reclaim.get() {
+                TaskPoll::Ready(())
+            } else {
+                TaskPoll::Pending
+            }
+        })
+        .await
+    }
+    fn submit(&self, job: ReadJob) {
+        assert!(self.job.borrow_mut().replace(job).is_none());
+        if let Some(waker) = self.gate.waker.borrow().as_ref() {
+            waker.wake_by_ref();
+        }
+    }
+    async fn next(&self) -> Option<ReadJob> {
+        poll_fn(|cx| {
+            self.gate.register(cx);
+            if self.gate.stopped.get() {
+                TaskPoll::Ready(None)
+            } else if let Some(job) = self.job.borrow_mut().take() {
+                TaskPoll::Ready(Some(job))
+            } else {
+                TaskPoll::Pending
+            }
+        })
+        .await
+    }
+}
+
+enum Completion {
+    Accept(io::Result<()>),
+    Read(Token, io::Result<usize>, ReadBuffer<ReadGuard>, bool),
+}
+#[derive(Default)]
+struct Queue {
+    pending: RefCell<VecDeque<Completion>>,
+    waker: RefCell<Option<Waker>>,
+}
+impl Queue {
+    fn push(&self, item: Completion) {
+        self.pending.borrow_mut().push_back(item);
+        if let Some(waker) = self.waker.borrow().as_ref() {
+            waker.wake_by_ref();
+        }
+    }
+}
+struct Events(Rc<Queue>);
+impl Stream for Events {
+    type Item = Completion;
+    fn poll_next(self: Pin<&mut Self>, cx: &mut TaskContext<'_>) -> TaskPoll<Option<Completion>> {
+        if let Some(item) = self.0.pending.borrow_mut().pop_front() {
+            return TaskPoll::Ready(Some(item));
+        }
+        let mut waker = self.0.waker.borrow_mut();
+        if let Some(waker) = waker.as_mut() {
+            waker.clone_from(cx.waker());
+        } else {
+            *waker = Some(cx.waker().clone());
+        }
+        TaskPoll::Pending
+    }
+}
+
+async fn read_socket(
+    mut read: TcpOwnedReadHalf,
+    control: Rc<ReadControl>,
+    queue: Rc<Queue>,
+    token: Token,
+    _socket: Arc<Socket>,
+) -> TcpOwnedReadHalf {
+    let mut cancel = Canceller::new();
+    while let Some(job) = control.next().await {
+        let operation = read.cancelable_read(job.buffer.slice_mut(job.range), cancel.handle());
+        let (result, buffer) = {
+            tokio::pin!(operation);
+            tokio::select! {
+                biased;
+                result = &mut operation => result,
+                _ = control.interrupted() => {
+                    cancel = cancel.cancel();
+                    operation.await
+                }
+            }
+        };
+        let buffer = buffer.into_inner();
+        if control.gate.stopped.get() {
+            break;
+        }
+        queue.push(Completion::Read(
+            token,
+            result,
+            buffer,
+            control.reclaim.replace(false),
+        ));
+    }
+    read
+}
+
+async fn write_socket(
+    mut write: TcpOwnedWriteHalf,
+    control: Rc<Gate>,
+    socket: Arc<Socket>,
+) -> TcpOwnedWriteHalf {
+    let mut cancel = Canceller::new();
+    // Allocate only on first output, then reuse the header/iovec metadata.
+    let mut buffer: Option<WriteBuffer<socket::CompletionWrite>> = None;
+    loop {
+        let outgoing = poll_fn(|cx| {
+            control.register(cx);
+            socket.io_waker.register(cx.waker());
+            if control.stopped.get() {
+                TaskPoll::Ready(None)
+            } else if let Some(outgoing) = socket.take_completion_write() {
+                TaskPoll::Ready(Some(outgoing))
+            } else {
+                TaskPoll::Pending
+            }
+        })
+        .await;
+        let Some(mut outgoing) = outgoing else {
+            break;
+        };
+        let mut quantum = socket::WRITE_QUANTUM;
+        let result = loop {
+            let mut header = [0; 20];
+            let length = outgoing.header(&mut header);
+            let offset = outgoing.offset();
+            let mut owned = buffer.take().unwrap_or_default();
+            owned.prepare(
+                &header[..length],
+                outgoing,
+                socket::CompletionWrite::body,
+                offset,
+                quantum,
+            );
+            let operation = write.cancelable_writev(owned, cancel.handle());
+            let (result, mut owned) = {
+                tokio::pin!(operation);
+                tokio::select! {
+                    biased;
+                    result = &mut operation => result,
+                    _ = control.stopped() => {
+                        cancel = cancel.cancel();
+                        operation.await
+                    }
+                }
+            };
+            outgoing = owned.take_owner();
+            buffer = Some(owned);
+            match result {
+                Ok(0) => break Err(io::ErrorKind::WriteZero.into()),
+                Ok(written) => {
+                    outgoing.advance(written);
+                    quantum -= written;
+                    if outgoing.complete() {
+                        break Ok(());
+                    }
+                    if control.stopped.get() {
+                        break Err(io::ErrorKind::ConnectionAborted.into());
+                    }
+                    if quantum == 0 {
+                        yield_once().await;
+                        quantum = socket::WRITE_QUANTUM;
+                    }
+                }
+                Err(error) => break Err(error),
+            }
+        };
+        socket.complete_write(&outgoing, &result, control.stopped.get());
+        drop(outgoing); // Release admission only after completion/cancellation.
+        if control.stopped.get() {
+            break;
+        }
+    }
+    write
+}
+
+struct Watch {
+    read: Rc<ReadControl>,
+    write: Rc<Gate>,
+    reader: JoinHandle<TcpOwnedReadHalf>,
+    writer: JoinHandle<TcpOwnedWriteHalf>,
+    socket: Arc<Socket>,
+    read_busy: bool,
+}
+impl Watch {
+    fn new(stream: std::net::TcpStream, socket: Arc<Socket>, queue: Rc<Queue>) -> io::Result<Self> {
+        let (reader, writer) = monoio::net::TcpStream::from_std(stream)?.into_split();
+        let read = Rc::new(ReadControl::default());
+        let write = Rc::new(Gate::default());
+        Ok(Self {
+            reader: monoio::spawn(read_socket(
+                reader,
+                read.clone(),
+                queue,
+                socket.token,
+                socket.clone(),
+            )),
+            writer: monoio::spawn(write_socket(writer, write.clone(), socket.clone())),
+            read,
+            write,
+            socket,
+            read_busy: false,
+        })
+    }
+    fn retire(self) -> JoinHandle<()> {
+        self.read.gate.stop();
+        self.write.stop();
+        monoio::spawn(async move {
+            let reader = self.reader.await;
+            let writer = self.writer.await;
+            let stream = reader.reunite(writer).expect("same owned socket halves");
+            if self.socket.state.lock().discard_rejected_input {
+                war_completion_buf::discard_rejected_input(&stream);
+            }
+            let _ = war_completion_buf::shutdown_tcp(&stream);
+            war_completion_buf::close_tcp(stream);
+            drop(self.socket); // TCP descriptor retires before connection quota.
+        })
+    }
+}
+
+struct Driver {
+    listener: Rc<Gate>,
+    listener_task: Option<JoinHandle<()>>,
+    listener_enabled: Rc<Cell<bool>>,
+    watches: HashMap<Token, Watch>,
+    waits: Events,
+    retired: Vec<JoinHandle<()>>,
+}
+impl Driver {
+    fn prepare_reclaims(&self, worker: &mut Worker, now: Instant) {
+        // Only visit scheduled tokens, never the idle population.
+        for token in worker.ready.iter().take(1024) {
+            let Some(&slot) = worker.tokens.get(token) else {
+                continue;
+            };
+            let connection = &mut worker.connections[slot];
+            if connection
+                .reclaim_deadline
+                .is_some_and(|deadline| deadline <= now)
+                && let Some(watch) = self.watches.get(token)
+                && watch.read_busy
+            {
+                connection.reclaim_deadline = None;
+                watch.read.reclaim();
+            }
+        }
+    }
+    fn new(listener: std::net::TcpListener) -> io::Result<Self> {
+        let queue = Rc::new(Queue::default());
+        let listener = monoio::net::TcpListener::from_std(listener)?;
+        let gate = Rc::new(Gate::default());
+        let enabled = Rc::new(Cell::new(true));
+        let (control, accept_enabled, completed) = (gate.clone(), enabled.clone(), queue.clone());
+        let task = monoio::spawn(async move {
+            loop {
+                poll_fn(|cx| {
+                    control.register(cx);
+                    if control.stopped.get() || accept_enabled.get() {
+                        TaskPoll::Ready(())
+                    } else {
+                        TaskPoll::Pending
+                    }
+                })
+                .await;
+                if control.stopped.get() {
+                    return;
+                }
+                tokio::select! {
+                    biased;
+                    _ = control.stopped() => return,
+                    result = listener.readable(false) => {
+                        accept_enabled.set(false);
+                        completed.push(Completion::Accept(result));
+                    }
+                }
+            }
+        });
+        Ok(Self {
+            listener: gate,
+            listener_enabled: enabled,
+            listener_task: Some(task),
+            watches: HashMap::new(),
+            waits: Events(queue),
+            retired: Vec::new(),
+        })
+    }
+
+    fn sync(&mut self, worker: &mut Worker, stopping: bool) -> Result<()> {
+        if !stopping
+            && worker.accept_retry.is_none()
+            && !worker.accept_queued
+            && !self.listener_enabled.replace(true)
+            && let Some(waker) = self.listener.waker.borrow().as_ref()
+        {
+            waker.wake_by_ref();
+        }
+        for (token, stream, socket) in worker.monoio_new.drain(..) {
+            if worker.tokens.contains_key(&token) {
+                self.watches
+                    .insert(token, Watch::new(stream, socket, self.waits.0.clone())?);
+            }
+        }
+        for token in worker.monoio_dirty.drain(..) {
+            let Some(&slot) = worker.tokens.get(&token) else {
+                if let Some(watch) = self.watches.remove(&token) {
+                    self.retired.push(watch.retire());
+                }
+                continue;
+            };
+            let Some(watch) = self.watches.get_mut(&token) else {
+                continue;
+            };
+            if watch.read_busy {
+                continue;
+            }
+            let connection = &mut worker.connections[slot];
+            let job = match &mut connection.stage {
+                Stage::Upgrade(_) => {
+                    let mut state = connection.socket.state.lock();
