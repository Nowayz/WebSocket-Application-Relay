  "sources": {
    "src/metrics.rs": "6ef66ebdd2fe85473cdc815eb521eb5feae6d79bf8ff89e5cbfd0c69995d0866",
    "scripts/inspection.py": "ef1340431a03e39b30561a39fa8215e25187b2d8fcd9539dab1cb74160b0e0f4",
    "scripts/benchmark.py": "eaebf7f8d3b896bbab48fe1bdf7f31098d2e30064a3ccc6873cc6309e38151f4"
