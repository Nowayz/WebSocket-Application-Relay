+
+/// Return completed write credits conservatively at the end of a bounded batch.
+/// The owned budget keeps the reservation alive through every exit, including panic.
+#[derive(Default)]
+pub(crate) struct CompletionBatch {
+    budget: Option<Arc<Budget>>,
+    bytes: usize,
+}
+
+impl CompletionBatch {
+    pub(crate) fn complete(&mut self, mut packet: Envelope) {
+        let budget = packet.budget.as_ref().expect("charged completion");
+        if self
+            .budget
+            .as_ref()
+            .is_some_and(|active| !Arc::ptr_eq(active, budget))
+        {
+            self.release();
+        }
+        let bytes = self
+            .bytes
+            .checked_add(packet.frame.len())
+            .expect("completed credits fit reserved budget");
+        let budget = packet.budget.take().expect("charged completion");
+        self.bytes = bytes;
+        if self.budget.is_none() {
+            self.budget = Some(budget);
+        }
+    }
+
+    fn release(&mut self) {
+        if let Some(budget) = self.budget.take() {
+            budget.release(std::mem::take(&mut self.bytes));
+        }
+    }
+}
+
+impl Drop for CompletionBatch {
+    fn drop(&mut self) {
+        self.release();
     }
 }
 
