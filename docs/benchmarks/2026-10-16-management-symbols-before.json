  "analyzer_source": "import argparse\nimport hashlib\nimport json\nfrom pathlib import Path\nimport re\nimport subprocess\n\nparser = argparse.ArgumentParser()\nparser.add_argument('--report', type=Path, required=True)\nparser.add_argument('--output', type=Path, required=True)\nargs = parser.parse_args()\nreport = json.loads(args.report.read_text())\nbinary = Path(report['server_command'][3])\naddresses, gates = set(), []\nfor gate in ['before', 'after']:\n    descriptor = report['allocation_probe'][gate]\n    heap = Path(descriptor['path'])\n    data = heap.read_text()\n    assert hashlib.sha256(heap.read_bytes()).hexdigest() == descriptor['sha256']\n    base = int(next(line.split('-')[0] for line in data.splitlines()\n                    if str(binary) in line and ' 00000000 ' in line), 16)\n    rows = {}\n    for line in data.splitlines():\n        match = re.match(r'\\s*(\\d+):\\s*(\\d+)\\s*\\[\\s*(\\d+):\\s*(\\d+)\\]\\s*@\\s*(.*)', line)\n        if match:\n            stack = tuple(int(address,16)-base-1 for address in match[5].split()\n                          if base <= int(address,16) < base+0x1000000)\n            addresses.update(stack)\n            counts = rows.setdefault(stack, [0]*4)\n            for i in range(4):\n                counts[i] += int(match[i+1])\n    gates.append(rows)\nordered = sorted(addresses)\nsymbolized = subprocess.run(['addr2line','-a','-f','-C','-i','-e',str(binary)],\n    input=''.join(hex(a)+'\\n' for a in ordered), capture_output=True, text=True, check=True)\nsymbols, current = {}, None\nfor line in symbolized.stdout.splitlines():\n    if re.fullmatch(r'0x[0-9a-fA-F]+',line):\n        current = int(line,16)\n        symbols[current] = []\n    elif current is not None:\n        symbols[current].append(line)\nstacks = []\nfor stack in gates[0].keys() | gates[1].keys():\n    delta = [b-a for a,b in zip(gates[0].get(stack,[0]*4), gates[1].get(stack,[0]*4))]\n    if delta[2] or delta[3]:\n        stacks.append({'live_objects_delta':delta[0], 'live_bytes_delta':delta[1],\n            'allocated_objects':delta[2], 'allocated_bytes':delta[3],\n            'symbols':[s for a in stack for s in symbols.get(a,[])],\n            'binary_return_offsets':[hex(a) for a in stack]})\nstacks.sort(key=lambda r:r['allocated_objects'], reverse=True)\nresult = {'scope':'Cumulative requested allocations across 20 paused-gate HTTP listings, server-only replacement allocator. Symbolized via recorded binary PIE base and GNU addr2line inline frames. Not RSS or ordinary timing.',\n    'binary':str(binary),'binary_sha256':hashlib.sha256(binary.read_bytes()).hexdigest(),\n    'input_sha256':hashlib.sha256(args.report.read_bytes()).hexdigest(),\n    'analyzer_source':Path(__file__).read_text(),'probe':report['allocation_probe'],\n    'totals':{k:sum(row[k] for row in stacks) for k in ['live_objects_delta','live_bytes_delta','allocated_objects','allocated_bytes']},\n    'stacks':stacks}\nargs.output.write_text(json.dumps(result,indent=2)+'\\n')\nprint(json.dumps({'totals':result['totals'],'top':stacks[:5]},indent=2))\n",
