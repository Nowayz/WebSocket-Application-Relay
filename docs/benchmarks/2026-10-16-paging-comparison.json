  "driver_source": "import hashlib\nimport json\nfrom pathlib import Path\nimport statistics\nimport subprocess\nimport sys\n\nroot = Path(__file__).resolve().parents[1]\nsha = lambda p: hashlib.sha256(Path(p).read_bytes()).hexdigest()\ncandidate = json.loads((root/'artifacts/paging-candidate.json').read_text())\nservers = {'before':root/'artifacts/baselines/response-buffer-candidate/war-relay',\n           'selected':root/candidate['directory']/'war-relay'}\nclient = root/candidate['directory']/'inspection'\noutput = root/'docs/benchmarks/2026-10-16-paging-comparison.json'\nrecord = {'scope':'Sequential fresh processes; three repetitions rotate workload order and alternate implementation order. Four server workers on CPUs0-3, one identical freshly frozen client on CPUs4-7. One private pair uses 1KiB values/window16 for 8 seconds. Private holds 8192 idle rooms without concurrent churn or inspection. Full/small compare old/new servers with the complete-array HTTP API, eight reconnect workers and 200 requested inspections/s; small holds64 idle rooms, all others8192. Page1/page100/page1000 run the selected server with the same client and request pacing, returning only the first bounded page during traffic. At quiescent gates these modes traverse every page and independently verify all stable rows, exact fields/order and cursor progress. Page/full responses contain different amounts of data; their rates are not equivalent-work speedups. Complete sender/value/FIFO, Close/EOF, exact counters and final resources checked for every case. No build, profiler or competing load test overlaps ordinary timing.',\n    'before_runtime_revision':'dced6e163b23d96abf37d630d614439dac5322d4',\n    'selected_source_hashes':candidate['sources'],\n    'variants':{k:{'path':str(p.relative_to(root)),'sha256':sha(p)} for k,p in servers.items()},\n    'client':{'path':str(client.relative_to(root)),'sha256':sha(client),'source_path':str((client.parent/'inspection.rs').relative_to(root)),'source_sha256':sha(client.parent/'inspection.rs')},\n    'helpers':{name:sha(root/'scripts'/name) for name in ['inspection.py','benchmark.py']},\n    'driver_source':Path(__file__).read_text(),'driver_sha256':sha(__file__),'cases':[],'passed':False}\nnames = ['full','page100','private','page1000','small','page1']\nfor repetition in range(1,4):\n    offset = (repetition-1)%len(names)\n    for workload in names[offset:]+names[:offset]:\n        roles = ['selected'] if workload.startswith('page') else (['before','selected'] if repetition%2 else ['selected','before'])\n        for role in roles:\n            trace = output.with_name(f'{output.stem}-{workload}-{role}-{repetition}.json')\n            command = [sys.executable,str(root/'scripts/inspection.py'),'--server',str(servers[role]),\n                '--client',str(client),'--pairs','1','--seconds','8','--rooms','64' if workload=='small' else '8192',\n                '--mode','none' if workload=='private' else 'http','--churn-workers','0' if workload=='private' else '8',\n                '--output',str(trace)]\n            if workload.startswith('page'):\n                command += ['--page-size',workload[4:]]\n            completed = subprocess.run(command,cwd=root,capture_output=True,text=True,timeout=160)\n            data = json.loads(trace.read_text())\n            assert completed.returncode == 0 and data['passed'], completed.stdout+completed.stderr\n            assert not data['profile_diagnostic'] and data['server_sha256'] == record['variants'][role]['sha256']\n            assert data['client_sha256'] == record['client']['sha256']\n            assert data['client_source_sha256'] == record['client']['source_sha256']\n            assert data['runner_sha256'] == record['helpers']['inspection.py']\n            mixed = data['mixed']\n            row = {'kind':role,'workload':workload,'repetition':repetition,'trace':str(trace.relative_to(root)),\n                'trace_sha256':sha(trace),'passed':True,'healthy':mixed['healthy']['per_second'],\n                'healthy_p99_ms':mixed['healthy']['p99_upper_ms'],'churn':mixed['churn']['per_second'],\n                'churn_p99_ms':mixed['churn']['p99_upper_ms'],'inspection':mixed['inspection']['per_second'],\n                'inspection_p99_ms':mixed['inspection']['p99_upper_ms'],\n                'inspection_max_ms':mixed['inspection']['max_ms'],\n                'cpu_wall':mixed['server_cpu_seconds_per_wall_second'],\n                'rss_mib':data['events'][1]['process']['VmRSS']/1024,\n                'ready_gate_seconds':data['events'][0]['seconds']}\n            record['cases'].append(row)\n            output.write_text(json.dumps(record,indent=2)+'\\n')\n            print(json.dumps(row),flush=True)\nrecord['medians'] = {}\nfor workload in names:\n    for role in servers:\n        rows = [r for r in record['cases'] if r['workload']==workload and r['kind']==role]\n        if not rows:\n            continue\n        keys = ['healthy','healthy_p99_ms','churn','churn_p99_ms','inspection','inspection_p99_ms','inspection_max_ms','cpu_wall','rss_mib','ready_gate_seconds']\n        result = {key:statistics.median(r[key] for r in rows) for key in keys}\n        result['ranges'] = {key:[min(r[key] for r in rows),max(r[key] for r in rows)] for key in ['healthy','churn','inspection_p99_ms']}\n        record['medians'][workload+'/'+role] = result\nrecord['passed'] = True\noutput.write_text(json.dumps(record,indent=2)+'\\n')\nprint(json.dumps(record['medians']),flush=True)\n",
