  "comparison_source": "import datetime, hashlib, json, statistics, subprocess\nfrom pathlib import Path\nroot=Path('/home/phil/dev/war_next')\nsha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()\nservers={'control':root/'artifacts/baselines/c2278cf/war-relay','selected':root/'artifacts/candidates/channel-trim/war-relay'}\nclient=root/'artifacts/clients/channel-peak/registry_peak'\noutput=root/'docs/benchmarks/2026-10-16-channel-comparison.json'\nrecord={'timestamp_utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),'base_revision':subprocess.check_output(['git','rev-parse','HEAD'],text=True,cwd=root).strip(),'server_sha256':{k:sha(p) for k,p in servers.items()},'client_sha256':sha(client),'client_source_sha256':sha(root/'examples/registry_peak.rs'),'runner_sha256':sha(root/'scripts/registry-peak.py'),'comparison_source':Path(__file__).read_text(),'scope':'Three fresh processes per build; reverse order on repetition two. Two retained global-room clients through two waves of 8192 temporary ordinary rooms. Authenticated CBOR queries in 16-message windows; every reply checked against independent literal bytes. Management snapshots verify every field/base64 ordering and exact peak membership at each gate, outside traffic CPU snapshots. Four seconds fresh and after each wave. All incoming/outgoing counts/bytes, zero routing reuse/copy counters, normal Close/EOF and final resource/error gauges checked. Four-worker server CPUs0-3, same frozen client CPUs4-7; sequential, plaintext loopback, rates/heartbeats disabled. Native CPU measured from /proc ticks, preparation CPU separate; preparation includes gated HTTP inspection. RSS is event-boundary, not continuous peak or live allocated bytes. Profiles and exploratory probes excluded. Per-process post-wave medians precede across-process medians.','cases':[],'passed':False}\nfor repetition in range(1,4):\n for label in (['control','selected'] if repetition!=2 else ['selected','control']):\n  trace=root/f'docs/benchmarks/2026-10-16-channel-{label}-{repetition}.json'\n  command=['python3','scripts/registry-peak.py','--server',str(servers[label]),'--client',str(client),'--scope','channels','--peak-clients','8192','--waves','2','--seconds','4','--output',str(trace)]\n  with open(root/f'artifacts/channel-{label}-{repetition}.log','w') as log:\n   process=subprocess.run(command,stdout=log,stderr=subprocess.STDOUT,cwd=root)\n  d=json.loads(trace.read_text());assert process.returncode==0 and d['passed'],d.get('error')\n  assert d['server_exit_code']==d['client_exit_code']==0\n  assert d['client_sha256']==record['client_sha256'] and d['server_sha256']==record['server_sha256'][label]\n  assert d['client_source_sha256']==record['client_source_sha256'] and d['runner_sha256']==record['runner_sha256']\n  assert all(e['management_inspection']['passed'] for e in d['events'])\n  assert d['events'][-1]['details']['joins']==d['events'][-1]['details']['normal_closes']==16386\n  values=d['traffic'];events=d['events'];find=lambda kind,w:next(e for e in events if e['event']==kind and e['wave']==w)\n  row={'label':label,'repetition':repetition,'trace':str(trace.relative_to(root)),'trace_sha256':sha(trace),'passed':True,'fresh':values[0],'after':values[1:], 'after_cpu_ns_per_query':statistics.median(t['server_ns_per_delivery'] for t in values[1:]),'after_queries_per_second':statistics.median(t['deliveries_per_second'] for t in values[1:]),'after_p99_upper_ms':statistics.median(t['p99_upper_ms'] for t in values[1:]),'fill_cpu_seconds':sum(find('population_ready',w)['process']['cpu_seconds']-find('traffic_done',w-1)['process']['cpu_seconds'] for w in [1,2]),'drain_cpu_seconds':sum(find('traffic_ready',w)['process']['cpu_seconds']-find('population_ready',w)['process']['cpu_seconds'] for w in [1,2]),'post_wave_rss_kib':[find('traffic_done',w)['process']['VmRSS'] for w in [1,2]],'verified_queries':sum(t['verified'] for t in values),'normal_closes':16386}\n  record['cases'].append(row);output.write_text(json.dumps(record,indent=2)+'\\n');print(json.dumps(row),flush=True)\nrecord['medians']={}\nfor label in servers:\n cases=[c for c in record['cases'] if c['label']==label]\n m={key:statistics.median(c[key] for c in cases) for key in ['after_cpu_ns_per_query','after_queries_per_second','after_p99_upper_ms','fill_cpu_seconds','drain_cpu_seconds']}\n for key in ['server_ns_per_delivery','deliveries_per_second','p99_upper_ms']:\n  m['fresh_'+key]=statistics.median(c['fresh'][key] for c in cases)\n m['after_cpu_range']=[min(c['after_cpu_ns_per_query'] for c in cases),max(c['after_cpu_ns_per_query'] for c in cases)]\n m['after_throughput_range']=[min(c['after_queries_per_second'] for c in cases),max(c['after_queries_per_second'] for c in cases)]\n record['medians'][label]=m\nrecord['verified_queries']=sum(c['verified_queries'] for c in record['cases']);record['normal_closes']=sum(c['normal_closes'] for c in record['cases']);record['passed']=True\noutput.write_text(json.dumps(record,indent=2)+'\\n');print(json.dumps({'passed':True,'medians':record['medians'],'verified_queries':record['verified_queries'],'normal_closes':record['normal_closes']}),flush=True)\n",
  "scope": "Three fresh processes per build; reverse order on repetition two. Two retained global-room clients through two waves of 8192 temporary ordinary rooms. Authenticated CBOR queries in 16-message windows; every reply checked against independent literal bytes. Management snapshots verify every field/base64 ordering and exact peak membership at each gate, outside traffic CPU snapshots. Four seconds fresh and after each wave. All incoming/outgoing counts/bytes, zero routing reuse/copy counters, normal Close/EOF and final resource/error gauges checked. Four-worker server CPUs0-3, same frozen client CPUs4-7; sequential, plaintext loopback, rates/heartbeats disabled. Native CPU measured from /proc ticks, preparation CPU separate; preparation includes gated HTTP inspection. RSS is event-boundary, not continuous peak or live allocated bytes. Profiles and exploratory probes excluded. Per-process post-wave medians precede across-process medians.",
