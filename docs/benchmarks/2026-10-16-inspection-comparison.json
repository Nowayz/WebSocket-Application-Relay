  "comparison_source": "import datetime,hashlib,json,statistics,subprocess\nfrom pathlib import Path\nroot=Path('/home/phil/dev/war_next');sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()\nservers={'control':root/'artifacts/baselines/a7f9866/war-relay','selected':root/'artifacts/candidates/inspection-snapshot/war-relay'}\nclient=root/'artifacts/clients/inspection/inspection';output=root/'docs/benchmarks/2026-10-16-inspection-comparison.json'\nrecord={'timestamp_utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),'base_revision':subprocess.check_output(['git','rev-parse','HEAD'],text=True,cwd=root).strip(),'server_sha256':{k:sha(p) for k,p in servers.items()},'client_sha256':sha(client),'client_source_sha256':sha(root/'examples/inspection.rs'),'runner_sha256':sha(root/'scripts/inspection.py'),'comparison_source':Path(__file__).read_text(),'scope':'Three fresh processes/build/mode, modes rotate each repetition and build order reverses on repetition two. Four-worker native server CPUs0-3; same frozen four-worker client CPUs4-7. 8192 stable single-member rooms, two private pairs, eight churn workers, eight measured seconds. None: no timed inspection. CBOR/HTTP: two inspectors at10ms per worker, missed ticks skipped; every full response, metadata/order, application frame, lifecycle, counts/bytes and Close/EOF checked. Stable clients held until all mixed work finishes. Coherent fixed metadata plus only known transient churn rooms (members1); exact quiescent snapshots before/after. Native CPU is for all concurrent work; no isolated per-operation CPU claim. Latencies include client validation and competing client tasks. Profiles/exploratory cases excluded from timing medians. Default queues, rates/heartbeat disabled; loopback, no TLS/capacity guarantee.','cases':[],'passed':False}\nmodes=['none','cbor','http']\nfor repetition in range(1,4):\n order=modes[repetition-1:]+modes[:repetition-1]\n for mode in order:\n  for label in (['control','selected'] if repetition!=2 else ['selected','control']):\n   path=root/f'docs/benchmarks/2026-10-16-inspection-{mode}-{label}-{repetition}.json'\n   command=['python3','scripts/inspection.py','--server',str(servers[label]),'--client',str(client),'--mode',mode,'--rooms','8192','--seconds','8','--output',str(path)]\n   with open(root/f'artifacts/inspection-{mode}-{label}-{repetition}.log','w') as log:p=subprocess.run(command,stdout=log,stderr=subprocess.STDOUT,cwd=root)\n   d=json.loads(path.read_text());assert p.returncode==0 and d['passed'],d.get('error');assert d['server_exit_code']==d['client_exit_code']==0 and not d['server_forced_kill'];assert d['server_sha256']==record['server_sha256'][label] and d['client_sha256']==record['client_sha256'] and d['client_source_sha256']==record['client_source_sha256'] and d['runner_sha256']==record['runner_sha256']\n   mixed=d['mixed'];row={'mode':mode,'label':label,'repetition':repetition,'trace':str(path.relative_to(root)),'trace_sha256':sha(path),'passed':True,'healthy':mixed['healthy'],'churn':mixed['churn'],'inspection':mixed['inspection'],'server_cpu_seconds':mixed['server_cpu_seconds'],'server_cpu_seconds_per_wall_second':mixed['server_cpu_seconds_per_wall_second'],'elapsed_seconds':mixed['elapsed_seconds'],'normal_closes':d['events'][-1]['details']['counts']['normal_closes'],'final_counts':d['events'][-1]['details']['counts'],'sampled_rss_kib':[e['process']['VmRSS'] for e in d['events']]}\n   record['cases'].append(row);output.write_text(json.dumps(record,indent=2)+'\\n');print(json.dumps(row),flush=True)\nrecord['medians']={}\nfor mode in modes:\n for label in servers:\n  rows=[c for c in record['cases'] if c['mode']==mode and c['label']==label];out={}\n  for activity in ['healthy','churn','inspection']:\n   out[activity]={k:statistics.median(r[activity][k] for r in rows) for k in ['per_second','p50_upper_ms','p99_upper_ms','max_ms']}\n   out[activity]['throughput_range']=[min(r[activity]['per_second'] for r in rows),max(r[activity]['per_second'] for r in rows)]\n  out['server_cpu_seconds']=statistics.median(r['server_cpu_seconds'] for r in rows);out['server_cpu_seconds_per_wall_second']=statistics.median(r['server_cpu_seconds_per_wall_second'] for r in rows)\n  record['medians'][f'{mode}/{label}']=out\nrecord['total_healthy_deliveries']=sum(r['healthy']['verified'] for r in record['cases']);record['total_churn_lifecycles']=sum(r['churn']['verified'] for r in record['cases']);record['total_timed_inspections']=sum(r['inspection']['verified'] for r in record['cases']);record['total_normal_closes']=sum(r['normal_closes'] for r in record['cases']);record['passed']=True\noutput.write_text(json.dumps(record,indent=2)+'\\n');print(json.dumps({'passed':True,'medians':record['medians'],'totals':{k:v for k,v in record.items() if k.startswith('total_')}}),flush=True)\n",
  "scope": "Three fresh processes/build/mode, modes rotate each repetition and build order reverses on repetition two. Four-worker native server CPUs0-3; same frozen four-worker client CPUs4-7. 8192 stable single-member rooms, two private pairs, eight churn workers, eight measured seconds. None: no timed inspection. CBOR/HTTP: two inspectors at10ms per worker, missed ticks skipped; every full response, metadata/order, application frame, lifecycle, counts/bytes and Close/EOF checked. Stable clients held until all mixed work finishes. Coherent fixed metadata plus only known transient churn rooms (members1); exact quiescent snapshots before/after. Native CPU is for all concurrent work; no isolated per-operation CPU claim. Latencies include client validation and competing client tasks. Profiles/exploratory cases excluded from timing medians. Default queues, rates/heartbeat disabled; loopback, no TLS/capacity guarantee.",
