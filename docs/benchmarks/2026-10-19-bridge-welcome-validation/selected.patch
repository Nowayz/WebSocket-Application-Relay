+        .into_iter()
+        .map(|id| (Message::Binary(protocol::uint(id)), Some(id)))
+        .collect();
+        cases.push((
+            Message::Binary(Bytes::from_static(&[0x1b, 0, 0, 0, 0, 0, 0, 0, 42])),
+            Some(42),
+        ));
+        welcome_validation_cases(cases).await;
+    }
