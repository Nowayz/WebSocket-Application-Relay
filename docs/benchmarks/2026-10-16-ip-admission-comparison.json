  "driver_source": "import hashlib\nimport json\nfrom pathlib import Path\nimport statistics\nimport subprocess\nimport sys\nfrom types import SimpleNamespace\n\nroot=Path(__file__).resolve().parents[1]\nsys.path.insert(0,str(root/'scripts'))\nimport inspection\n\nsha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()\ncandidate=json.loads((root/'artifacts/ip-admission-candidate.json').read_text())\nservers={'before':root/'artifacts/baselines/arena-selected/war-relay',\n    'disabled':root/candidate['directory']/'war-relay','enabled':root/candidate['directory']/'war-relay'}\nclient=root/'artifacts/baselines/paging-candidate/inspection'\noutput=root/'docs/benchmarks/2026-10-16-ip-admission-comparison.json'\nrecord={'scope':'18 sequential fresh-process cases: three repetitions rotate before/disabled/enabled order and alternate private/churn workload order. Four workers CPUs0-3, frozen client CPUs4-7.8192 idle rooms plus one private pair,1KiB cyclic values/window16,eight-second intervals. Churn adds eight reconnect workers. Enabled per-IP limit9000 admits the same complete workload; disabled0 retains prior policy. Every payload/sender/FIFO/Close/EOF/counter/resource check is unchanged. No builds/profilers/competing load tests overlap ordinary timings. Per-IP flags are appended to the actual native process command before spawn and retained in each trace.',\n    'before_runtime_revision':'58f22492f8ecf14b53662cef7b9ad765cfe62664',\n    'selected_source_hashes':candidate['sources'],\n    'variants':{k:{'path':str(p.relative_to(root)),'sha256':sha(p),'ip_limit':9000 if k=='enabled' else 0} for k,p in servers.items()},\n    'client':{'path':str(client.relative_to(root)),'sha256':sha(client),'source_path':str((client.parent/'inspection.rs').relative_to(root)),'source_sha256':sha(client.parent/'inspection.rs')},\n    'helpers':{str(p.relative_to(root)):sha(p) for p in [root/'scripts/inspection.py',root/'scripts/benchmark.py']},\n    'driver_source':Path(__file__).read_text(),'driver_sha256':sha(__file__),'cases':[],'passed':False}\noriginal_popen=subprocess.Popen\nfor repetition in range(1,4):\n    for workload in (['private','churn'] if repetition%2 else ['churn','private']):\n        roles=['before','disabled','enabled'];offset=(repetition-1)%3;roles=roles[offset:]+roles[:offset]\n        for role in roles:\n            trace=output.with_name(f'{output.stem}-{workload}-{role}-{repetition}.json')\n            args=SimpleNamespace(server=servers[role],client=client,mode='none',page_size=None,\n                rooms=8192,seconds=8,inspectors=2,inspection_interval_ms=10,pairs=1,\n                churn_workers=8 if workload=='churn' else 0,read_storage='worker',server_cpus='0-3',client_cpus='4-7',\n                profile=False,heap_profile=None,heap_library=Path('/usr/lib/libtcmalloc.so'),output=trace)\n            def launch(command,*positional,**kwargs):\n                if str(args.server.resolve()) in command and role!='before':\n                    command += ['--max-connections-per-ip',str(record['variants'][role]['ip_limit'])]\n                return original_popen(command,*positional,**kwargs)\n            try:\n                subprocess.Popen=launch\n                data=inspection.run(args)\n            finally:subprocess.Popen=original_popen\n            assert data['passed'] and data['client_exit_code']==data['server_exit_code']==0,data.get('error')\n            assert data['server_sha256']==record['variants'][role]['sha256'] and data['client_sha256']==record['client']['sha256']\n            assert not data['profile_diagnostic']\n            if role!='before':assert data['server_command'][-2:]==['--max-connections-per-ip',str(record['variants'][role]['ip_limit'])]\n            assert data['events'][-1]['metrics'].get('war_ip_rejected_total',0)==0\n            mixed=data['mixed']\n            row={'kind':role,'workload':workload,'repetition':repetition,'trace':str(trace.relative_to(root)),\n                'trace_sha256':sha(trace),'passed':True,'healthy':mixed['healthy']['per_second'],\n                'healthy_p99_ms':mixed['healthy']['p99_upper_ms'],'churn':mixed['churn']['per_second'],\n                'churn_p99_ms':mixed['churn']['p99_upper_ms'],'cpu_wall':mixed['server_cpu_seconds_per_wall_second'],\n                'ready_rss_mib':data['events'][1]['process']['VmRSS']/1024}\n            record['cases'].append(row);output.write_text(json.dumps(record,indent=2)+'\\n');print(json.dumps(row),flush=True)\nrecord['medians']={}\nfor workload in ['private','churn']:\n    for role in servers:\n        rows=[r for r in record['cases'] if r['kind']==role and r['workload']==workload]\n        keys=['healthy','healthy_p99_ms','churn','churn_p99_ms','cpu_wall','ready_rss_mib']\n        summary={k:statistics.median(r[k] for r in rows) for k in keys}\n        summary['ranges']={k:[min(r[k] for r in rows),max(r[k] for r in rows)] for k in keys}\n        record['medians'][workload+'/'+role]=summary\nrecord['passed']=True;output.write_text(json.dumps(record,indent=2)+'\\n');print(json.dumps(record['medians']),flush=True)\n",
