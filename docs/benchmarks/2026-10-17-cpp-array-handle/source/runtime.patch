+// One immutable retained body is shared by all queued recipients. Keep the
+// transient handle the same size as shared_ptr<string>; only deliveries need
+// a stored length. Every submit sharing this handle uses the same envelope.
+using RetainedBody = std::shared_ptr<const char[]>;
+static RetainedBody retain_body(View value) {
+  auto bytes = std::make_shared_for_overwrite<char[]>(value.size());
+  if (!value.empty())
+    std::memcpy(bytes.get(), value.data(), value.size());
+  return bytes;
+}
