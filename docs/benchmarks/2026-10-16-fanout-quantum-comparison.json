  "driver_source": "import hashlib,json,statistics,subprocess,sys\nfrom pathlib import Path\nroot=Path(__file__).resolve().parents[1];sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()\nmeta=json.loads((root/'artifacts/fanout-probe-candidate.json').read_text());client=root/meta['directory']/'inspection';server=root/'artifacts/baselines/fd-pressure/war-relay'\ncandidate=json.loads((root/'artifacts/fanout-quantum-candidate.json').read_text());servers={'before':server,'selected':root/candidate['directory']/'war-relay'}\noutput=root/'docs/benchmarks/2026-10-16-fanout-quantum-comparison.json'\nrecord={'scope':'24 sequential fresh processes; three repetitions rotate worker/population combinations and alternate before/selected order. Four client threads on CPUs4-7; one or four native workers on CPUs0-3. Six seconds, one private pair, eight exact Close/EOF reconnect workers;0/64/512 stable broadcast readers as recorded. Every fanout reader checks full sender/body/FIFO and the complete matrix, all controlled departures and normal closes checked, exact independent counter/byte/resource checks at gates. Client/server CPU separate. No build/profiler/other load overlaps timings. Each message retains its coherent membership view and shared body.',\n 'before_runtime_revision':'a0191a1dc54ad8eb7dc17ada1df4aa39b40227ca','selected_source_hashes':candidate['sources'],'variants':{k:{'path':str(v.relative_to(root)),'sha256':sha(v)} for k,v in servers.items()},'client':{'path':str(client.relative_to(root)),'sha256':sha(client)},'sources':meta['sources'],'driver_source':Path(__file__).read_text(),'cases':[],'passed':False}\nvariants=[(1,512),(4,512),(4,0),(4,64)]\nfor rep in range(1,4):\n offset=(rep-1)%len(variants)\n for workers,readers in variants[offset:]+variants[:offset]:\n  for role in (['before','selected'] if rep%2 else ['selected','before']):\n   trace=output.with_name(f'{output.stem}-{workers}w-{readers}r-{role}-{rep}.json')\n   cmd=[sys.executable,'scripts/inspection.py','--server',str(servers[role]),'--client',str(client),'--workers',str(workers),'--rooms','0','--pairs','1','--seconds','6','--mode','none','--churn-workers','8','--fanout-readers',str(readers),'--output',str(trace)]\n   done=subprocess.run(cmd,cwd=root,capture_output=True,text=True,timeout=100)\n   data=json.loads(trace.read_text());assert done.returncode==0 and data['passed'],done.stdout+done.stderr\n   assert data['server_sha256']==record['variants'][role]['sha256'] and data['client_sha256']==meta['client_sha256']\n   for p,d in data['client_sources_sha256'].items():assert meta['sources'][p]==d\n   m=data['mixed'];row={'kind':role,'workers':workers,'readers':readers,'repetition':rep,'trace':str(trace.relative_to(root)),'trace_sha256':sha(trace),'passed':True,\n     'healthy':m['healthy']['per_second'],'healthy_p99_ms':m['healthy']['p99_upper_ms'],'churn':m['churn']['per_second'],'churn_p99_ms':m['churn']['p99_upper_ms'],'fanout':m['fanout']['per_second'],'fanout_p99_ms':m['fanout']['p99_upper_ms'],\n     'server_cpu_wall':m['server_cpu_seconds_per_wall_second'],'client_cpu_wall':m['client_cpu_seconds_per_wall_second'],'rss_mib':data['events'][1]['process']['VmRSS']/1024}\n   record['cases'].append(row);output.write_text(json.dumps(record,indent=2)+'\\n');print(json.dumps(row),flush=True)\nrecord['medians']={}\nfor workers,readers in variants:\n for role in servers:\n  rows=[r for r in record['cases'] if r['kind']==role and (r['workers'],r['readers'])==(workers,readers)]\n  fields=['healthy','healthy_p99_ms','churn','churn_p99_ms','fanout','fanout_p99_ms','server_cpu_wall','client_cpu_wall','rss_mib']\n  summary={k:statistics.median(r[k] for r in rows) for k in fields};summary['ranges']={k:[min(r[k] for r in rows),max(r[k] for r in rows)] for k in fields}\n  record['medians'][f'{workers}w/{readers}r/{role}']=summary\nrecord['passed']=True;output.write_text(json.dumps(record,indent=2)+'\\n');print(json.dumps(record['medians']),flush=True)\n",
