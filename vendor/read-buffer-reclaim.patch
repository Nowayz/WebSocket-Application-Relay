+    /// Release decoder ownership between frames without touching published data.
+    /// An incomplete next header is copied; a partially received frame is busy.
+    pub(super) fn reclaim_read_buffer(&mut self) -> Option<usize> {
+        if self.header.is_some() {
+            return None;
+        }
+        // Header parsing returns None only while at most 13 bytes are buffered.
+        if self.in_buffer.len() >= FrameHeader::MAX_SIZE {
+            return None;
+        }
+        // A short buffer can also hold a complete small frame. Reclaim only
+        // when the ordinary parser proves these are incomplete header bytes.
+        if !matches!(FrameHeader::parse(&mut Cursor::new(self.in_buffer.as_ref())), Ok(None)) {
+            return None;
+        }
+        let copied = self.in_buffer.len();
