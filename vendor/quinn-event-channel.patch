+            let _state = send.0.lock().unwrap();
+            panic!("simulate a driver unwinding while the queue is locked");
+        });
+        assert!(result.is_err());
+        drop(receive);
+        drop(send);
+        assert_eq!(Arc::strong_count(&value), 1);
