+        drop(send);
+        let count = Cell::new(0);
+        tokio::join!(biased;
+            async { while poll_fn(|cx| receive.poll_recv(cx)).await.is_some() { count.set(count.get() + 1); } },
+            async { assert!(count.get() < 1000, "ready input starved another future"); }
+        );
+        assert_eq!(count.get(), 1000);
+    }
