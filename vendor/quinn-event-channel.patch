+//! One endpoint-owned sender and one connection-owned receiver. Keep an idle
+//! event slot inline instead of allocating a 32-event block per connection.
+//! The endpoint serializes producers; this channel also permits concurrent
+//! send/receive. FIFO, receiver retirement and scheduler cooperation are explicit.
+use std::{
+    collections::VecDeque,
+    mem,
+    sync::{Arc, Mutex},
+    task::{ready, Context, Poll, Waker},
+};
+
+use tokio::sync::mpsc::error::SendError;
+
+// Match the original mpsc block retention for small bursts. This is a storage
+// reuse threshold, never a limit on queued or delivered events.
+const RETAIN_SLOTS: usize = if cfg!(target_pointer_width = "64") {
+    32
+} else {
+    16
+};
+
+/// Empty overflow storage shared by an endpoint and its connection drivers.
+/// The endpoint sizes the cache to its receive batch, allowing drained queues
+/// to return scratch for the next burst. Event queues still grow freely.
+#[derive(Debug)]
+pub(crate) struct BufferPool<T> {
+    spare: Mutex<Vec<VecDeque<T>>>,
+    slots: usize,
+}
+
+impl<T> BufferPool<T> {
+    pub(crate) fn new(slots: usize) -> Self {
+        debug_assert!(slots > 0);
+        Self {
+            spare: Mutex::new(Vec::with_capacity(slots)),
+            slots,
+        }
+    }
+
+    fn take(&self) -> VecDeque<T> {
+        self.spare
+            .lock()
+            .unwrap_or_else(|e| e.into_inner())
+            .pop()
+            .unwrap_or_default()
+    }
+
+    fn recycle(&self, buffer: VecDeque<T>) {
+        debug_assert!(buffer.is_empty());
+        if buffer.capacity() == 0 || buffer.capacity() > RETAIN_SLOTS {
+            return;
+        }
+        let mut spare = self.spare.lock().unwrap_or_else(|e| e.into_inner());
+        if spare.len() < self.slots {
+            spare.push(buffer);
+        }
+    }
+}
+
+#[derive(Debug)]
+struct State<T> {
+    first: Option<T>,
+    pool: Arc<BufferPool<T>>,
+    rest: VecDeque<T>,
+    sender_alive: bool,
+    receiver_alive: bool,
+    reader: Option<Waker>,
+}
+
+#[derive(Debug)]
+pub(crate) struct Sender<T>(Arc<Mutex<State<T>>>);
+
+#[derive(Debug)]
+pub(crate) struct Receiver<T>(Arc<Mutex<State<T>>>);
+
+#[cfg(test)]
+fn channel<T>() -> (Sender<T>, Receiver<T>) {
+    channel_with_pool(Arc::new(BufferPool::new(4)))
+}
+
+pub(crate) fn channel_with_pool<T>(pool: Arc<BufferPool<T>>) -> (Sender<T>, Receiver<T>) {
+    let state = Arc::new(Mutex::new(State {
+        first: None,
+        pool,
+        rest: VecDeque::new(),
+        sender_alive: true,
+        receiver_alive: true,
+        reader: None,
+    }));
+    (Sender(state.clone()), Receiver(state))
+}
+
+impl<T> Sender<T> {
+    pub(crate) fn send(&self, value: T) -> Result<(), SendError<T>> {
+        let wake = {
+            let mut state = self.0.lock().unwrap();
+            if !state.receiver_alive {
+                return Err(SendError(value));
+            }
+            if state.first.is_none() && state.rest.is_empty() {
+                state.first = Some(value);
+            } else {
+                if state.rest.capacity() == 0 {
+                    state.rest = state.pool.take();
+                }
+                state.rest.push_back(value);
+            }
+            state.reader.take()
+        };
+        if let Some(waker) = wake {
+            waker.wake();
+        }
+        Ok(())
+    }
+}
+
+impl<T> Drop for Sender<T> {
+    fn drop(&mut self) {
+        let wake = {
+            let mut state = self
+                .0
+                .lock()
+                .unwrap_or_else(|poisoned| poisoned.into_inner());
+            state.sender_alive = false;
+            state.reader.take()
+        };
+        if let Some(waker) = wake {
+            waker.wake();
+        }
+    }
+}
+
+impl<T> Receiver<T> {
+    pub(crate) fn poll_recv(&mut self, cx: &mut Context<'_>) -> Poll<Option<T>> {
+        // Match Tokio mpsc's budget consumption. A permanently ready packet
+        // source must still let connection writes and other tasks run.
+        let coop = ready!(tokio::task::coop::poll_proceed(cx));
+        let mut state = self.0.lock().unwrap();
+        let value = state.first.take().or_else(|| state.rest.pop_front());
+        if state.rest.is_empty() && state.rest.capacity() != 0 {
+            let buffer = mem::take(&mut state.rest);
+            state.pool.recycle(buffer);
+        }
+        if value.is_some() || !state.sender_alive {
+            coop.made_progress();
+            return Poll::Ready(value);
+        }
+        if let Some(reader) = &mut state.reader {
+            reader.clone_from(cx.waker());
+        } else {
+            state.reader = Some(cx.waker().clone());
+        }
+        Poll::Pending
+    }
+}
+
+impl<T> Drop for Receiver<T> {
+    fn drop(&mut self) {
+        let retired = {
+            let mut state = self
+                .0
+                .lock()
+                .unwrap_or_else(|poisoned| poisoned.into_inner());
+            state.receiver_alive = false;
+            (
+                state.first.take(),
+                std::mem::take(&mut state.rest),
+                state.reader.take(),
+            )
+        };
+        // Releasing events or a retired task's waker can run destructors.
+        drop(retired);
+    }
+}
+
